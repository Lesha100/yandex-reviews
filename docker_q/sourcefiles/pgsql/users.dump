\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438, \\u043d\\u043e \\u044d\\u0442\\u043e \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0443\\u0441\\u0438\\u043b\\u0438\\u0439. \\u0422\\u044b \\u0441\\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u044c \\u043e\\u0442 \\u043d\\u0430\\u0441 \\u0441\\u043e\\u0432\\u0435\\u0442\\u044b \\u0438 \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0430\\u0446\\u0438\\u0438, \\u043a\\u0430\\u043a \\u044d\\u0442\\u043e \\u043b\\u0443\\u0447\\u0448\\u0435 \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u0438 \\u043d\\u0430 \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0436\\u0435\\u043b\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u043e\\u0431\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435.\\u200b<br \\/><br \\/>3. \\u0412\\u044b\\u0431\\u043e\\u0440, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u0442\\u044b \\u0434\\u0435\\u043b\\u0430\\u0435\\u0448\\u044c \\u0441\\u0435\\u0439\\u0447\\u0430\\u0441 \\u043d\\u0435 \\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0435\\u0448\\u044c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e \\u0440\\u0430\\u0437 \\u0438 \\u043d\\u0430\\u0432\\u0441\\u0435\\u0433\\u0434\\u0430! \\u041c\\u044b \\u0436\\u0438\\u0432\\u0435\\u043c \\u0432 \\u044d\\u043f\\u043e\\u0445\\u0443 \\u0431\\u044b\\u0441\\u0442\\u0440\\u044b\\u0445 \\u0438 \\u0441\\u0442\\u0440\\u0435\\u043c\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0439 \\u0432 \\u043c\\u0438\\u0440\\u0435 \\u0438 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u0443\\u0440\\u043e\\u0432\\u043d\\u044f\\u0445 \\u0435\\u0433\\u043e \\u0444\\u0443\\u043d\\u043a\\u0446\\u0438\\u043e\\u043d\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u041f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u0441\\u0435\\u0439\\u0447\\u0430\\u0441 \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0432\\u044b\\u0431\\u0440\\u0430\\u0442\\u044c \\u043e\\u0431\\u0449\\u0435\\u0435 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u044f, \\u043d\\u043e \\u043d\\u0435 \\u0431\\u043e\\u0439\\u0441\\u044f \\u0447\\u0442\\u043e-\\u0442\\u043e \\u043c\\u0435\\u043d\\u044f\\u0442\\u044c! \\u0415\\u0441\\u043b\\u0438 \\u0432\\u0434\\u0440\\u0443\\u0433 \\u0442\\u044b \\u043f\\u043e\\u0439\\u043c\\u0435\\u0448\\u044c, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u044f \\u0437\\u0430\\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043e\\u0432\\u0430\\u043b\\u043e \\u0447\\u0442\\u043e-\\u0442\\u043e \\u043d\\u043e\\u0432\\u043e\\u0435 \\u0438\\u043b\\u0438 \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f \\u0432\\u044b\\u0431\\u0440\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a\\u043e\\u0435-\\u0442\\u043e \\u0441\\u043c\\u0435\\u0436\\u043d\\u043e\\u0435 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435, \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u044d\\u0442\\u043e \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c. \\u041d\\u0438\\u043a\\u043e\\u0433\\u0434\\u0430 \\u043d\\u0435 \\u043f\\u043e\\u0437\\u0434\\u043d\\u043e \\u0447\\u0442\\u043e-\\u0442\\u043e \\u0438\\u0437\\u043c\\u0435\\u043d\\u0438\\u0442\\u044c, \\u0442\\u0435\\u043c \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0447\\u0442\\u043e \\u0441\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u044b\\u0439 \\u043c\\u0438\\u0440 \\u043f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 \\u0434\\u043b\\u044f \\u044d\\u0442\\u043e\\u0433\\u043e \\u0448\\u0438\\u0440\\u043e\\u043a\\u0438\\u0439 \\u0441\\u043f\\u0435\\u043a\\u0442\\u0440 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439.<br \\/><br \\/>4. \\u0420\\u044b\\u043d\\u043e\\u043a \\u0442\\u0440\\u0443\\u0434\\u0430 \\u043d\\u0435\\u043f\\u0440\\u0435\\u0440\\u044b\\u0432\\u043d\\u043e \\u043c\\u0435\\u043d\\u044f\\u0435\\u0442\\u0441\\u044f, \\u0438 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0431\\u044b\\u043b\\u0438 \\u0432\\u043e\\u0441\\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u044b 5 \\u043b\\u0435\\u0442 \\u043d\\u0430\\u0437\\u0430\\u0434, \\u0441\\u0435\\u0433\\u043e\\u0434\\u043d\\u044f \\u043c\\u043e\\u0433\\u0443\\u0442 \\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u044c\\u0441\\u044f \\u043d\\u0435\\u043d\\u0443\\u0436\\u043d\\u044b\\u043c\\u0438 \\u0438 \\u043c\\u0430\\u043b\\u043e\\u043e\\u043f\\u043b\\u0430\\u0447\\u0438\\u0432\\u0430\\u0435\\u043c\\u044b\\u043c\\u0438. \\u041f\\u0440\\u0435\\u0434\\u0443\\u0433\\u0430\\u0434\\u0430\\u0442\\u044c \\u0442\\u0430\\u043a\\u0438\\u0435 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f \\u043d\\u0435\\u043b\\u0435\\u0433\\u043a\\u043e. \\u0421\\u043e\\u0432\\u0441\\u0435\\u043c \\u043d\\u0435\\u0434\\u0430\\u0432\\u043d\\u043e \\u0432\\u044b\\u0448\\u0435\\u043b \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0430\\u0442\\u043b\\u0430\\u0441 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u0433\\u043e, \\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043d\\u043d\\u044b\\u0439 \\"\\u0410\\u0433\\u0435\\u043d\\u0442\\u0441\\u0442\\u0432\\u043e\\u043c \\u0441\\u0442\\u0440\\u0430\\u0442\\u0435\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0445 \\u0438\\u043d\\u0438\\u0446\\u0438\\u0430\\u0442\\u0438\\u0432\\".&nbsp;<a href=\\"https:\\/\\/atlas100.ru\\/upload\\/pdf_files\\/atlas.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">https:\\/\\/atlas100.ru\\/upload\\/pdf_files\\/atlas.pdf<\\/a>\\u200b \\u200b \\u042d\\u0442\\u043e \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u0439, \\u0431\\u0435\\u0441\\u043f\\u043b\\u0430\\u0442\\u043d\\u044b\\u0439 \\u0440\\u0435\\u0441\\u0443\\u0440\\u0441. \\u0422\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043e\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u0438\\u0442\\u044c\\u0441\\u044f \\u0441 \\u0446\\u0438\\u0444\\u0440\\u043e\\u0432\\u043e\\u0439 \\u0432\\u0435\\u0440\\u0441\\u0438\\u0435\\u0439 \\u0430\\u0442\\u043b\\u0430\\u0441\\u0430 2020 \\u0433\\u043e\\u0434\\u0430 \\u0438 \\u043f\\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u0442\\u044c, \\u043a\\u0430\\u043a\\u0438\\u0435 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u0438\\u0437\\u043e\\u0439\\u0434\\u0443\\u0442 \\u0441 \\u043c\\u0438\\u0440\\u043e\\u043c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u0432 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u043c (\\u0438 \\u043d\\u0435 \\u0441\\u043e\\u0432\\u0441\\u0435\\u043c) \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u043c.<br \\/><br \\/>5. \\u0423\\u0447\\u0438\\u0441\\u044c, \\u0443\\u0447\\u0438\\u0441\\u044c \\u0438 \\u0435\\u0449\\u0435 \\u0440\\u0430\\u0437 \\u0443\\u0447\\u0438\\u0441\\u044c. \\u0423\\u0447\\u0435\\u0431\\u0430 &ndash; \\u044d\\u0442\\u043e \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0442\\u043e, \\u0447\\u0442\\u043e \\u043c\\u044b \\u0432\\u0438\\u0434\\u0438\\u043c \\u0432 \\u0448\\u043a\\u043e\\u043b\\u0435. \\u0421\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0442 \\u0441\\u043e\\u0442\\u043d\\u0438 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u0445 \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442\\u043e\\u0432, \\u043c\\u044b \\u043c\\u043e\\u0436\\u0435\\u043c \\u0443\\u0447\\u0438\\u0442\\u044c\\u0441\\u044f \\u0432 \\u043b\\u044e\\u0431\\u043e\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u0438 \\u0432 \\u043b\\u044e\\u0431\\u043e\\u043c \\u0443\\u0434\\u043e\\u0431\\u043d\\u043e\\u043c \\u0440\\u0435\\u0436\\u0438\\u043c\\u0435. \\u041f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0447\\u0442\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u0435 - \\u043d\\u0435\\u043f\\u0440\\u0435\\u0440\\u044b\\u0432\\u043d\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441 \\u0441\\u0430\\u043c\\u043e\\u0441\\u043e\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f.<\\/p>"}	2021-03-11 17:31:16	2021-03-11 17:31:16
