29482	1	admin/users/report/edit/291/resume	POST	77.238.236.109	{"resume":"<h3><span style=\\"color: #f3705c;\\"><strong>\\u0421\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e-\\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u0443\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043a\\u0438<\\/strong><\\/span><\\/h3>\\n<p><span style=\\"color: #000000;\\">\\u042f \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0443, \\u0447\\u0442\\u043e \\u043f\\u0440\\u0438 \\u043e\\u0442\\u0432\\u0435\\u0442\\u0430\\u0445 \\u043d\\u0430 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u0442\\u0435\\u0441\\u0442\\u043e\\u0432 \\"\\u0421\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e-\\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0445 \\u0443\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043e\\u043a\\" \\u0431\\u044b\\u043b\\u0438 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u044b \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b&nbsp; \\"\\u0414\\u0430\\". \\u041f\\u043e \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0430\\u043c \\u043c\\u043e\\u0436\\u043d\\u043e \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u0442\\u0440\\u0438 \\u0433\\u0438\\u043f\\u043e\\u0442\\u0435\\u0437\\u044b:<\\/span><\\/p>\\n<p><span style=\\"color: #000000;\\">1. \\u0414\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0442\\u0435\\u0441\\u0442\\u044b \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u0438\\u043b\\u0438\\u0441\\u044c \\u0438\\u0433\\u0440\\u043e\\u0432\\u044b\\u043c \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043e\\u043c \\u0431\\u0435\\u0437 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u044c \\u0440\\u0435\\u043b\\u0435\\u0432\\u0430\\u043d\\u0442\\u043d\\u044b\\u0439 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442.&nbsp;<\\/span><\\/p>\\n<p><span style=\\"color: #000000;\\">2. \\u041e\\u0442\\u0432\\u0435\\u0442\\u044b \\u043f\\u043e\\u043b\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0447\\u0435\\u0441\\u0442\\u043d\\u044b\\u0435. \\u0421\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0435\\u0441\\u0442\\u044c \\u0446\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u043d\\u043e\\u0435 \\u0440\\u0430\\u0441\\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435. \\u0415\\u0441\\u043b\\u0438 \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c \\u0446\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439 \\u043f\\u043e \\u0432\\u0441\\u0435\\u043c \\u0448\\u043a\\u0430\\u043b\\u0430\\u043c \\u043c\\u0430\\u043a\\u0441\\u0438\\u043c\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 - \\u044d\\u0442\\u043e \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442, \\u0447\\u0442\\u043e \\u043d\\u0435\\u0442 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0438\\u043b\\u0438 \\u043c\\u0435\\u043d\\u0435\\u0435 \\u0446\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e \\u0438 \\"\\u0432\\u0441\\u0435 \\u0446\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 \\u043e\\u0434\\u0438\\u043d\\u0430\\u043a\\u043e\\u0432\\u043e \\u0446\\u0435\\u043d\\u043d\\u044b\\". \\u042d\\u0442\\u043e \\u0445\\u043e\\u0440\\u043e\\u0448\\u0438\\u0439 \\u043f\\u043e\\u0432\\u043e\\u0434 \\u043e\\u0431\\u0441\\u0443\\u0434\\u0438\\u0442\\u044c \\u0447\\u0442\\u043e \\u0434\\u043b\\u044f \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430 \\u0432\\u0430\\u0436\\u043d\\u043e \\u0432 \\u043d\\u0430\\u0438\\u0431\\u043e\\u043b\\u044c\\u0448\\u0435\\u0439 \\u0441\\u0442\\u0435\\u043f\\u0435\\u043d\\u0438. \\u0421\\u0430\\u043c\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e\\u0439 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431 - \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0438\\u0442\\u0435 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0443 \\u0437\\