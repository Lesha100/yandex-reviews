33150	8	admin/users/report/edit/300/resume	POST	217.21.222.36	{"resume":"<p>\\u041f\\u0440\\u0438 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0438 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0442\\u0438\\u043f\\u0430 \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0432\\u044b\\u044f\\u0432\\u043b\\u0435\\u043d\\u043e \\u043d\\u0435\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u043e \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0439 \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u0438 \\u0442\\u0432\\u043e\\u0438\\u0445 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043e\\u0432. \\u041d\\u0430 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c \\u043f\\u043e \\u043a\\u0430\\u0436\\u0434\\u043e\\u043c\\u0443 \\u0438\\u0437 \\u043d\\u0438\\u0445 \\u043d\\u0430 \\u0441\\u0440\\u0435\\u0434\\u043d\\u0435\\u043c \\u0443\\u0440\\u043e\\u0432\\u043d\\u0435. \\u041e\\u0434\\u043d\\u0430\\u043a\\u043e \\u043d\\u0435 \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0440\\u0430\\u0437\\u043e\\u0447\\u0430\\u0440\\u043e\\u0432\\u044b\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f, \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0432\\u043f\\u0435\\u0440\\u0435\\u0434\\u0438 \\u043c\\u043d\\u043e\\u0433\\u043e \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b\\u0445 \\u0432\\u0441\\u0442\\u0440\\u0435\\u0447 \\u0438 \\u0441\\u043e\\u0431\\u044b\\u0442\\u0438\\u0439, \\u0433\\u0434\\u0435 \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043f\\u0440\\u043e\\u0431\\u043e\\u0432\\u0430\\u0442\\u044c \\u0440\\u0430\\u0437\\u043d\\u044b\\u0435 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0434\\u0430\\u0434\\u0443\\u0442 \\u0442\\u0435\\u0431\\u0435 \\u043d\\u043e\\u0432\\u044b\\u0435 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0434\\u043b\\u044f \\u0441\\u0430\\u043c\\u043e\\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u044f.<br \\/><br \\/>\\u0422\\u0435\\u0431\\u044f \\u043f\\u0440\\u0438\\u0432\\u043b\\u0435\\u043a\\u0430\\u0435\\u0442 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430, \\u0433\\u0434\\u0435 \\u043d\\u0435\\u0442 \\u0436\\u0435\\u0441\\u0442\\u043a\\u043e\\u0433\\u043e \\u0440\\u0435\\u0436\\u0438\\u043c\\u0430, \\u0444\\u043e\\u0440\\u043c\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439, \\u0436\\u0435\\u0441\\u0442\\u043a\\u0438\\u0445 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0439 \\u0438 \\u0433\\u0434\\u0435 \\u0432\\u0430\\u0436\\u043d\\u043e \\u0438\\u043c\\u0435\\u0442\\u044c \\u0432\\u043a\\u0443\\u0441 \\u0438 \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438: \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0435, \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043d\\u044b\\u0435, \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435, \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0442\\u043e\\u0440\\u0441\\u043a\\u0438\\u0435. \\u0422\\u044b \\u0446\\u0435\\u043d\\u0438\\u0448\\u044c \\u043e\\u0440\\u0438\\u0433\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u044c, \\u0433\\u0438\\u0431\\u043a\\u043e\\u0441\\u0442\\u044c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f.<br \\/><br \\/>\\u0412\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u0442\\u044b \\u0435\\u0449\\u0435 \\u043d\\u0435 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0438\\u043b\\u0441\\u044f, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0431\\u043b\\u0438\\u0436\\u0435: \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u0430 \\u0438\\u043b\\u0438 \\u0440\\u0435\\u0433\\u043b\\u0430\\u043c\\u0435\\u043d\\u0442\\u0430\\u0446\\u0438\\u044f \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438.<br \\/>\\u041c\\u043e\\u0436\\u043d\\u043e \\u0440\\u0430\\u0441\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u0442\\u044c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0441\\u0432\\u044f\\u0437\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0441 \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043e\\u0439, \\u0442\\u0435\\u0430\\u0442\\u0440\\u043e\\u043c, \\u043a\\u0438\\u043d\\u043e, \\u043c\\u0443\\u0437\\u044b\\u043a\\u043e\\u0439, \\u0438\\u0437\\u043e\\u0431\\u0440\\u0430\\u0437\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u043c \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e\\u043c: \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043d\\u0442\\u044b, \\u0445\\u0443\\u0434\\u043e\\u0436\\u043d\\u0438\\u043a\\u0438, \\u0432\\u0438\\u0437\\u0430\\u0436\\u0438\\u0441\\u0442\\u044b, \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\\u044b, \\u0430\\u043a\\u0442\\u0435\\u0440\\u044b, \\u0440\\u0435\\u0436\\u0438\\u0441\\u0441\\u0435\\u0440\\u044b, \\u0434\\u0438\\u0437\\u0430\\u0439\\u043d\\u0435\\u0440\\u044b.<br \\/><br \\/>\\u041f\\u043e\\u043c\\u043d\\u0438, \\u0447\\u0442\\u043e \\u043a\\u0430\\u0436\\u0434\\u0430\\u044f \\u0441\\u0444\\u0435\\u0440\\u0430 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0431\\u044b\\u0442\\u044c \\u043f\\u0435\\u0440\\u0435\\u0444\\u043e\\u0440\\u043c\\u0430\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0430 \\u0432 \\u0431\\u0438\\u0437\\u043d\\u0435\\u0441 &ndash; &laquo;\\u0414\\u0435\\u043b\\u043e \\u0436\\u0438\\u0437\\u043d\\u0438&raquo;. \\u041a\\u0430\\u043a \\u0441\\u043a\\u0430\\u0437\\u0430\\u043b \\u041a\\u043e\\u043d\\u0444\\u0443\\u0446\\u0438\\u0439 - &laquo;\\u0412\\u044b\\u0431\\u0435\\u0440\\u0438 \\u0441\\u0435\\u0431\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443 \\u043f\\u043e \\u0434\\u0443\\u0448\\u0435, \\u0438 \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0435 \\u043f\\u0440\\u0438\\u0434\\u0435\\u0442\\u0441\\u044f \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c \\u043d\\u0438 \\u043e\\u0434\\u043d\\u043e\\u0433\\u043e \\u0434\\u043d\\u044f \\u0432 \\u0441\\u0432\\u043e\\u0435\\u0439 \\u0436\\u0438\\u0437\\u043d\\u0438&raquo;.<\\/p>"}	2021-07-30 18:40:54	2021-07-30 18:40:54
