15855	9	admin/users/report/edit/183/resume	POST	90.154.70.245	{"resume":"<p><span data-contrast=\\"auto\\">\\u0422\\u044b - \\"\\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u043d\\u044b\\u0439 \\u0445\\u0443\\u0434\\u043e\\u0436\\u043d\\u0438\\u043a\\", \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e \\u0438 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432.&nbsp;<\\/span><span data-contrast=\\"auto\\">\\u0422\\u0435\\u0431\\u0435 \\u043f\\u043e\\u0434\\u043e\\u0448\\u043b\\u0430 \\u0431\\u044b<\\/span><span data-contrast=\\"auto\\">&nbsp;\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430, \\u0433\\u0434\\u0435 \\u043d\\u0435\\u0442 \\u0436\\u0435\\u0441\\u0442\\u043a\\u043e\\u0433\\u043e \\u0440\\u0435\\u0436\\u0438\\u043c\\u0430, \\u0444\\u043e\\u0440\\u043c\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439, \\u0436\\u0435\\u0441\\u0442\\u043a\\u0438\\u0445 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0439, \\u0433\\u0434\\u0435 \\u0446\\u0435\\u043d\\u0438\\u0442\\u0441\\u044f \\u043f\\u043e\\u043b\\u0435\\u0442 \\u0444\\u0430\\u043d\\u0442\\u0430\\u0437\\u0438\\u0438, \\u0432\\u043e\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u0438\\u0435, \\u0433\\u0434<\\/span><span data-contrast=\\"auto\\">\\u0435 \\u0432\\u0430\\u0436\\u043d\\u043e&nbsp;<\\/span><span data-contrast=\\"auto\\">\\u0438\\u043c\\u0435\\u0442\\u044c&nbsp;\\u0432\\u043a\\u0443\\u0441<\\/span><span data-contrast=\\"auto\\">,<\\/span><span data-contrast=\\"auto\\">&nbsp;\\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u0442\\u0430\\u043b\\u0430\\u043d\\u0442 - \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0439, \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043d\\u044b\\u0439, \\u043c\\u0443\\u0437\\u044b<\\/span><span data-contrast=\\"auto\\">\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439.<\\/span><span data-contrast=\\"auto\\">&nbsp;\\u0422\\u044b \\u0446\\u0435\\u043d\\u0438\\u0448\\u044c \\u043e\\u0440\\u0438\\u0433\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0438 \\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u044c, \\u043d\\u0435\\u043e\\u0431\\u044b\\u0447\\u043d\\u044b\\u0439 \\u0432\\u0437\\u0433\\u043b\\u044f\\u0434 \\u043d\\u0430 \\u0436\\u0438\\u0437\\u043d\\u044c, \\u0430 \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0441\\u0430\\u043c\\u0430 \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0442\\u044c \\u0432\\u043e\\u0441\\u0445\\u0438\\u0449\\u0435\\u043d\\u0438\\u0435<\\/span><span data-contrast=\\"auto\\">.<\\/span><span data-contrast=\\"auto\\">&nbsp;\\u0414\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u043d\\u0430 \\u0433\\u0438\\u0431\\u043a\\u043e\\u0441\\u0442\\u044c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f \\u0438 \\u044d\\u043c\\u043e\\u0446\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e. \\u0414\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u043d\\u043e \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043c\\u044b\\u0441\\u043b\\u0438\\u0442\\u044c, \\u043d\\u0430\\u0445\\u043e\\u0434\\u0438\\u0442\\u044c \\u043d\\u0435\\u0441\\u0442\\u0430\\u043d\\u0434\\u0430\\u0440\\u0442\\u043d\\u044b\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f \\u0437\\u0430\\u0434\\u0430\\u0447\\u0438, \\u0441\\u043e\\u0437\\u0434\\u0430\\u0432\\u0430\\u0442\\u044c \\u0447\\u0442\\u043e-\\u0442\\u043e \\u043d\\u043e\\u0432\\u043e\\u0435, \\u043e\\u0442\\u043a\\u043b\\u043e\\u043d\\u044f\\u044f\\u0441\\u044c \\u043e\\u0442 \\u0448\\u0430\\u0431\\u043b\\u043e\\u043d\\u043e\\u0432 \\u0438 \\u043e\\u0431\\u0449\\u0435\\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044b\\u0445 \\u0441\\u0445\\u0435\\u043c. \\u0411\\u043b\\u0430\\u0433\\u043e\\u0434\\u0430\\u0440\\u044f \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043b\\u0435\\u0433\\u043a\\u043e \\u043d\\u0430\\u0439\\u0442\\u0438 \\u0432\\u044b\\u0445\\u043e\\u0434 \\u0438\\u0437 \\u0437\\u0430\\u0442\\u0440\\u0443\\u0434\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0441\\u0438\\u0442\\u0443\\u0430\\u0446\\u0438\\u0438.&nbsp;<\\/span><span data-contrast=\\"auto\\">\\u041e\\u0431\\u0440\\u0430\\u0442\\u0438 \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0442\\u0438\\u043f\\u0438\\u0447\\u043d\\u044b\\u0435 \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044f &laquo;<\\/span><span data-contrast=\\"auto\\">\\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u0449\\u0438\\u043a\\u043e\\u0432<\\/span><span data-contrast=\\"auto\\">&raquo; - \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\\u0438\\u044f, \\u043a\\u0438\\u043d\\u043e, \\u0442\\u0435\\u0430\\u0442\\u0440, \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435, \\u0442\\u0430\\u043d\\u0446\\u0435\\u0432\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435, \\u0438\\u0437\\u043e\\u0431\\u0440\\u0430\\u0437\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e, \\u0430 \\u0442\\u0430\\u043a\\u0436\\u0435&nbsp;<\\/span><span data-contrast=\\"auto\\">&ndash;&nbsp; \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c\\u043d\\u0430\\u044f<\\/span><span data-contrast=\\"auto\\">&nbsp;\\u0438\\u043d\\u0434\\u0443\\u0441\\u0442\\u0440\\u0438\\u044f, \\u0441\\u0444\\u0435\\u0440\\u0430 \\u043a\\u0440\\u0430\\u