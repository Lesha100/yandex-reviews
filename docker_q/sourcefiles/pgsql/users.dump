 \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u044e\\u0442 \\u0443\\u0432\\u043b\\u0435\\u043a\\u0430\\u0442\\u044c\\u0441\\u044f \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438\\u0435\\u0439. \\u041a\\u0430\\u043a \\u0438 \\u0432\\u0441\\u0435\\u043c \\u0438\\u043c \\u044f \\u0434\\u0430\\u043c \\u0442\\u0435\\u0431\\u0435 \\u0442\\u0430\\u043a\\u0443\\u044e \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0430\\u0446\\u0438\\u044e - \\u0443\\u0437\\u043d\\u0430\\u0439 \\u043e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435. \\u042d\\u0442\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e. \\u041f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c \\u0432 \\u0433\\u043e\\u0441\\u0443\\u0434\\u0430\\u0440\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u043c \\u0443\\u0447\\u0440\\u0435\\u0436\\u0434\\u0435\\u043d\\u0438\\u0438 \\u0438\\u043b\\u0438 \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u0447\\u0430\\u0441\\u0442\\u043d\\u043e\\u0439 \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u043a\\u043e\\u0439, \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u043d\\u0430\\u0443\\u043a\\u043e\\u0439, \\u0438\\u043b\\u0438 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c \\u043d\\u0430 \\u0431\\u0438\\u0437\\u043d\\u0435\\u0441. \\u0412\\u0441\\u0451 \\u044d\\u0442\\u043e \\u0440\\u0430\\u0437\\u043d\\u044b\\u0435 \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438, \\u0440\\u0430\\u0437\\u043d\\u043e\\u0439 \\u043a\\u0432\\u0430\\u043b\\u0438\\u0444\\u0438\\u043a\\u0430\\u0446\\u0438\\u0438, \\u0441 \\u0440\\u0430\\u0437\\u043d\\u044b\\u043c \\u0443\\u0440\\u043e\\u0432\\u043d\\u0435\\u043c \\u0434\\u043e\\u0445\\u043e\\u0434\\u0430. \\u0421\\u0430\\u043c\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e\\u0439 \\u0441\\u043f\\u