15348	9	admin/users/report/edit/195/comment	POST	77.238.236.109	{"recommendations":"<p>\\u0423 \\u0442\\u0435\\u0431\\u044f \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c \\u0442\\u0440\\u0435\\u0432\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0422\\u044b \\u0432\\u043e\\u043b\\u043d\\u0443\\u0435\\u0448\\u044c\\u0441\\u044f, \\u043a\\u0430\\u043a \\u0442\\u0435\\u0431\\u044f \\u0432\\u043e\\u0441\\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u044e\\u0442 \\u0438\\u043b\\u0438 \\u043e\\u0446\\u0435\\u043d\\u0438\\u0432\\u0430\\u044e\\u0442 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0435. \\u041c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0431\\u043e\\u043b\\u0435\\u0437\\u043d\\u0435\\u043d\\u043d\\u043e \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u0442\\u044c \\u043a\\u0440\\u0438\\u0442\\u0438\\u043a\\u0443, \\u0431\\u043e\\u0438\\u0448\\u044c\\u0441\\u044f \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0448\\u0430\\u0433, \\u043e\\u0448\\u0438\\u0431\\u0438\\u0442\\u044c\\u0441\\u044f. &nbsp;\\u0418 \\u044d\\u0442\\u043e &nbsp;\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0442\\u044c \\u043d\\u0430\\u043f\\u0440\\u044f\\u0436\\u0435\\u043d\\u0438\\u0435, \\u0447\\u0442\\u043e \\u043e\\u0442\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 \\u043c\\u043d\\u043e\\u0433\\u043e \\u0441\\u0438\\u043b. \\u0415\\u0441\\u043b\\u0438 \\u043f\\u043e\\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0443\\u0435\\u0448\\u044c, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0432\\u0430\\u0436\\u043d\\u043e \\u043f\\u043e\\u043f\\u0440\\u043e\\u0431\\u043e\\u0432\\u0430\\u0442\\u044c \\u0441 \\u044d\\u0442\\u0438\\u043c \\u0447\\u0442\\u043e-\\u0442\\u043e \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c, \\u043e\\u0431\\u0440\\u0430\\u0449\\u0430\\u0439\\u0441\\u044f. \\u041c\\u044b \\u0431\\u0443\\u0434\\u0435\\u043c \\u0440\\u0430\\u0434\\u044b \\u043f\\u043e\\u043c\\u043e\\u0447\\u044c!<\\/p>\\n<p>\\u0422\\u044b \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a, \\u044d\\u0442\\u043e \\u0434\\u0430\\u0435\\u0442 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c \\u0431\\u044b\\u0442\\u044c \\u044d\\u043c\\u043f\\u0430\\u0442\\u0438\\u0447\\u043d\\u043e\\u0439 \\u043a \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c, \\u0447\\u0442\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u0438 \\u0446\\u0435\\u043d\\u043d\\u043e \\u0434\\u043b\\u044f \\u0443\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u0439, \\u0434\\u0440\\u0443\\u0436\\u0431\\u044b. \\u041d\\u043e \\u043e\\u0431\\u0440\\u0430\\u0442\\u0438 \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0441\\u043a\\u043e\\u0440\\u0435\\u0435 \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0435\\u0448\\u044c \\u0432\\u0435\\u0434\\u043e\\u043c\\u0443\\u044e \\u043f\\u043e\\u0437\\u0438\\u0446\\u0438\\u044e, \\u0442\\u0435\\u0431\\u0435 \\u0442\\u0440\\u0443\\u0434\\u043d\\u043e \\u043e\\u0442\\u0441\\u0442\\u0430\\u0438\\u0432\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u0435 \\u043c\\u043d\\u0435\\u043d\\u0438\\u0435 \\u0438\\u043b\\u0438 \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c \\u0441\\u0432\\u043e\\u044e \\u0438\\u0434\\u0435\\u044e.&nbsp; \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u044d\\u0442\\u043e \\u0441\\u0432\\u044f\\u0437\\u0430\\u043d\\u043e \\u0441 \\u043d\\u0435\\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0432 \\u0441\\u0435\\u0431\\u0435, \\u043d\\u0435\\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0441\\u043a\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0432 \\u043a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442\\u0435 \\u0441 \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c\\u0438. \\u041b\\u044e\\u0434\\u044f\\u043c \\u0441 \\u0442\\u043e\\u0431\\u043e\\u0439 \\u043a\\u043e\\u043c\\u0444\\u043e\\u0440\\u0442\\u043d\\u043e, \\u043d\\u043e \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0438\\u043d\\u043e\\u0433\\u0434\\u0430 \\u0441\\u0442\\u0430\\u043b\\u043a\\u0438\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f \\u0441 \\u0442\\u0435\\u043c. \\u0427\\u0442\\u043e \\u0442\\u0432\\u043e\\u0438 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438, \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u044f \\u0438\\u043b\\u0438 \\u0446\\u0435\\u043b\\u0438 \\u043d\\u0435 \\u0443\\u0434\\u043e\\u0432\\u043b\\u0435\\u0442\\u0432\\u043e\\u0440\\u044f\\u044e\\u0442\\u0441\\u044f. \\u0418 \\u0442\\u043e\\u0433\\u0434\\u0430 \\u044d\\u0442\\u043e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043d\\u0430\\u043a\\u0430\\u043f\\u043b\\u0438\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f \\u0438 \\u043f\\u0440\\u0438\\u0432\\u043e\\u0434\\u0438\\u0442\\u044c \\u0442\\u0435\\u0431\\u044f \\u043a \\u0443\\u0441\\u0442\\u0430\\u043b\\u043e\\u0441\\u0442\\u0438, \\u0441\\u043d\\u0438\\u0436\\u0435\\u043d\\u0438\\u044e \\u0441\\u0438\\u043b \\u0438\\u043b\\u0438, \\u043d\\u0430\\u043e\\u0431\\u043e\\u0440\\u043e\\u0442, \\u0432\\u0441\\u043f\\u044b\\u0448\\u043a\\u0430\\u043c&nbsp; \\u0440\\u0430\\u0437\\u0434\\u0440\\u0430\\u0436\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438.&nbsp; \\u041a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442\\u044b \\u0441 \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c\\u0438 \\u0432\\u0430\\u0436\\u043d\\u044b \\u0438 \\u0438\\u043c\\u0435\\u044e\\u0442 \\u043e\\u0433\\u0440\\u043e\\u043c\\u043d\\u043e\\u0435 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u0432 \\u0441\\u0444\\u0435\\u0440\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u044f \\u0438 \\u043a\\u0430\\u0440\\u044c\\u0435\\u0440\\u044b, \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u0437\\u0434\\u0435\\u0441\\u044c \\u0441\\u0442\\u043e\\u0438\\u0442 \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u0442\\u044c \\u043e \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435\\u0439 \\u0433\\u0430\\u0440\\u043c\\u043e\\u043d\\u0438\\u0438 &nbsp;\\u0432 \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0438 \\u0441 \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c\\u0438 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438 \\u0438 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043e\\u0432.<\\/p>","name":"\\u041c\\u0430\\u043a\\u0441\\u0438\\u043c \\u0413\\u043e\\u0440\\u044c\\u043a\\u0438\\u0439","post":"\\u041f\\u0438\\u0441\\u0430\\u0442\\u0435\\u043b\\u044c","comment":"\\u00ab\\u041d\\u0443\\u0436\\u043d\\u043e \\u043b\\u044e\\u0431\\u0438\\u0442\\u044c \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0434\\u0435\\u043b\\u0430\\u0435\\u0448\\u044c, \\u0438 \\u0442\\u043e\\u0433\\u0434\\u0430 \\u0442\\u0440\\u0443\\u0434 \\u2013 \\u0434\\u0430\\u0436\\u0435 \\u0441\\u0430\\u043c\\u044b\\u0439 \\u0433\\u0440\\u0443\\u0431\\u044b\\u0439 \\u2013 \\u0432\\u043e\\u0437\\u0432\\u044b\\u0448\\u0430\\u0435\\u0442\\u0441\\u044f \\u0434\\u043e \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430\\u00bb"}	2021-01-28 18:38:50	2021-01-28 18:38:50
