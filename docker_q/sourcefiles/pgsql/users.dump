34\\u0435\\u043d\\u0446\\u0438\\u044f \\u043a \\u0438\\u043d\\u0434\\u0438\\u0432\\u0438\\u0434\\u0443\\u0430\\u043b\\u0438\\u0437\\u043c\\u0443 - \\u043a \\u0443\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u043f\\u0440\\u0435\\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u043d\\u0438\\u044e \\u0441\\u043e\\u0431\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e, \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u043c\\u0438 \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e \\u0441\\u0430\\u043c\\u043e\\u0431\\u044b\\u0442\\u043d\\u043e\\u0433\\u043e \\u0438 \\u0441\\u0443\\u0431\\u044a\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u0433\\u043e \\u043c\\u043d\\u0435\\u043d\\u0438\\u044f. \\u0422\\u044b \\u043d\\u0435 \\u0441\\u043a\\u043b\\u043e\\u043d\\u0435\\u043d \\u043a \\u0430\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u043c\\u0443 \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u044e, \\u0442\\u0435\\u0431\\u0435 \\u043a\\u043e\\u043c\\u0444\\u043e\\u0440\\u0442\\u043d\\u0435\\u0435 \\u043d\\u0430\\u0445\\u043e\\u0434\\u0438\\u0442\\u044c\\u0441\\u044f \\u0432 \\u043c\\u0438\\u0440\\u0435 \\u0441\\u0432\\u043e\\u0438\\u0445 \\u0440\\u0430\\u0437\\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0439. \\u0422\\u044b \\u0432\\u0434\\u0443\\u043c\\u0447\\u0438\\u0432, \\u0440\\u0430\\u0441\\u0441\\u0443\\u0434\\u0438\\u0442\\u0435\\u043b\\u0435\\u043d, \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u0438\\u0437\\u043b\\u0438\\u0448\\u043d\\u0435 \\u0441\\u043a\\u0440\\u043e\\u043c\\u0435\\u043d \\u0438 \\u0437\\u0430\\u0441\\u0442\\u0435\\u043d\\u0447\\u0438\\u0432. \\u0412 \\u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u0438 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430 \\u0434\\u0440\\u0443\\u0437\\u0435\\u0439 \\u0442\\u044b \\u0432\\u043d\\u0438\\u043c\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d. \\u0412 \\u0441\\u0438\\u0442\\u0443\\u0430\\u0446\\u0438\\u044f\\u0445, \\u0433\\u0434\\u0435 \\u043d\\u0443\\u0436\\u043d\\u043e \\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0437\\u0430 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439, \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043f\\u043e\\u0434\\u0432\\u0435\\u0440\\u0433\\u0430\\u0442\\u044c\\u0441\\u044f \\u0441\\u0442\\u0440\\u0435\\u0441\\u0441\\u0443 \\u0438 \\u0441\\u0438\\u043b\\u044c\\u043d\\u043e\\u043c\\u0443 \\u0432\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u044e. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0441\\u0435\\u0440\\u044c\\u0435\\u0437\\u043d\\u043e \\u043e\\u0442\\u043d\\u043e\\u0441\\u0438\\u0448\\u044c\\u0441\\u044f \\u043a \\u043e\\u0446\\u0435\\u043d\\u043a\\u0435 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0430\\u044e\\u0449\\u0438\\u0445.&nbsp;<\\/p>\\n<p><strong><span style=\\"color: #2761a0;\\">\\u0422\\u0438\\u043f \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f.<\\/span>&nbsp;<\\/strong>\\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043f\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u044e\\u0442, \\u0447\\u0442\\u043e \\u0442\\u044b \\u044f\\u0440\\u043a\\u043e \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u044b\\u0439 \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u043a, \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u044b\\u0439 \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u043c\\u0438 \\u0434\\u0435\\u043b\\u0430\\u043c\\u0438 \\u0438 \\u0438\\u043c\\u0435\\u0442\\u044c \\u0434\\u0435\\u043b\\u043e \\u0441 \\u0432\\u0435\\u0449\\u0430\\u043c\\u0438, \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u0430\\u043c\\u0438, \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u043e\\u0439. \\u0414\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u0432\\u0430\\u0436\\u043d\\u043e \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0442\\u044c \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0439 \\u0438 \\u043e\\u0449\\u0443\\u0442\\u0438\\u043c\\u044b\\u0439 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u0432 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0423 \\u0442\\u0435\\u0431\\u044f \\u0435\\u0441\\u0442\\u044c \\u0440\\u0430\\u0441\\u043f\\u043e\\u043b\\u043e\\u0436\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438, \\u0433\\u0434\\u0435 \\u043d\\u0443\\u0436\\u043d\\u0430 \\u0434\\u0432\\u0438\\u0433\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u0430\\u044f \\u0430\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0442\\u0435\\u0431\\u0435 \\u043f\\u043e\\u0439\\u0434\\u0435\\u0442 \\u0441\\u0444\\u0435\\u0440\\u0430 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b \\u0441 \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u043e\\u0439. \\u041c\\u043e\\u0436\\u043d\\u043e \\u0440\\u0430\\u0441\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u0442\\u044c \\u0442\\u0430\\u043a\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u043a\\u0430\\u043a \\u0430\\u0432\\u0442\\u043e\\u043c\\u0435\\u0445\\u0430\\u043d\\u0438\\u043a, \\u0441\\u043f\\u043e\\u0440\\u0442\\u0441\\u043c\\u0435\\u043d, \\u043e\\u043f\\u0435\\u0440\\u0430\\u0442\\u043e\\u0440 \\u041f\\u041a, \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a, \\u043f\\u0438\\u043b\\u043e\\u0442, \\u0444\\u0435\\u0440\\u043c\\u0435\\u0440\\u0441\\u0442\\u0432\\u043e \\u0438 \\u0441\\u0430\\u0434\\u043e\\u0432\\u043e\\u0434\\u0441\\u0442\\u0432\\u043e. \\u041f\\u043e - \\u0432\\u0438\\u0434\\u0438\\u043c\\u043e\\u043c\\u0443, \\u0442\\u044b \\u043d\\u0435 \\u0441\\u043a\\u043b\\u043e\\u043d\\u0435\\u043d \\u043a \\u0430\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u043c\\u0443 \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u044e, \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u044d\\u0442\\u043e \\u043d\\u0443\\u0436\\u043d\\u043e \\u0443\\u0447\\u0438\\u0442\\u044b\\u0432\\u0430\\u0442\\u044c \\u043f\\u0440\\u0438 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0438 \\u0442\\u0438\\u043f\\u0430 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438. \\u041d\\u0443\\u0436\\u043d\\u043e \\u043e\\u0442\\u0434\\u0430\\u0442\\u044c \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u0447\\u0442\\u0435\\u043d\\u0438\\u0435 \\u043c\\u0435\\u043d\\u0435\\u0435 \\u043a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442\\u043d\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0412\\u0430\\u0436\\u043d\\u043e, \\u0447\\u0442\\u043e\\u0431\\u044b \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0431\\u044b\\u043b\\u0430 \\u0447\\u0435\\u0442\\u043a\\u043e \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u043e\\u0432\\u0430\\u043d\\u0430 \\u0441 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u043d\\u044b\\u043c \\u043f\\u0435\\u0440\\u0435\\u0447\\u043d\\u0435\\u043c \\u043e\\u0431\\u044f\\u0437\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439, \\u0442\\u0435\\u0431\\u0435 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0442\\u0440\\u0443\\u0434\\u043d\\u0435\\u0435 \\u043e\\u0440\\u0438\\u0435\\u043d\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f, \\u0433\\u0434\\u0435 \\u043d\\u0443\\u0436\\u043d\\u0430 \\u0433\\u0440\\u0430\\u043d\\u0438\\u0446\\u0430 \\u0440\\u0430\\u0437\\u043c\\u044b\\u0442\\u044b.&nbsp;<\\/p>\\n<p><span style=\\"color: #2761a0;\\"><strong>\\u0422\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0442\\u0438\\u043f \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f<\\/strong><\\/span> \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043b\\u043e, \\u0447\\u0442\\u043e \\u0443 \\u0442\\u0435\\u0431\\u044f \\u044f\\u0440\\u043a\\u043e \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u0430 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c - <strong>\\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c<\\/strong>. \\u042d\\u0442\\u043e \\u043e\\u0447\\u0435\\u043d\\u044c \\u0440\\u0435\\u0434\\u043a\\u043e\\u0435 \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e, \\u043d\\u043e \\u0431\\u043b\\u0430\\u0433\\u043e\\u0434\\u0430\\u0440\\u044f \\u0435\\u043c\\u0443 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u0435\\u043d \\u0434\\u043e\\u0431\\u0438\\u0442\\u044c\\u0441\\u044f \\u0443\\u0441\\u043f\\u0435\\u0445\\u0430 \\u0432 \\u043b\\u044e\\u0431\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c. \\u041b\\u044e\\u0434\\u0438 \\u0441 \\u043d\\u0435\\u0441\\u0442\\u0430\\u043d\\u0434\\u0430\\u0440\\u0442\\u043d\\u044b\\u043c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435\\u043c \\u0438 \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u043e\\u043c \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u043f\\u0440\\u0438\\u0432\\u043b\\u0435\\u043a\\u0430\\u044e\\u0442 \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435. \\u0418\\u043c\\u0435\\u0435\\u0442 \\u044f\\u0440\\u043a\\u0443\\u044e \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c <strong>\\u0430\\u0431\\u0441\\u0442\\u0440\\u0430\\u043a\\u0442\\u043d\\u043e &ndash; \\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u