d\\/pdf_files\\/atlas.pdf&nbsp;&nbsp;\\u042d\\u0442\\u043e \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u0439, \\u0431\\u0435\\u0441\\u043f\\u043b\\u0430\\u0442\\u043d\\u044b\\u0439 \\u0440\\u0435\\u0441\\u0443\\u0440\\u0441. \\u0422\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043e\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u0438\\u0442\\u044c\\u0441\\u044f \\u0441 \\u0446\\u0438\\u0444\\u0440\\u043e\\u0432\\u043e\\u0439 \\u0432\\u0435\\u0440\\u0441\\u0438\\u0435\\u0439 \\u0430\\u0442\\u043b\\u0430\\u0441\\u0430 2020 \\u0433\\u043e\\u0434\\u0430 \\u0438 \\u043f\\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u0442\\u044c, \\u043a\\u0430\\u043a\\u0438\\u0435 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u0438\\u0437\\u043e\\u0439\\u0434\\u0443\\u0442 \\u0441 \\u043c\\u0438\\u0440\\u043e\\u043c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u0432 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u043c (\\u0438 \\u043d\\u0435 \\u0441\\u043e\\u0432\\u0441\\u0435\\u043c) \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u043c.<\\/span><\\/h4>\\n<h4 style=\\"margin-bottom: 0cm; background: white;\\"><span style=\\"font-size: 10.0pt; color: #51565b;\\">5. \\u0423\\u0447\\u0438\\u0441\\u044c, \\u0443\\u0447\\u0438\\u0441\\u044c \\u0438 \\u0435\\u0449\\u0435 \\u0440\\u0430\\u0437 \\u0443\\u0447\\u0438\\u0441\\u044c. \\u0423\\u0447\\u0435\\u0431\\u0430 &ndash; \\u044d\\u0442\\u043e \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0442\\u043e, \\u0447\\u0442\\u043e \\u043c\\u044b \\u0432\\u0438\\u0434\\u0438\\u043c \\u0432 \\u0448\\u043a\\u043e\\u043b\\u0435. \\u0421\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0442 \\u0441\\u043e\\u0442\\u043d\\u0438 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u0445 \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442\\u043e\\u0432,