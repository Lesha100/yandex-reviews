14617	8	admin/users/report/edit/178/comment	POST	77.238.236.109	{"recommendations":"<p><span style=\\"color: #2761a0;\\"><strong>\\u041e\\u0433\\u0440\\u043e\\u043c\\u043d\\u044b\\u043c\\u0438 \\u0440\\u0435\\u0441\\u0443\\u0440\\u0441\\u0430\\u043c\\u0438<\\/strong><\\/span> <span style=\\"color: #707070;\\">\\u0434\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u044f\\u0432\\u043b\\u044f\\u044e\\u0442\\u0441\\u044f: \\u0442\\u0432\\u043e\\u044f \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0446\\u0435\\u043b\\u0435\\u0443\\u0441\\u0442\\u0440\\u0435\\u043c\\u043b\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043b\\u044e\\u0431\\u043e\\u0432\\u044c \\u043a \\u0441\\u043f\\u043e\\u0440\\u0442\\u0443, \\u0432\\u044b\\u043d\\u043e\\u0441\\u043b\\u0438\\u0432\\u043e\\u0441\\u0442\\u044c, \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0421\\u0442\\u0430\\u0432\\u043a\\u0443 \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u043d\\u0430 \\u0442\\u0432\\u043e\\u0439 \\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442, \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438 \\u043a \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0435 \\u0438 \\u0444\\u0438\\u0437\\u0438\\u0447\\u0435\\u0441\\u043a\\u0443\\u044e \\u043f\\u043e\\u0434\\u0433\\u043e\\u0442\\u043e\\u0432\\u043b\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c. \\u0415\\u0441\\u043b\\u0438 \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e \\u0442\\u0432\\u043e\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 - \\u0441\\u0442\\u0430\\u0442\\u044c \\u043a\\u0438\\u043d\\u043e\\u043b\\u043e\\u0433\\u043e\\u043c, \\u0442\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0432\\u0430\\u0442\\u044c soft skills (\\u043d\\u0430\\u0434\\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043d\\u0430\\u0432\\u044b\\u043a\\u0438). \\u0424\\u043e\\u043a\\u0443\\u0441\\u0438\\u0440\\u043e\\u0432\\u043a\\u0430 \\u043d\\u0430 \\u0437\\u0430\\u0434\\u0430\\u0447\\u0430\\u0445, \\u0441\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u044c \\u0440\\u0435\\u0430\\u043a\\u0446\\u0438\\u0438, \\u0432\\u043d\\u0438\\u043c\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a \\u043c\\u0435\\u043b\\u043e\\u0447\\u0430\\u043c \\u0438 \\u0445\\u043e\\u0440\\u043e\\u0448\\u0430\\u044f \\u043f\\u0430\\u043c\\u044f\\u0442\\u044c &ndash; \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u044b \\u0434\\u043b\\u044f \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e\\u0431\\u044b \\u0432\\u0430\\u0441 \\u0437\\u0430\\u043c\\u0435\\u0442\\u0438\\u043b\\u0438 \\u0438 \\u043f\\u043e\\u0441\\u0442\\u0430\\u0432\\u0438\\u043b\\u0438 \\u043d\\u0430 \\u0440\\u0443\\u043a\\u043e\\u0432\\u043e\\u0434\\u044f\\u0449\\u0443\\u044e \\u0434\\u043e\\u043b\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c. \\u0415\\u0441\\u043b\\u0438 \\u0442\\u044b \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0443\\u0435\\u0448\\u044c, \\u0447\\u0442\\u043e \\u043d\\u0430\\u0434 \\u043d\\u0435\\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u043c\\u0438 \\u043d\\u0443\\u0436\\u043d\\u043e \\u043f\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c, \\u0442\\u043e \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u044e \\u0434\\u043b\\u044f \\u0438\\u0445 \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u044f \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u0442\\u0440\\u0435\\u043d\\u0430\\u0436\\u0435\\u0440\\u044b \\u0434\\u043b\\u044f \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u044f \\u043c\\u043e\\u0437\\u0433\\u0430. \\u0418\\u0445 \\u0441\\u0435\\u0439\\u0447\\u0430\\u0441 \\u0431\\u043e\\u043b\\u044c\\u0448\\u043e\\u0435 \\u043a\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e \\u0432 \\u0438\\u043d\\u0442\\u0435\\u0440\\u043d\\u0435\\u0442\\u0435 \\u0438 \\u043d\\u0435\\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u043c\\u043e\\u0436\\u043d\\u043e \\u0441\\u043a\\u0430\\u0447\\u0430\\u0442\\u044c \\u0431\\u0435\\u0441\\u043f\\u043b\\u0430\\u0442\\u043d\\u043e.\\u041e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u044e \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438\\u0442\\u044c \\u0441\\u043f\\u043e\\u0440\\u0442 \\u0432 \\u0441\\u0432\\u043e\\u0435\\u0439 \\u0436\\u0438\\u0437\\u043d\\u0438 \\u0438 \\u0442\\u044f\\u0433\\u0443 \\u043a \\u0442\\u0443\\u0440\\u0438\\u0437\\u043c\\u0443, \\u044d\\u0442\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0438\\u0442 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438\\u0442\\u044c \\u043e\\u0442\\u043b\\u0438\\u0447\\u043d\\u0443\\u044e \\u0444\\u0438\\u0437\\u0438\\u0447\\u0435\\u0441\\u043a\\u0443\\u044e \\u0444\\u043e\\u0440\\u043c\\u0443, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u0442\\u0430\\u043a \\u0432\\u0430\\u0436\\u043d\\u0430 \\u0434\\u043b\\u044f \\u0442\\u0432\\u043e\\u0435\\u0439 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438. \\u041d\\u0435\\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e \\u0441\\u0442\\u0430\\u0442\\u044c \\u043a\\u0438\\u043d\\u043e\\u043b\\u043e\\u0433\\u043e\\u043c, \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0435 \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u0435\\u0448\\u044c \\u043d\\u0430\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438