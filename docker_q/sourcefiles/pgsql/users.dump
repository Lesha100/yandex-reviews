25224	1	admin/instruction/update/8/10	POST	146.120.13.117	{"_token":"oUP2lMRiLKVGzJc6OhSyZKOqP3w6pm32GQu6HIu6","description":"\\u0414\\u0430\\u043d\\u043d\\u044b\\u0439 \\u0442\\u0435\\u0441\\u0442 \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u0447\\u0430\\u0441\\u0442\\u044c\\u044e \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u044b, \\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043d\\u043d\\u043e\\u0439 \\"\\u041d\\u0430\\u0443\\u0447\\u043d\\u043e-\\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u043c \\u0446\\u0435\\u043d\\u0442\\u0440\\u043e\\u043c \\u0434\\u0435\\u0442\\u0441\\u043a\\u043e\\u0439 \\u043d\\u0435\\u0432\\u0440\\u043e\\u043b\\u043e\\u0433\\u0438\\u0438 \\u0438\\u043c. \\u0421\\u0443\\u0445\\u0430\\u0440\\u0435\\u0432\\u043e\\u0439\\" \\u0438 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0435\\u0442\\u0441\\u044f \\u0434\\u043b\\u044f \\u043f\\u043e\\u043c\\u043e\\u0449\\u0438 \\u0432 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438.","point":["\\u0412\\u044b\\u0431\\u0438\\u0440\\u0430\\u044f \\u0438\\u0437 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u043f\\u0430\\u0440\\u044b \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 - \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0439\\u0442\\u0435 \\u0442\\u0443 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u0432 \\u043d\\u0430\\u0438\\u0431\\u043e\\u043b\\u044c\\u0448\\u0435\\u0439 \\u0441\\u0442\\u0435\\u043f\\u0435\\u043d\\u0438 \\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442 \\u0432\\u0430\\u0448\\u0438\\u043c \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u044f\\u043c","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043d\\u0435 \\u0442\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u043c\\u043d\\u043e\\u0433\\u043e \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438 \\u043d\\u0430 \\u043e\\u0431\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u043d\\u0438\\u0435","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043e\\u0442\\u0432\\u0435\\u0447\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a \\u043c\\u043e\\u0436\\u043d\\u043e \\u0438\\u0441\\u043a\\u0440\\u0435\\u043d\\u043d\\u0435\\u0439","\\u041d\\u0435\\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u043f\\u0430\\u0440\\u044b \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u043c\\u043e\\u0433\\u0443\\u0442 \\u0431\\u044b\\u0442\\u044c \\u043e\\u0434\\u0438\\u043d\\u0430\\u043a\\u043e\\u0432\\u043e \\u043d\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b \\u0432\\u0430\\u043c. \\u0422\\u043e\\u0433\\u0434\\u0430 \\u0432\\u044b\\u0431\\u0435\\u0440\\u0435\\u0442\\u0435 \\u0442\\u0443, \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u0432 \\u043c\\u0435\\u043d\\u044c\\u0448\\u0435\\u0439 \\u0441\\u0442\\u0435\\u043f\\u0435\\u043d\\u0438.","\\u041f\\u043e\\u043c\\u043d\\u0438\\u0442\\u0435, \\u0447\\u0442\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b \\u043d\\u0430 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441 \\u043d\\u0438\\u0433\\u0434\\u0435 \\u043d\\u0435 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f, \\u0438 \\u043d\\u0438\\u043a\\u0442\\u043e (\\u0434\\u0430\\u0436\\u0435 \\u0432\\u044b \\u0441\\u0430\\u043c\\u0438) \\u043d\\u0435 \\u0441\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0438\\u0445 \\u0443\\u0432\\u0438\\u0434\\u0435\\u0442\\u044c \\u043f\\u043e \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u043d\\u0438\\u0438 \\u0442\\u0435\\u0441\\u0442\\u0430.","\\u041f\\u043e \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u043d\\u0438\\u0438 \\u0442\\u0435\\u0441\\u0442\\u0430 \\u0432\\u044b \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u0435 \\u043a\\u0440\\u0430\\u0442\\u043a\\u0438\\u0439 \\u043e\\u0442\\u0447\\u0435\\u0442 \\u0441 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u043c.",null,null,null,null]}	2021-04-21 13:23:23	2021-04-21 13:23:23
