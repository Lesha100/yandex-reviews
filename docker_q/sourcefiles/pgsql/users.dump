21614	8	admin/users/report/edit/240/resume	POST	77.238.236.109	{"resume":"<p><span style=\\"color: #2761a0;\\"><strong>\\u041d\\u0435 \\u043f\\u0443\\u0433\\u0430\\u0439\\u0441\\u044f,<\\/strong><\\/span> \\u0435\\u0441\\u043b\\u0438 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u043f\\u043e\\u043a\\u0430\\u0436\\u0443\\u0442\\u0441\\u044f \\u0442\\u0435\\u0431\\u0435 \\"\\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c\\u0438\\". \\u0420\\u0435\\u043d\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438 - \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0440\\u0430\\u0441\\u0441\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0448\\u044c \\u043e \\u0441\\u0435\\u0431\\u0435. \\u041f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0432 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u043e\\u0439 \\u0438 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e\\u0439 \\u0444\\u043e\\u0440\\u043c\\u0435.<\\/p>\\n<p><br \\/><span style=\\"color: #2761a0;\\"><strong>\\u041f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0438\\u043f \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438.<\\/strong><\\/span> \\u0422\\u044b - \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0442\\u043e\\u0440, \\u0441\\u0442\\u0440\\u0435\\u043c\\u044f\\u0449\\u0438\\u0439\\u0441\\u044f \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u0438 \\u043b\\u0438\\u0434\\u0435\\u0440\\u0441\\u043a\\u0438\\u0435 \\u0430\\u043c\\u0431\\u0438\\u0446\\u0438\\u0438. \\u041f\\u043e \\u043d\\u0430\\u0448\\u0435\\u043c\\u0443 \\u043c\\u043d\\u0435\\u043d\\u0438\\u044e, \\u0442\\u0435\\u0431\\u0435 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u043e\\u0449\\u0435, \\u0435\\u0441\\u043b\\u0438 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c \\u0441\\u0430\\u043c\\u043e\\u0441\\u0442\\u043e\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0440\\u0443\\u043a\\u043e\\u0432\\u043e\\u0434\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441\\u043e\\u043c, \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u0430 \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u0439. \\u0417\\u0430 \\u0441\\u0432\\u043e\\u0438 \\u0438\\u0434\\u0435\\u0438 \\u0438 \\u0446\\u0435\\u043b\\u0438 &ndash; \\u0442\\u044b \\u0433\\u043e\\u0442\\u043e\\u0432 \\u0441\\u0442\\u043e\\u044f\\u0442\\u044c \\u0434\\u043e \\u043a\\u043e\\u043d\\u0446\\u0430. \\u041f\\u043e \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0442\\u044b \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u0438 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u044b\\u0439 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a. \\u041f\\u043e\\u044f\\u0432\\u043b\\u044f\\u044e\\u0442\\u0441\\u044f \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b\\u0435 \\u0441\\u0432\\u044f\\u0437\\u043a\\u0438. \\u0412\\u0435\\u0434\\u044c \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0441\\u0435\\u0431\\u044f \\u043f\\u043e\\u043f\\u0440\\u043e\\u0431\\u043e\\u0432\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a \\u0432 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u043e\\u043c \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0438, \\u0442\\u0430\\u043a \\u0438 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u044f\\u044e\\u0449\\u0438\\u043c. \\u041f\\u043e \\u043d\\u0430\\u0448\\u0435\\u043c\\u0443 \\u043c\\u043d\\u0435\\u043d\\u0438\\u044e, \\u043e\\u0441\\u043e\\u0431\\u044b\\u0439 \\u0443\\u043f\\u043e\\u0440 \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u043d\\u0430 \\u0433\\u0443\\u043c\\u0430\\u043d\\u0438\\u0442\\u0430\\u0440\\u043d\\u044b\\u0435 \\u043d\\u0430\\u0443\\u043a\\u0438. \\u041d\\u0438\\u043a\\u043e\\u0433\\u0434\\u0430 \\u043d\\u0435 \\u0441\\u0442\\u043e\\u0438\\u0442 \\u043f\\u0440\\u0435\\u043d\\u0435\\u0431\\u0440\\u0435\\u0433\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u0438\\u043c\\u0438 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u0430\\u043c\\u0438, \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u043e\\u043d\\u0438 \\u0441\\u0442\\u0430\\u043d\\u0443\\u0442 \\u0442\\u0435\\u043c, \\u0441 \\u0447\\u0435\\u043c \\u0442\\u044b \\u0437\\u0430\\u0445\\u043e\\u0447\\u0435\\u0448\\u044c \\u0441\\u0432\\u044f\\u0437\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u044e \\u0436\\u0438\\u0437\\u043d\\u044c. \\u041d\\u0430\\u043f\\u0440\\u0438\\u043c\\u0435\\u0440 : \\u0412\\u044f\\u0447\\u0435\\u0441\\u043b\\u0430\\u0432 \\u041b\\u0435\\u043e\\u043d\\u0442\\u044c\\u0435\\u0432 (\\u0411\\u0443\\u0441\\u0442\\u0435\\u0440), \\u0441\\u0432\\u043e\\u0451 \\u0445\\u043e\\u0431\\u0431\\u0438 \\u043e\\u043d \\u043f\\u0440\\u0435\\u0432\\u0440\\u0430\\u0442\\u0438\\u043b \\u0432 \\u043e\\u0441\\u043d\\u043e\\u0432\\u043d\\u043e\\u0439 \\u0432\\u0438\\u0434 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438.<\\/p>\\n<p><br \\/><span style=\\"color: #2761a0;\\"><strong>\\u0422\\u0438\\u043f \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438. <\\/strong><\\/span>\\u0422\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043b\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u044d\\u043a\\u0441\\u0442\\u0440\\u0430\\u0432\\u0435\\u0440\\u0442, \\u0447\\u0435\\u043c \\u0438\\u043d\\u0442\\u0440\\u043e\\u0432\\u0435\\u0440\\u0442. \\u0422\\u044b \\u0440\\