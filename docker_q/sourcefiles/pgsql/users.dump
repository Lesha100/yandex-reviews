3b\\u0438 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c \\u0443\\u0441\\u0438\\u043b\\u0438\\u044f \\u0438 \\u0437\\u0430\\u043d\\u044f\\u0442\\u044c\\u0441\\u044f \\u0441\\u0432\\u043e\\u0438\\u043c \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u0435\\u043c, \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0434\\u043e\\u0441\\u0442\\u0438\\u0447\\u044c \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435\\u0433\\u043e. \\u0412\\u0441\\u0435 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0437\\u0430\\u0432\\u0438\\u0441\\u0435\\u0442\\u044c \\u043e\\u0442 \\u0442\\u0435\\u0431\\u044f, \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u0439 \\u043e \\u0441\\u0432\\u043e\\u0438\\u0445 \\u0446\\u0435\\u043b\\u044f\\u0445. \\u0427\\u0435\\u0433\\u043e \\u0431\\u044b \\u0442\\u044b \\u0445\\u043e\\u0442\\u0435\\u043b \\u0432 \\u0436\\u0438\\u0437\\u043d\\u0438? \\u0427\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u043e? \\u0427\\u0442\\u043e \\u0442\\u0435\\u0431\\u044f \\u043f\\u0440\\u0438\\u0432\\u043b\\u0435\\u043a\\u0430\\u0435\\u0442 \\u0438 \\u043d\\u0430\\u043e\\u0431\\u043e\\u0440\\u043e\\u0442, \\u0447\\u0442\\u043e &ndash; \\u0432\\u043e\\u0442 \\u0432\\u043e\\u043e\\u0431\\u0449\\u0435 \\u043d\\u0435 \\u0442\\u0432\\u043e\\u0435. \\u0415\\u0441\\u0442\\u044c \\u043b\\u0438 \\u043b\\u044e\\u0434\\u0438, \\u043d\\u0430 \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0445 \\u0442\\u044b \\u0431\\u044b \\u0445\\u043e\\u0442\\u0435\\u043b \\u0431\\u044b\\u0442\\u044c \\u043f\\u043e\\u0445\\u043e\\u0436\\u0438\\u043c? \\u0427\\u0442\\u043e \\u0432 \\u043d\\u0438\\u0445 \\u0442\\u0435\\u0431\\u0435 \\u0438\\u043c\\u043f\\u043e\\u043d\\u0438\\u0440\\u0443\\u0435\\u0442, \\u043a\\u0430\\u043a\\u0438\\u0435 \\u043e\\u043d\\u0438? \\u0415\\u0441\\u043b\\u0438 \\u0441\\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442\\u0438\\u0442\\u044c \\u043d\\u0430 \\u0432\\u043e\\u043f\\u0440