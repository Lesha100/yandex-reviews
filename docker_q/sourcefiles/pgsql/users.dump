\\u0440\\u043e\\u0442 - \\u0441\\u043c\\u043e\\u0442\\u0440\\u044f \\u0447\\u0442\\u043e \\u0432\\u0430\\u043c \\u0438\\u0437 \\u044d\\u0442\\u0438\\u0445 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0439 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0438\\u043b\\u0438 \\u043d\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f.<br \\/><br \\/><span style=\\"color: #f3705c;\\"><strong>\\u041f\\u043b\\u044e\\u0441\\u044b<\\/strong><\\/span><\\/p>\\n<p><strong>\\u0422\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e.<\\/strong><\\/p>\\n<p>\\u0410\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440 - \\u044d\\u0442\\u043e \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442, \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u0435 \\u0432 \\u044d\\u0442\\u043e\\u043c \\u043f\\u0440\\u043e\\u0444\\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0438 \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0438\\u0442 \\u043f\\u0440\\u043e\\u0436\\u0438\\u0442\\u044c \\u044f\\u0440\\u043a\\u0443\\u044e \\u0436\\u0438\\u0437\\u043d\\u044c, \\u043f\\u043e\\u043b\\u043d\\u0443\\u044e \\u0432\\u043f\\u0435\\u0447\\u0430\\u0442\\u043b\\u0435\\u043d\\u0438\\u0439 \\u0438 \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u044f \\u0441 \\u0442\\u0430\\u043b\\u0430\\u043d\\u0442\\u043b\\u0438\\u0432\\u044b\\u043c\\u0438 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438. \\u0412\\u0430\\u043c \\u043d\\u0438\\u043a\\u043e\\u0433\\u0434\\u0430 \\u043d\\u0435 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0441\\u043a\\u0443\\u0447\\u043d\\u043e \\u043d\\u0430 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0435.&nbsp;<\\/p>\\n<p><strong>\\u0412\\u044b \\u0441\\u0442\\u0440\\u043e\\u0438\\u0442\\u0435 \\u0432\\u0435\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c.<\\/strong><\\/p>\\n<p>\\u0410\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440, \\u043d\\u0430\\u0440\\u044f\\u0434\\u0443 \\u0441 \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c\\u0438 \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u0430\\u0432\\u0438\\u0442\\u0435\\u043b\\u044f\\u043c\\u0438 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0438\\u0445 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439, \\u0441\\u043e\\u0437\\u0434\\u0430\\u0435\\u0442 \\u0432\\u043d\\u0435\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u044b\\u0435 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u044f \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u0430. \\u0410 \\u0432 \\u0434\\u043e\\u043b\\u0433\\u043e\\u0432\\u0435\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u0430 \\u0441 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043e\\u0439 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0442\\u044f\\u0433\\u0430\\u0442\\u044c\\u0441\\u044f \\u0440\\u0430\\u0437\\u0432\\u0435 \\u0447\\u0442\\u043e \\u0441\\u043a\\u0443\\u043b\\u044c\\u043f\\u0442\\u0443\\u0440\\u0430. \\u0411\\u044b\\u0442\\u044c \\u0432\\u043e\\u0441\\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u043c \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440\\u043e\\u043c - \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u043e\\u0441\\u0442\\u0430\\u0442\\u044c\\u0441\\u044f \\u0432 \\u043f\\u0430\\u043c\\u044f\\u0442\\u0438 \\u043f\\u043e\\u0442\\u043e\\u043c\\u043a\\u043e\\u0432.<\\/p>\\n<p><strong>\\u0412\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c \\u0432 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u0441\\u0442\\u0440\\u0430\\u043d\\u0430\\u0445.<\\/strong><\\/p>\\n<p>\\u0410\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u04