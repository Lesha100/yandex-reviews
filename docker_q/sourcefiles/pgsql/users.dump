\u0440\\u0442\\u0438\\u0441\\u0442\\u0438\\u0437\\u043c. \\u0410\\u0440\\u0442\\u0438\\u0441\\u0442\\u0438\\u0437\\u043c \\u0432 \\u043d\\u0435\\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0441\\u0442\\u0435\\u043f\\u0435\\u043d\\u0438 \\u043f\\u0440\\u043e\\u0442\\u0438\\u0432\\u043e\\u0440\\u0435\\u0447\\u0438\\u0442 \\u043d\\u0438\\u0437\\u043a\\u043e\\u0439 \\u0441\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 - \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u0434\\u0443\\u043c\\u0430\\u044f \\u043e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044f\\u0445 \\u044d\\u0442\\u043e\\u0433\\u043e \\u0431\\u043b\\u043e\\u043a\\u0430, \\u043f\\u043e\\u043c\\u043d\\u0438, \\u0447\\u0442\\u043e \\u0430\\u0440\\u0442\\u0438\\u0441\\u0442\\u0443 (\\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043d\\u0442\\u0443, \\u0445\\u0443\\u0434\\u043e\\u0436\\u043d\\u0438\\u043a\\u0443) \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u043d\\u0443\\u0436\\u0435\\u043d \\u0437\\u0440\\u0438\\u0442\\u0435\\u043b\\u044c.&nbsp;<\\/span><\\/span><\\/span><\\/p>\\n<p><span style=\\"color: #7ba5d8;\\"><strong>\\u0422\\u0438\\u043f \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f.&nbsp;<\\/strong><span style=\\"color: #000000;\\">\\u041f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0438\\u043c, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0443\\u0432\\u043b\\u0435\\u043a\\u0430\\u0435\\u0448\\u044c\\u0441\\u044f \\u043a\\u043e\\u043c\\u043f\\u044c\\u044e\\u0442\\u0435\\u0440\\u043d\\u044b\\u043c\\u0438 \\u0438\\u0433\\u0440\\u0430\\u043c\\u0438 \\u0438\\u043b\\u0438 IT-\\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u044f\\u043c\\u0438, \\u0432\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u0447\\u0438\\u0442\\u0430\\u0442\\u044c (\\u043d\\u0435 \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u0443\\u044e \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u0443, \\u0430 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e - \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u0447\\u0438\\u0442\\u0430\\u0442\\u044c).&nbsp;<\\/span><\\/span><\\/p>\\n<p><span style=\\"color: #7ba5d8;\\"><span style=\\"color: #000000;\\"><span style=\\"color: #fabd21;\\"><strong>\\u041c\\u044b \\u043f\\u043e\\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u0435\\u043c \\u0442\\u0435\\u0431\\u0435 \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u0442\\u044c \\u043e \\u043a\\u0430\\u0440\\u044c\\u0435\\u0440\\u0435 \\u0432 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u043e\\u0439\\/\\u043d\\u0430\\u0443\\u0447\\u043d\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438.&nbsp;<\\/strong><span style=\\"color: #000000;\\">\\u0420\\u0435\\u0447\\u044c \\u0438\\u0434\\u0435\\u0442 \\u0438\\u043c\\u0435\\u043d\\u043d\\u043e \\u043e \\u043f\\u0440\\u043e\\u0431\\u0435 \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438.&nbsp; \\u041c\\u044b \\u0431\\u044b \\u0434\\u0430\\u0436\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0438\\u043b\\u0438, \\u0447\\u0442\\u043e \\u0442\\u0432\\u043e\\u0439 \\u0444\\u0430\\u0432\\u043e\\u0440\\u0438\\u0442 \\u0441\\u0440\\u0435\\u0434\\u0438 \\u0448\\u043a\\u043e\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0434\\u0438\\u0441\\u0446\\u0438\\u043f\\u043b\\u0438\\u043d \\u0441\\u0435\\u0439\\u0447\\u0430\\u0441 - \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0430, \\u043b\\u0438\\u0431\\u043e \\u0444\\u0438\\u0437\\u0438\\u043a\\u0430. \\u042d\\u0442\\u043e \\u043d\\u0435 \\u0441\\u0430\\u043c\\u044b\\u0439 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0439 \\u043e\\u0442\\u0432\\u0435\\u0442 \\u043d\\u0430 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441 \\u043e \\u0432\\u044b\\u0431\\u043e\\u0440\\u0435 \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u0433\\u043e, \\u043d\\u043e \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0430 \\u0441\\u043b\\u0438\\u0448\\u043a\\u043e\\u043c \\u0448\\u0438\\u0440\\u043e\\u043a\\u0430\\u044f \\u0441\\u0444\\u0435\\u0440\\u0430: \\u0441\\u044e\\u0434\\u0430 \\u0432\\u0445\\u043e\\u0434\\u0438\\u0442 \\u0438 \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0441\\u043e \\u0441\\u0432\\u043e\\u0438\\u043c\\u0438 \\u044f\\u0437\\u044b\\u043a\\u0430\\u043c\\u0438, \\u0438 \\u0444\\u0443\\u043d\\u0434\\u0430\\u043c\\u0435\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0430. \\u041f\\u0440\\u044f\\u043c\\u0430\\u044f \\u0441\\u0432\\u044f\\u0437\\u043a\\u0430 \\u0437\\u0434\\u0435\\u0441\\u044c \\u0442\\u0430\\u043a\\u0430\\u044f: \\u0441\\u0443\\u0434\\u044f \\u043f\\u043e \\u0442\\u0435\\u0441\\u0442\\u0430\\u043c - \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0435 \\u043e\\u0447\\u0435\\u043d\\u044c \\u0432\\u0430\\u0436\\u043d\\u043e \\u0432\\u0438\\u0434\\u0435\\u0442\\u044c \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u0441\\u0432\\u043e\\u0438\\u0445 \\u0442\\u0440\\u0443\\u0434\\u043e\\u0432, \\u0442\\u043e \\u0435\\u0441\\u0442\\u044c \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441, \\u0432\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0432\\u0430\\u0436\\u043d\\u0435\\u0435 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0430. \\u041d\\u043e \\u043f\\u0440\\u0438 \\u044d\\u0442\\u043e\\u043c \\u0442\\u044b \\u0433\\u043b\\u0443\\u0431\\u043e\\u043a\\u043e \\u0440\\u0435\\u0444\\u043b\\u0435\\u043a\\u0441\\u0438\\u0432\\u0435\\u043d, \\u0430\\u043d\\u0430\\u043b\\u0438\\u0437\\u0438\\u0440\\u0443\\u0435\\u0448\\u044c \\u043f\\u0440\\u043e\\u0438\\u0441\\u0445\\u043e\\u0434\\u044f\\u0449\\u0435\\u0435 \\u0432\\u043e\\u043a\\u0440\\u0443\\u0433, \\u043f\\u043e\\u0433\\u0440\\u0443\\u0436\\u0435\\u043d \\u0432 \\u0441\\u0435\\u0431\\u044f \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u043c\\u043d\\u043e\\u0433\\u0438\\u0445 \\u0441\\u0432\\u0435\\u0440\\u0441\\u0442\\u043d\\u0438\\u043a\\u043e\\u0432, \\u0447\\u0442\\u043e \\u043e\\u043f\\u044f\\u0442\\u044c \\u0436\\u0435 \\u0434\\u0430\\u0435\\u0442 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438 \\u0438 \\u043c\\u0435\\u0441\\u0442\\u043e \\u043d\\u0430 \\u0442\\u043e, \\u0447\\u0442\\u043e\\u0431\\u044b \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u0442\\u044c \\u043e \\u0441\\u0435\\u0431\\u0435\\/\\u043c\\u0438\\u0440\\u0435\\/\\u0447\\u0442\\u043e\\u0442\\u0430\\u043c\\u0435\\u0449\\u0451 =)&nbsp;<\\/span><\\/span><\\/span><\\/span><\\/p>\\n<p><span style=\\"color: #7ba5d8;\\"><span style=\\"color: #000000;\\"><span style=\\"color: #fabd21;\\"><span style=\\"color: #000000;\\">\\u041e\\u0442\\u043c\\u0435\\u0442\\u0438\\u043c, \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0433\\u043b\\u0430\\u0432\\u043d\\u043e\\u0435 - \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043f\\u0440\\u043e\\u043a\\u0440\\u0430\\u0441\\u0442\\u0438\\u043d\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c \\u043e\\u0447\\u0435\\u043d\\u044c \\u0434\\u043e\\u043b\\u0433\\u043e. \\u0421\\u0430\\u043c\\u043e\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u0435\\u0439\\u0447\\u0430\\u0441 \\u043f\\u043e\\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u0441\\u043e \\u0432\\u0437\\u0440\\u043e\\u0441\\u043b\\u044b\\u043c\\u0438 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u043c \\u0442\\u044b \\u0434\\u043e\\u0432\\u0435\\u0440\\u044f\\u0