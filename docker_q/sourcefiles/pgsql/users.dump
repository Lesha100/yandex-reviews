16094	8	admin/users/report/edit/225/resume	POST	77.238.236.109	{"resume":"<div>\\u0422\\u044b &ndash; \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u043a, \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a \\u0434\\u0435\\u043b\\u0430, \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u044b\\u0439 \\u0438\\u043c\\u0435\\u0442\\u044c \\u0434\\u0435\\u043b\\u043e \\u0441 \\u0432\\u0435\\u0449\\u0430\\u043c\\u0438, \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u0430\\u043c\\u0438, \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u043e\\u0439. \\u0421\\u043a\\u043e\\u0440\\u0435\\u0435 \\u0442\\u0435\\u0431\\u0435 \\u043f\\u043e\\u0434\\u043e\\u0448\\u043b\\u0430 \\u0431\\u044b \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430, \\u043f\\u0440\\u0438\\u043d\\u043e\\u0441\\u044f\\u0449\\u0430\\u044f &nbsp;\\u043e\\u0449\\u0443\\u0442\\u0438\\u043c\\u044b\\u0435 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0435 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b. \\u0422\\u044b \\u043e\\u0445\\u043e\\u0442\\u043d\\u0435\\u0435 \\u0434\\u0435\\u043b\\u0430\\u0435\\u0448\\u044c, \\u0447\\u0435\\u043c \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0448\\u044c. \\u041f\\u043e\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u0443 \\u0442\\u0435\\u0431\\u0435 \\u0431\\u043b\\u0438\\u0436\\u0435 \\u0444\\u0438\\u0437\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u0442\\u0440\\u0443\\u0434, \\u043e\\u0431\\u0440\\u0430\\u0442\\u0438 \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443 \\u0441 \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u043e\\u0439, \\u0433\\u0434\\u0435 \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442\\u0441\\u044f \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u0441\\u043a\\u043b\\u0430\\u0434 \\u0443\\u043c\\u0430 \\u0438 \\u0445\\u043e\\u0440\\u043e\\u0448\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u044b\\u0435 \\u0434\\u0432\\u0438\\u0433\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043d\\u0430\\u0432\\u044b\\u043a\\u0438. \\u0422\\u0430\\u043a\\u0438\\u0435 \\u043b\\u044e\\u0434\\u0438, \\u043a\\u0430\\u043a \\u0442\\u044b, \\u043b\\u0443\\u0447\\u0448\\u0435 \\u0443\\u0441\\u0432\\u0430\\u0438\\u0432\\u0430\\u044e\\u0442 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044e \\u043d\\u0435 \\u0447\\u0435\\u0440\\u0435\\u0437 \\u043b\\u0435\\u043a\\u0446\\u0438\\u0438 \\u0438\\u043b\\u0438 \\u043f\\u0440\\u0438 \\u043f\\u043e\\u043c\\u043e\\u0449\\u0438 \\u0447\\u0442\\u0435\\u043d\\u0438\\u044f, \\u0430 \\u0447\\u0435\\u0440\\u0435\\u0437 \\u0434\\u0432\\u0438\\u0436\\u0435\\u043d\\u0438\\u0435. \\u0418\\u043c\\u0435\\u043d\\u043d\\u043e \\u0438\\u0445 \\u0440\\u0443\\u043a\\u0430\\u043c\\u0438 \\u0441\\u043e\\u0437\\u0434\\u0430\\u043d \\u043e\\u043a\\u0440\\u0443\\u0436\\u0430\\u044e\\u0449\\u0438\\u0439 \\u043d\\u0430\\u0441 \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u044b\\u0439 \\u043c\\u0438\\u0440. \\u041e\\u043d\\u0438 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u044f\\u044e\\u0442 \\u043c\\u0430\\u0448\\u0438\\u043d\\u0430\\u043c\\u0438, \\u0441\\u043e\\u0431\\u0438\\u0440\\u0430\\u044e\\u0442 \\u043a\\u043e\\u043c\\u043f\\u044c\\u044e\\u0442\\u0435\\u0440\\u044b, \\u0441\\u0442\\u0440\\u043e\\u044f\\u0442 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043d\\u044b\\u0435 \\u0441\\u043e\\u043e\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f, \\u0431\\u0435\\u0437 \\u043d\\u0438\\u0445 \\u043d\\u0435\\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u043d\\u0438 \\u043e\\u0434\\u043d\\u0443 \\u0441\\u0430\\u043c\\u0443\\u044e \\u0431\\u043b\\u0435\\u0441\\u0442\\u044f\\u0449\\u0443\\u044e \\u0438\\u0434\\u0435\\u044e.<\\/div>\\n<div>\\u0414\\u043b\\u044f \\u044d\\u0442\\u043e\\u0433\\u043e \\u0442\\u0438\\u043f\\u0430 \\u043b\\u044e\\u0434\\u0435\\u0439 \\u043f\\u043e\\u0434\\u043e\\u0448\\u043b\\u0438 \\u0431\\u044b \\u0441\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438: \\u0441\\u043f\\u043e\\u0440\\u0442, \\u0440\\u0435\\u0441\\u0442\\u0430\\u0432\\u0440\\u0430\\u0446\\u0438\\u044f \\u0441\\u0442\\u0430\\u0440\\u044b\\u0445 \\u043c\\u0435\\u0445\\u0430\\u043d\\u0438\\u0437\\u043c\\u043e\\u0432, \\u0440\\u0435\\u043c\\u043e\\u043d\\u0442, \\u043a\\u043e\\u043d\\u0441\\u0442\\u0440\\u0443\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435, \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u0445 \\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432, \\u0441\\u0442\\u0440\\u043e\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0438 \\u0432\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b, \\u0444\\u0435\\u0440\\u043c\\u0435\\u0440\\u0441\\u0442\\u0432\\u043e.<\\/div>"}	2021-02-01 15:31:50	2021-02-01 15:31:50
