15551	8	admin/users/report/edit/176/extra	POST	77.238.236.109	{"extra":"<h2><span style=\\"color: #2761a0;\\"><strong>\\u041f\\u043e\\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u044f \\u0434\\u043b\\u044f&nbsp; \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u0433\\u043e \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442\\u0430!<\\/strong><\\/span><\\/h2>\\n<p>&nbsp;<\\/p>\\n<p>1. \\u0412 \\u0441\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e\\u043c \\u043c\\u0438\\u0440\\u0435 \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442 \\u043e\\u043a\\u043e\\u043b\\u043e 40 000 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439. \\u0417\\u043d\\u0430\\u0442\\u044c \\u043e \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0430\\u043d\\u0438\\u0438 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u0438\\u0437 \\u043d\\u0438\\u0445 \\u043d\\u0435 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043d\\u0438\\u043a\\u0442\\u043e. \\u0422\\u0435\\u043c \\u0431\\u043e\\u043b\\u0435\\u0435, \\u0447\\u0442\\u043e \\u0448\\u043a\\u043e\\u043b\\u0430 \\u0434\\u0430\\u0435\\u0442 \\u0432\\u0430\\u043c \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u043b\\u0438\\u0448\\u044c \\u043e +- 16\\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u044b\\u0445 \\u0434\\u0438\\u0441\\u0446\\u0438\\u043f\\u043b\\u0438\\u043d\\u0430\\u0445. \\u041f\\u0440\\u043e\\u0431\\u043b\\u0435\\u043c\\u0430 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430 \\u0441\\u0432\\u043e\\u0439\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u0430 \\u043f\\u043e\\u0434\\u0430\\u0432\\u043b\\u044f\\u044e\\u0449\\u0435\\u043c\\u0443 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0438\\u043d\\u0441\\u0442\\u0432\\u0443 \\u0432\\u0430\\u0448\\u0438\\u0445 \\u0441\\u0432\\u0435\\u0440\\u0441\\u0442\\u043d\\u0438\\u043a\\u043e\\u0432. \\u0418, \\u0434\\u0430 - \\u0445\\u043e\\u0440\\u043e\\u0448\\u0438\\u0435 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438 \\u043f\\u043e \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e\\u0439 \\u0434\\u0438\\u0441\\u0446\\u0438\\u043f\\u043b\\u0438\\u043d\\u0435 \\u043d\\u0435 \\u0440\\u0430\\u0432\\u043d\\u044b \\u0432\\u044b\\u0441\\u043e\\u043a\\u043e\\u043c\\u0443 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u0438\\u0437\\u043c\\u0443 \\u0438 \\u0434\\u0430\\u0436\\u0435 \\u043d\\u0435 \\u044f\\u0432\\u043b\\u044f\\u044e\\u0442\\u0441\\u044f \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435\\u043c \\u0434\\u043b\\u044f \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438.<\\/p>\\n<p>2. \\u0422\\u0432\\u043e\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043e\\u0442\\u043b\\u0438\\u0447\\u0430\\u0442\\u044c\\u0441\\u044f \\u043e\\u0442 \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u0435\\u043c\\u043e\\u0433\\u043e \\u043d\\u0430\\u043c\\u0438, \\u043f\\u043e\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u0443 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u0435\\u0441\\u0442\\u044c \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c &laquo;\\u043f\\u0440\\u043e\\u043a\\u0430\\u0447\\u0430\\u0442\\u044c&raquo; \\u043d\\u0430\\u0432\\u044b\\u043a\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u043d\\u0430 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043c\\u043e\\u043c\\u0435\\u043d\\u0442 \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u044b \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e. \\u0422\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0440\\u0430\\u0441\\u0441\\u043c\\u0430\\u0442\\u0440\\u0438\\u0432\\u0430\\u0442\\u044c \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043f\\u0440\\u043e\\u0444\\u04