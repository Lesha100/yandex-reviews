\u044c\\u0435\\u0440\\u0430, \\u0441\\u043e\\u0437\\u0434\\u0430\\u044e\\u0449\\u0438\\u0439 \\u043f\\u043b\\u0430\\u043d\\u0438\\u0440\\u043e\\u0432\\u043a\\u0443, \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e\\u0435 \\u043d\\u0430\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u0434\\u0435\\u043a\\u043e\\u0440\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0435 \\u043e\\u0444\\u043e\\u0440\\u043c\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0432\\u043d\\u0443\\u0442\\u0440\\u0435\\u043d\\u043d\\u0438\\u0445 \\u043f\\u043e\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0439.<br \\/>&bull;&nbsp;<strong>\\u041b\\u0430\\u043d\\u0434\\u0448\\u0430\\u0444\\u0442\\u043d\\u044b\\u0439 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440<\\/strong>&nbsp;\\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u0430\\u0442\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f \\u043f\\u043e \\u043e\\u0437\\u0435\\u043b\\u0435\\u043d\\u0435\\u043d\\u0438\\u044e \\u0438 \\u0431\\u043b\\u0430\\u0433\\u043e\\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432\\u0443 \\u0442\\u0435\\u0440\\u0440\\u0438\\u0442\\u043e\\u0440\\u0438\\u0439, \\u0441\\u043e\\u0437\\u0434\\u0430\\u0435\\u0442 \\u043c\\u0430\\u043b\\u044b\\u0435 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043d\\u044b\\u0435 \\u0444\\u043e\\u0440\\u043c\\u044b (\\u0431\\u0435\\u0441\\u0435\\u0434\\u043a\\u0438, \\u0441\\u043a\\u0430\\u043c\\u0435\\u0439\\u043a\\u0438, \\u0444\\u043e\\u043d\\u0430\\u0440\\u0438).<br \\/>&bull;&nbsp;<strong>\\u041f\\u0440\\u043e\\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440<\\/strong>&nbsp;\\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0437\\u0438\\u0440\\u0443\\u0435\\u0442\\u0441\\u044f \\u043d\\u0430 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438