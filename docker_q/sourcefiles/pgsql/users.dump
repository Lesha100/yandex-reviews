\\u0436\\u0435\\u0441\\u0442\\u043e\\u0432\\u044b\\u0435 \\u044f\\u0437\\u044b\\u043a\\u0438. \\u041b\\u044e\\u0434\\u0435\\u0439 \\u0438\\u0437 \\u0441\\u0442\\u043e\\u043b\\u044c \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u0441\\u0444\\u0435\\u0440 \\u043e\\u0431\\u044a\\u0435\\u0434\\u0438\\u043d\\u044f\\u0435\\u0442 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u043d\\u043e\\u043c\\u0443 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044e, \\u0430 \\u044d\\u0442\\u043e \\u043d\\u0430\\u0432\\u044b\\u043a, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0443\\u0436\\u0434\\u0430\\u0435\\u0442\\u0441\\u044f \\u0432 \\u043f\\u043e\\u0441\\u0442\\u043e\\u044f\\u043d\\u043d\\u043e\\u0439 \\u0442\\u0440\\u0435\\u043d\\u0438\\u0440\\u043e\\u0432\\u043a\\u0435. \\u0425\\u043e\\u0440\\u043e\\u0448\\u0430\\u044f \\u043d\\u043e\\u0432\\u043e\\u0441\\u0442\\u044c \\u0432 \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0432\\u0441\\u0435 \\u0437\\u043d\\u0430\\u043a\\u043e\\u0432\\u044b\\u0435 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u044b \\u0438\\u043c\\u0435\\u044e\\u0442 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u043e\\u0431\\u0449\\u0435\\u0433\\u043e, \\u0447\\u0435\\u043c \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u044c\\u0441\\u044f \\u043d\\u0430 \\u043f\\u0435\\u0440\\u0432\\u044b\\u0439 \\u0432\\u0437\\u0433\\u043b\\u044f\\u0434, \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u043f\\u0435\\u0440\\u0435\\u0434\\u043e\\u0432\\u044b\\u0435 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432 \\u044d\\u0442\\u043e\\u0439 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438 \\u043b\\u0435\\u0436\\u0430\\u0442 \\u043d\\u0430 \\u043f\\u0435\\u0440\\u0435\\u0441\\u0435\\u0447\\u0435\\u043d\\u0438\\u0438 \\u0434\\u0438\\u0441\\u0446\\u0438\\u043f\\u043b\\u0438\\u043d. \\u0410 \\u04