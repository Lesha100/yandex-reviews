\u043d\\u0441\\u0442\\u0432\\u043e \\u043c\\u043e\\u043b\\u043e\\u0434\\u044b\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439 \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u044e\\u0442 \\u0438\\u043c\\u0435\\u043d\\u043d\\u043e \\u043d\\u0430 \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0438 \\u0448\\u043a\\u043e\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0443\\u0441\\u043f\\u0435\\u0432\\u0430\\u0435\\u043c\\u043e\\u0441\\u0442\\u0438.&nbsp;<\\/p>\\n<p>\\u0412\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u043b\\u043e\\u0436\\u043d\\u044b\\u0439, \\u043d\\u043e \\u043f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b\\u0439 - \\u0438\\u0434\\u0438 \\u043e\\u0442 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0438 \\u043e\\u0442 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f. \\u0415\\u0441\\u043b\\u0438 \\u0442\\u044b \\u0445\\u043e\\u0447\\u0435\\u0448\\u044c \\u0441\\u0442\\u0430\\u0442\\u044c \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u043e\\u043c, \\u043d\\u043e \\u043f\\u0440\\u0438 \\u044d\\u0442\\u043e\\u043c \\u043f\\u043e \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0435 \\u0443 \\u0442\\u0435\\u0431\\u044f \\"\\u0442\\u0432\\u0435\\u0440\\u0434\\u0430\\u044f \\u0434\\u0432\\u043e\\u0439\\u043a\\u0430\\" \\u0432 \\u0447\\u0435\\u0442\\u0432\\u0435\\u0440\\u0442\\u0438, \\u0442\\u043e \\u0432\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e \\u0442\\u0435\\u0431\\u0435 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442\\u0441\\u044f \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0443\\u0441\\u0438\\u043b\\u0438\\u0439. \\u041d\\u043e \\u0443\\u0441\\u0438\\u043b\\u0438\\u044f \\u043f\\u0440\\u0438\\u043a\\u043b\\u0430\\u0434\\u044b\\u0432\\u0430\\u0442\\u044c \\u043b\\u0435\\u0433\\u0447\\u0435, \\u0435\\u0441\\u043b\\u0438 \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0434\\u0435\\u043b\\u0430\\u0435\\u0448\\u044c? \\u0412\\u0435\\u0440\\u043d\\u043e?&nbsp;<\\/p>\\n<p>\\u0412 \\u043b\\u044e\\u0431\\u043e\\u043c \\u0441\\u043b\\u0443\\u0447\\u0430\\u0435 - \\u0435\\u0441\\u043b\\u0438 \\u0442\\u044b \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0435\\u0448\\u044c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e, \\u0441\\u0430\\u043c\\u043e\\u0435 \\u043f\\u0435\\u0440\\u0432\\u043e\\u0435, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0443\\u0436\\u043d\\u043e \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c - \\u043f\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439 \\u0441\\u0442\\u0430\\u0442\\u044c\\u0438 \\u043e \\u0442\\u043e\\u043c, \\u0430 \\u0447\\u0435\\u043c \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442\\u0441\\u044f \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442 \\u0432 \\u044d\\u0442\\u043e\\u0439 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438. \\u042d\\u0442\\u043e \\u043c\\u043e\\u0433\\u0443\\u0442 \\u0431\\u044b\\u0442\\u044c \\u043d\\u0435\\u0431\\u043e\\u043b\\u044c\\u0448\\u0438\\u0435 \\u0442\\u0435\\u043a\\u0441\\u0442\\u044b.\\u0427\\u0442\\u043e \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442 \\u043a\\u043e\\u043d\\u0434\\u0438\\u0442\\u0435\\u0440? \\u041a\\u0430\\u043a\\u043e\\u0439 \\u0435\\u0433\\u043e \\u0440\\u0430\\u0431\\u043e\\u0447\\u0438\\u0439 \\u0434\\u0435\\u043d\\u044c? \\u041f\\u043e\\u0447\\u0435\\u043c\\u0443 \\u044d\\u0442\\u043e \\u0442\\u044f\\u0436\\u0435\\u043b\\u044b\\u0439 \\u0442\\u0440\\u0443\\u0434?&nbsp;<\\/p>\\n<p>\\u042f \\u043d\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043b\\u0430\\u0433\\u0430\\u044e \\u0442\\u0435\\u0431\\u0435 \\u0447\\u0438\\u0442\\u0430\\u0442\\u044c \\u0432\\u0441\\u0451 \\u0438 \\u043e\\u0431\\u043e \\u0432\\u0441\\u0451\\u043c. \\u042d\\u0442\\u043e \\u043d\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\"\\u0440\\u0430\\u0441\\u043f\\u044b\\u043b\\u044f\\u0442\\u044c\\u0441\\u044f\\". \\u041d\\u043e, \\u0435\\u0441\\u043b\\u0438 \\u0442\\u044b \\u043e\\u0431\\u043e\\u0437\\u043d\\u0430\\u0447\\u0438\\u043b\\u0430 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e \\u041a\\u043e\\u043d\\u0434\\u0438\\u0442\\u0435\\u0440, \\u0442\\u043e \\u043f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0442\\u044c \\u043f\\u0440\\u043e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e - \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u044c. \\u041b\\u044e\\u0431\\u0430\\u044f \\u043d\\u043e\\u0432\\u0430\\u044f \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044f \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043c\\u0435\\u043d\\u044f\\u0442\\u044c \\u0442\\u0432\\u043e\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0432 \\u0442\\u0443 \\u0438\\u043b\\u0438 \\u0438\\u043d\\u0443\\u044e \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0443. \\u0410 \\u0432 \\u0446\\u0435\\u043b\\u043e\\u043c - \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0438\\u0442 \\u0442\\u0435\\u0431\\u0435 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044c \\u0432\\u0435\\u0440\\u043d\\u043e\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435.&nbsp;<\\/p>","name":"\\u041e\\u0301\\u043f\\u0440\\u0430 \\u0413\\u044d\\u0439\\u043b \\u0423\\u0438\\u0301\\u043d\\u0444\\u0440\\u0438","post":"\\u0422\\u0435\\u043b\\u04