\\u0432\\u0438\\u0434\\u043d\\u043e \\u0438 \\u0438\\u0437 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u0432 \\u0442\\u0438\\u043f\\u0430 \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438. <strong>\\u0422\\u044b \\u044d\\u043a\\u0441\\u0442\\u0440\\u0430\\u0432\\u0435\\u0440\\u0442 \\u0441 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u043c \\u0443\\u0440\\u043e\\u0432\\u043d\\u0435\\u043c \\u0441\\u043f\\u043e\\u043d\\u0442\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438.<\\/strong> \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0442\\u044b \\u0438\\u043c\\u043f\\u0443\\u043b\\u044c\\u0441\\u0438\\u0432\\u043d\\u0430, \\u0443\\u043c\\u0435\\u0435\\u0448\\u044c \\u043f\\u043e\\u0441\\u0442\\u043e\\u044f\\u0442\\u044c \\u0437\\u0430 \\u0441\\u0435\\u0431\\u044f \\u0438 \\u0441\\u0432\\u043e\\u0438 \\u043f\\u0440\\u0438\\u043d\\u0446\\u0438\\u043f\\u044b, \\u0430 \\u0437\\u0430\\u043f\\u0440\\u0435\\u0449\\u0435\\u043d\\u043d\\u043e\\u0435 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u043b\\u044e\\u0431\\u043e\\u043f\\u044b\\u0442\\u0441\\u0442\\u0432\\u043e. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u043c\\u043e\\u0436\\u043d\\u043e \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u043e \\u043f\\u0435\\u0440\\u0435\\u043f\\u0430\\u0434\\u0430\\u0445 \\u043d\\u0430\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u0438\\u044f \\u0438 \\u044d\\u043c\\u043e\\u0446\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438.&nbsp;<\\/span><\\/span><\\/p>\\n<p><span style=\\"color: #f3705c;\\"><strong>\\u0422\\u0438\\u043f \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f<\\/strong><\\/span><\\/p>\\n<p><span style=\\"color: #f3705c;\\"><span style=\\"color: #000000;\\">\\u042f \\u043d\\u0435 \\u043e\\u0448\\u0438\\u0431\\u0443\\u0441\\u044c, \\u0435\\u0441\\u043b\\u0438 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0443, <strong>\\u0447\\u0442\\u043e \\u0442\\u044b \\u0432\\u0441\\u0435\\u0439 \\u0434\\u0443\\u0448\\u043e\\u0439 \\u043d\\u0435\\u043f\\u0435\\u0440\\u0435\\u043d\\u043e\\u0441\\u0438\\u0448\\u044c \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0443?<\\/strong> \\u0423 \\u0442\\u0435\\u0431\\u044f \\u043d\\u0435 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0432\\u043e\\u0441\\u0442\\u043e\\u0440\\u0433\\u0430 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0441 \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u043d\\u044b\\u043c\\u0438 \\u043a\\u043e\\u0434\\u0430\\u043c\\u0438, \\u0444\\u0438\\u0437\\u0438\\u043a\\u0430, \\u0445\\u0438\\u043c\\u0438\\u044f \\u0438 \\u0432\\u0441\\u0435 \\u0432\\u043e\\u0442 \\u044d\\u0442\\u0438 \\"\\u043d\\u0435\\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u044b\\u0435\\" \\u0444\\u043e\\u0440\\u043c\\u0443\\u043b\\u044b. \\u041f\\u0440\\u0438 \\u044d\\u0442\\u043e\\u043c\\u0443 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043b\\u0430 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0427\\u0442\\u043e \\u044d\\u0442\\u043e \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442? \\u042d\\u0442\\u043e \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0440\\u0430\\u0437\\u0432\\u0438\\u0432\\u0430\\u0435\\u0448\\u044c \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0430\\u0440\\u0432\\u0438\\u0442\\u0441\\u044f \\u043f\\u0440\\u0438\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u0442\\u044c \\u0438 \\u0441\\u043e\\u0437\\u0434\\u0430\\u0432\\u0430\\u0442\\u044c \\u043d\\u043e\\u0432\\u043e\\u0435. \\u0412 \\u0430\\u043d\\u043a\\u0435\\u0442\\u0435 \\