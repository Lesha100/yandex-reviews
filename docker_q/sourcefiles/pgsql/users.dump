16470	8	admin/users/report/edit/180/comment	POST	77.238.236.109	{"recommendations":"<p>\\u041f\\u0440\\u0438\\u0440\\u043e\\u0434\\u0430 \\u043d\\u0430\\u0433\\u0440\\u0430\\u0434\\u0438\\u043b\\u0430 \\u0442\\u0435\\u0431\\u044f \\u0445\\u043e\\u0440\\u043e\\u0448\\u0438\\u043c\\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u043c\\u0438, \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u043d\\u0443\\u0436\\u043d\\u043e \\u044d\\u0442\\u043e \\u0443\\u0447\\u0438\\u0442\\u044b\\u0432\\u0430\\u0442\\u044c \\u043f\\u0440\\u0438 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0435 \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438. \\u0410\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0444\\u0438\\u0437\\u0438\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u043f\\u043e\\u0434\\u0433\\u043e\\u0442\\u043e\\u0432\\u043a\\u0430, \\u043f\\u043e\\u0442\\u0435\\u043d\\u0446\\u0438\\u0430\\u043b \\u043b\\u0438\\u0434\\u0435\\u0440\\u0441\\u0442\\u0432\\u0430, \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435, \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432 \\u0441\\u0435\\u0431\\u0435 \\u0438 \\u0446\\u0435\\u043b\\u0435\\u0443\\u0441\\u0442\\u0440\\u0435\\u043c\\u043b\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c - \\u044d\\u0442\\u043e \\u0442\\u043e, \\u0447\\u0442\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0438\\u0442 \\u0442\\u0435\\u0431\\u0435 \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u0445\\u043e\\u0440\\u043e\\u0448\\u0443\\u044e \\u043a\\u0430\\u0440\\u044c\\u0435\\u0440\\u0443. \\u0420\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u044e \\u0440\\u0430\\u0441\\u0448\\u0438\\u0440\\u0438\\u0442\\u044c \\u043a\\u0440\\u0443\\u0433\\u043e\\u0437\\u043e\\u0440 \\u0432 \\u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u0438 \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u0435\\u0433\\u043e, \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u0441\\u0442\\u043e\\u0438\\u0442 \\u043e\\u0431\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0441\\u043c\\u043e\\u0433\\u0443\\u0442 \\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u0442\\u044c \\u0442\\u0432\\u043e\\u0438\\u043c \\u0430\\u0431\\u0438\\u0446\\u0438\\u044f\\u043c. \\u041d\\u0430\\u043f\\u0440\\u0438\\u043c\\u0435\\u0440: \\u0444\\u0438\\u043d\\u0430\\u043d\\u0441\\u0438\\u0441\\u0442, \\u0432\\u0440\\u0430\\u0447, \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0441 \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u043e\\u0439 \\u0438 \\u043a\\u043e\\u043c\\u043f\\u044c\\u044e\\u0442\\u0435\\u0440\\u043e\\u043c, \\u0441\\u043f\\u043e\\u0440\\u0442\\u0441\\u043c\\u0435\\u043d, \\u043f\\u0438\\u043b\\u043e\\u0442, \\u0441\\u0442\\u043e\\u043c\\u0430\\u0442\\u043e\\u043b\\u043e\\u0433.&nbsp;<\\/p>\\n<div class=\\"report-full__info\\">\\n<p>\\u0415\\u0441\\u043b\\u0438 \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e \\u0442\\u0432\\u043e\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 - \\u0441\\u0442\\u0430\\u0442\\u044c \\u0433\\u043e\\u0441\\u0443\\u0434\\u0430\\u0440\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u043c \\u0441\\u043b\\u0443\\u0436\\u0430\\u0449\\u0438\\u043c \\u0423\\u0424\\u0421\\u0418\\u041d, \\u0442\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0432\\u0430\\u0442\\u044c \\u0432 \\u043f\\u0435\\u0440\\u0432\\u0443\\u044e \\u043e\\u0447\\u0435\\u0440\\u0435\\u0434\\u044c \\u0441\\u0442\\u0440\\u0435\\u0441\\u0441\\u043e\\u0443\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u044c, \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c \\u0447\\u0435\\u0442\\u043a\\u043e \\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u044c \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u044f\\u043c, \\u043f\\u0440\\u0438\\u043a\\u0430\\u0437\\u0430\\u043c \\u0432\\u044b\\u0448\\u0435\\u0441\\u0442\\u043e\\u044f\\u0449\\u0435\\u0433\\u043e \\u043d\\u0430\\u0447\\u0430\\u043b\\u044c\\u0441\\u0442\\u0432\\u0430. \\u042d\\u0442\\u0430 \\u0441\\u0444\\u0435\\u0440\\u0430 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u043d\\u0435 \\u043b\\u044e\\u0431\\u0438\\u0442 \\u0441\\u043b\\u0443\\u0447\\u0430\\u0439\\u043d\\u044b\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439. \\u041f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u0432\\u0430\\u0436\\u043d\\u043e \\u043e\\u0442\\u0434\\u0430\\u0432\\u0430\\u0442\\u044c \\u0441\\u0435\\u0431\\u0435 \\u043e\\u0442\\u0447\\u0435\\u0442 \\u0432 \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0432 \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0441\\u0444\\u0435\\u0440\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u0430\\u0433\\u0430\\u0435\\u0442\\u0441\\u044f: \\u0433\\u043b\\u0443\\u0431\\u043e\\u043a\\u0430\\u044f \\u043f\\u0441\\u0438\\u0445\\u043e\\u0434\\u0438\\u0430\\u0433\\u043d\\u043e\\u0441\\u0442\\u0438\\u043a\\u0430 \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438, \\u043c\\u043e\\u043d\\u0438\\u0442\\u043e\\u0440\\u0438\\u043d\\u0433 \\u043f\\u043e\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u0438 \\u043d\\u0430\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0438 \\u0432\\u043b\\u0430\\u0441\\u0442\\u043d\\u044b\\u043c\\u0438 \\u043f\\u043e\\u043b\\u043d\\u043e\\u043c\\u043e\\u0447\\u0438\\u044f\\u043c\\u0438. \\u0412 \\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u043e\\u0442 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u0438\\u0434\\u0451\\u0442\\u0441\\u044f \\u0441\\u0434\\u0430\\u0442\\u044c \\u044d\\u043a\\u0437\\u0430\\u043c\\u0435\\u043d\\u044b \\u043f\\u043e \\u043e\\u0431\\u0449\\u0435\\u0441\\u0442\\u0432\\u043e\\u0437\\u043d\\u0430\\u043d\\u0438\\u044e, \\u0438\\u0441\\u0442\\u043e\\u0440\\u0438\\u0438 \\u0420\\u043e\\u0441\\u0441\\u0438\\u0438 \\u0438\\u043b\\u0438 \\u0444\\u0438\\u0437\\u0438\\u043a\\u0435.<\\/p>\\n<p>\\u0420\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u044e \\u043f\\u043e\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u0438\\u0442\\u044c\\u0441\\u044f \\u0441\\u043e \\u0441\\u0442\\u0430\\u0442\\u044c\\u0435\\u0439 \\u043f\\u0440\\u043e \\u0442\\u0432\\u043e\\u044e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e, \\u043f\\u0440\\u043e \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f, \\u043f\\u0440\\u043e \\u043f\\u043b\\u044e\\u0441\\u044b \\u0438 \\u043c\\u0438\\u043d\\u0443\\u0441\\u044b <a href=\\"https:\\/\\/tass.ru\\/obschestvo\\/5412056\\">https:\\/\\/narobraz.ru\\/professii\\/sluzhba-v-ufsin-plyusy-minusy-i-osobennosti.html<\\/a><\\/p>\\n<\\/div>","name":"\\u0413\\u0438 \\u0434\\u0435 \\u041c\\u043e\\u043f\\u0430\\u0441\\u0441\\u0430\\u043d","post":"\\u0424\\u0440\\u0430\\u043d\\u0446\\u0443\\u0437\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0438\\u0441\\u0430\\u0442\\u0435\\u043b\\u044c","comment":"\\u0421\\u0438\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043b\\u044e\\u0434\\u0438, \\u0442\\u0430\\u043a \\u0438\\u043b\\u0438 \\u0438\\u043d\\u0430\\u0447\\u0435, \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u0434\\u043e\\u0431\\u0438\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e."}	2021-02-02 13:08:06	2021-02-02 13:08:06
