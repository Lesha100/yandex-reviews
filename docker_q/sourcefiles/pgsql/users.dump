30723	12	admin/users/report/edit/278/resume	POST	217.21.222.36	{"resume":"<p><span style=\\"font-weight: 400;\\">\\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u044b\\u044f\\u0432\\u0438\\u043b\\u0438 \\u043a\\u0430\\u043a \\u043f\\u0440\\u0435\\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u044e\\u0449\\u0438\\u0435 \\u043b\\u0438\\u0431\\u0435\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0438 \\u0430\\u0432\\u0442\\u043e\\u0440\\u0438\\u0442\\u0435\\u0442\\u043d\\u044b\\u0439 \\u0441\\u0442\\u0438\\u043b\\u0438 \\u0440\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u043e\\u0433\\u043e \\u0432\\u043e\\u0441\\u043f\\u0438\\u0442\\u0430\\u043d\\u0438\\u044f. \\u0421 \\u043e\\u0434\\u043d\\u043e\\u0439 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b, \\u0432 \\u0441\\u0435\\u043c\\u044c\\u0435 \\u0446\\u0430\\u0440\\u0438\\u0442 \\u0430\\u0442\\u043c\\u043e\\u0441\\u0444\\u0435\\u0440\\u0430 \\u0442\\u0435\\u043f\\u043b\\u0430 \\u0438 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u0438\\u044f \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430 \\u0441\\u043e \\u0432\\u0441\\u0435\\u043c\\u0438 \\u0435\\u0433\\u043e \\u043f\\u043b\\u044e\\u0441\\u0430\\u043c\\u0438 \\u0438 \\u043c\\u0438\\u043d\\u0443\\u0441\\u0430\\u043c\\u0438, \\u044d\\u043c\\u043e\\u0446\\u0438\\u044f\\u043c\\u0438 \\u0438 \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u043d\\u0438\\u044f\\u043c\\u0438. \\u0421 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b \\u0434\\u043e\\u043b\\u044f \\u0440\\u0430\\u0437\\u0443\\u043c\\u043d\\u043e\\u0433\\u043e \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u043b\\u044f \\u0441\\u043e \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b \\u0441\\u0442\\u0430\\u0440\\u0448\\u0435\\u0433\\u043e \\u043f\\u043e\\u043a\\u043e\\u043b\\u0435\\u043d\\u0438\\u044f, \\u0437\\u043d\\u0430\\u0447\\u0438\\u043c\\u043e\\u0441\\u0442\\u044c \\u0440\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u043e\\u0433\\u043e&nbsp; \\u0430\\u0432\\u0442\\u043e\\u0440\\u0438\\u0442\\u0435\\u0442\\u0430 \\u043a\\u0430\\u043a \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440\\u0430 \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0440\\u0430\\u0436\\u0430\\u043d\\u0438\\u044f. \\u0412\\u0430\\u0436\\u043d\\u043e \\u0441\\u043e\\u0431\\u043b\\u044e\\u0434\\u0430\\u0442\\u044c \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 \\u043c\\u0435\\u0436\\u0434\\u0443 \\u0432\\u0441\\u0435\\u0434\\u043e\\u0437\\u0432\\u043e\\u043b\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0438 \\u0433\\u0438\\u0431\\u043a\\u043e\\u0441\\u0442\\u044c\\u044e, \\u043a\\u043e\\u0433\\u0434\\u0430&nbsp; \\u0440\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u0438 \\u043c\\u0435\\u043d\\u044f\\u044e\\u0442 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u0443 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b \\u0438 \\u043d\\u043e\\u0440\\u043c \\u0432 \\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u043e\\u0442 \\u0432\\u043e\\u0437\\u0440\\u0430\\u0441\\u0442\\u0430 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430. \\u041e\\u0434\\u043d\\u0430\\u043a\\u043e \\u043d\\u043e\\u0440\\u043c\\u044b \\u0438 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u044b. \\u042d\\u0442\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u0435\\u0442 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0443 \\u0438\\u043c\\u0435\\u0442\\u044c \\u0442\\u0432\\u0435\\u0440\\u0434\\u0443\\u044e \\u0438 \\u0445\\u043e\\u0440\\u043e\\u0448\\u0443\\u044e \\u0441\\u0430\\u043c\\u043e\\u043e\\u0446\\u0435\\u043d\\u043a\\u0443, \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432 \\u0441\\u0435\\u0431\\u0435, \\u0443\\u043c\\u0435\\u043d\\u0438\\u0435 \\u0430\\u0434\\u0430\\u043f\\u0442\\u0438