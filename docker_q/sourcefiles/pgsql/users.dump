044f \\u0441 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u043d\\u044b\\u043c\\u0438 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430\\u043c\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0438\\u043c\\u0435\\u044e\\u0442\\u0441\\u044f \\u0432 \\u043e\\u0431\\u0449\\u0435\\u0441\\u0442\\u0432\\u0435. \\u041e\\u0434\\u043d\\u0438\\u043c \\u0438\\u0437 \\u044d\\u0442\\u0438\\u0445 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u0442\\u043e, \\u0447\\u0442\\u043e \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e \\u0442\\u0430\\u043a \\u0431\\u043b\\u0430\\u0433\\u0430 \\u0438 \\u0436\\u0438\\u0437\\u043d\\u0435\\u043d\\u043d\\u044b\\u0435 \\u043f\\u0440\\u0435\\u0438\\u043c\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0430 \\u043d\\u0435 \\u0441\\u0432\\u0430\\u043b\\u0438\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f \\u043a \\u043d\\u0430\\u043c \\u043d\\u0430 \\u0433\\u043e\\u043b\\u043e\\u0432\\u0443. \\u0414\\u043b\\u044f \\u0438\\u0445 \\u043f\\u0440\\u0438\\u043e\\u0431\\u0440\\u0435\\u0442\\u0435\\u043d\\u0438\\u044f \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u043c\\u043e\\u0433\\u043b\\u0430 \\u0431\\u044b \\u0442\\u0435\\u0431\\u0435 \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0438\\u0442\\u044c \\u0434\\u043e\\u0445\\u043e\\u0434 \\u0438 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c \\u0443\\u0434\\u043e\\u0432\\u043b\\u0435\\u0442\\u0432\\u043e\\u0440\\u044f\\u0442\\u044c \\u0441\\u0435\\u0431\\u044f \\u0432 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u044f\\u0445 \\u0436\\u0438\\u0437\\u043d\\u0438. \\u041d\\u043e \\u0434\\u043b\\u044f \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430 \\u0438 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043f\\u0443\\u0442\\u0438, \\u043d\\u0443\\u0436\\u043d\\u043e \\u0445\\u043e\\u0440\\u043e\\u0448\\u043e \\u0437\\u043d\\u0430\\u0442\\u044c \\u0441\\u0435\\u0431\\u044f, \\u0441\\u0432\\u043e\\u0438 \\u0441\\u0438\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0438 \\u0441\\u043b\\u0430\\u0431\\u044b\\u0435 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b, \\u0441\\u0432\\u043e\\u0438 \\u043f\\u0440\\u0435\\u0438\\u043c\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0430 \\u0438 \\u0441\\u0432\\u043e\\u0438 \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043a\\u0438. \\u041f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u0439 \\u043f\\u0440\\u0438\\u0441\\u043b\\u0443\\u0448\\u0430\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f \\u043a \\u0441\\u0435\\u0431\\u0435, \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u0439 \\u043e \\u0441\\u0432\\u043e\\u0438\\u0445 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u044f\\u0445, \\u0441\\u0432\\u043e\\u0438\\u0445 \\u0443\\u0434\\u0430\\u0447\\u0430\\u0445 \\u0438 \\u043d\\u0435\\u0443\\u0434\\u0430\\u0447\\u0430\\u0445. \\u0412\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u0441\\u0442\\u043e\\u0438\\u0442 \\u043f\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c \\u043d\\u0430\\u0434 \\u0441\\u043e\\u0431\\u043e\\u0439, \\u0443\\u043b\\u0443\\u0447\\u0448\\u0438\\u0442\\u044c \\u043a\\u0430\\u043a\\u0438\\u0435-\\u0442\\u043e \\u0441\\u0432\\u043e\\u0438 \\u043d\\u0430\\u0432\\u044b\\u043a\\u0438, \\u043d\\u043e \\u043d\\u0443\\u0436\\u043d\\u043e \\u0437\\u043d\\u0430\\u0442\\u044c, \\u0447\\u0435\\u0433\\u043e \\u0442\\u044b \\u0445\\u043e\\u0447\\u0435\\u0448\\u044c. \\u042d\\u0442\\u043e \\u043f\\u0440\\u0435\\u0436\\u0434\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e!<\\/p>","name":"\\u0422\\u0435\\u043e\\u0434\\u043e\\u0440 \\u0420\\u0443\\u0437\\u0432\\u0435\\u043b\\u044c\\u0442","post":"\\u0410\\u043c\\u0435\\u0440\\u0438\\u043a\\u0430\\u043d\\u0441\\u043a\\u0438\\u0439 \\u043f\\u043e\\u043b\\u0438\\u0442\\u0438\\u043a, 25-\\u0439 \\u0432\\u0438\\u0446\\u0435-\\u043f\\u0440\\u0435\\u0437\\u0438\\u0434\\u0435\\u043d\\u0442 \\u0421\\u0428\\u0410","comment":"\\u0414\\u0435\\u043b\\u0430\\u0439, \\u0447\\u0442\\u043e \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c, \\u0441 \\u0442\\u0435\\u043c, \\u0447\\u0442\\u043e \\u0438\\u043c\\u0435\\u0435\\u0448\\u044c, \\u0442\\u0430\\u043c, \\u0433\\u0434\\u0435 \\u0442\\u044b \\u0435\\u0441\\u0442\\u044c!"}	2021-02-16 16:20:24	2021-02-16 16:20:24
