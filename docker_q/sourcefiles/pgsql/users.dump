14151	7	admin/users/report/edit/173/comment	POST	77.238.236.109	{"recommendations":"<p>\\u0412 \\u0430\\u043d\\u043a\\u0435\\u0442\\u0435 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0442\\u044b \\u0441\\u0442\\u0430\\u0432\\u0438\\u0448\\u044c \\u043f\\u0435\\u0440\\u0435\\u0434 \\u0441\\u043e\\u0431\\u043e\\u0439 \\"\\u0432\\u0438\\u043b\\u043a\\u0443\\" \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430: \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433 \\u0438\\u043b\\u0438 \\u043f\\u043e\\u0432\\u0430\\u0440. \\u041f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0443, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0441\\u0430\\u043c\\u0430 \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0438 \\u043d\\u0435 \\u0434\\u0443\\u043c\\u0430\\u0442\\u044c \\u043e\\u0431 \\u044d\\u0442\\u043e\\u043c, \\u043a\\u0430\\u043a \\u043e \\u0432\\u044b\\u0431\\u043e\\u0440\\u0435.&nbsp;<\\/p>\\n<p><strong>\\u041f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433 -&nbsp;<\\/strong>\\u0432 \\u043f\\u043e\\u043b\\u044c\\u0437\\u0443 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430 \\u0434\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442 \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u0443\\u0435\\u0448\\u044c\\u0441\\u044f \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438\\u0435\\u0439 (\\u0442\\u0430\\u043a \\u043d\\u0430\\u043f\\u0438\\u0441\\u0430\\u043d\\u043e \\u0432 \\u0430\\u043d\\u043a\\u0435\\u0442\\u0435). \\u0414\\u043e\\u043b\\u0436\\u0435\\u043d \\u0437\\u0430\\u043c\\u0435\\u0442\\u0438\\u0442\\u044c, \\u0447\\u0442\\u043e \\u0431\\u043e\\u043b\\u044c\\u0448\\u0438\\u043d\\u0441\\u0442\\u0432\\u043e \\u043c\\u043e\\u043b\\u043e\\u0434\\u044b\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439 9-11 \\u043a\\u043b\\u0430\\u0441\\u0441\\u0430 \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u044e\\u0442 \\u0443\\u0432\\u043b\\u0435\\u043a\\u0430\\u0442\\u044c\\u0441\\u044f \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438\\u0435\\u0439. \\u041e\\u0434\\u043d\\u0430\\u043a\\u043e, \\u0434\\u0430\\u043c \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0430\\u0446\\u0438\\u044e - \\u0443\\u0437\\u043d\\u0430\\u0439 \\u043e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435. \\u042d\\u0442\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e. \\u0422\\u043e, \\u0447\\u0442\\u043e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0442\\u0435\\u0431\\u044f \\u0441\\u043c\\u0443\\u0442\\u0438\\u0442\\u044c \\u0432 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 - \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433 \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043d\\u0438\\u043a\\u043e\\u0433\\u0434\\u0430 \\u043d\\u0435 \\u0432\\u0438\\u0434\\u0438\\u0442 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u0432 \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u0442\\u0440\\u0443\\u0434\\u0430. \\u041f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0447\\u0442\\u043e \\u0434\\u0443\\u0448\\u0443 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0430 \\u043d\\u0435\\u043b\\u044c\\u0437\\u044f \\u043f\\u043e\\u0442\\u0440\\u043e\\u0433\\u0430\\u0442\\u044c.&nbsp;<\\/p>\\n<p><strong>\\u041f\\u043e\\u0432\\u0430\\u0440 -<\\/strong> \\u0442\\u044b \\u043f\\u0438\\u0448\\u0435\\u0448\\u044c, \\u0447\\u0442\\u043e \\u0443\\u0432\\u043b\\u0435\\u043a\\u0430\\u0435\\u0448\\u044c\\u0441\\u044f \\u0433\\u043e\\u0442\\u043e\\u0432\\u043a\\u043e\\u0439. \\u0421 \\u0442\\u043e\\u0447\\u043a\\u0438 \\u0437\\u0440\\u0435\\u043d\\u0438\\u044f \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u0432 \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439, \\u044f \\u0441\\u043a\\u0430\\u0436\\u0443, \\u0447\\u0442\\u043e \\u0432 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u043f\\u043e\\u0432\\u0430\\u0440\\u0430 \\u0442\\u044b \\u0441\\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\"\\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u044c\\" \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0441\\u0432\\u043e\\u0438\\u0445 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439. \\u0417\\u0434\\u0435\\u0441\\u044c \\u043d\\u0435\\u0442 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0432 \\u0432\\u044b\\u0441\\u043e\\u043a\\u043e\\u0439 \\u0441\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438, \\u043d\\u043e \\u0435\\u0441\\u0442\\u044c \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u0430\\u0440\\u0442\\u0438\\u0441\\u0442\\u0438\\u0437\\u043c\\u0435, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u043d\\u0430 \\u0432\\u044b\\u0441\\u043e\\u0442\\u0435. \\u0422\\u0430\\u043a\\u0430\\u044f \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442\\u0438\\u0442 \\u0438 \\u043d\\u0430 \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441 \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0442\\u0440\\u0443\\u0434\\u0430. \\u0422\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u043f\\u0440\\u0438\\u0433\\u043e\\u0442\\u043e\\u0432\\u0438\\u043b\\u0430 - \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u043f\\u0440\\u043e\\u0434\\u0443\\u043a\\u0442\\u043e\\u043c \\u0442\\u0432\\u043e\\u0438\\u0445 \\u0440\\u0443\\u043a, \\u0442\\u0432\\u043e\\u0435\\u0433\\u043e \\u0432\\u044