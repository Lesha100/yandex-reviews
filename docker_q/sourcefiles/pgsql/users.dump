30753	8	admin/users/report/edit/294/resume	POST	217.21.222.36	{"resume":"<p><span style=\\"color: #7ba5d8;\\">\\u041d\\u0435 \\u043f\\u0443\\u0433\\u0430\\u0439\\u0441\\u044f<\\/span>, \\u0435\\u0441\\u043b\\u0438 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043f\\u043e\\u043a\\u0430\\u0436\\u0443\\u0442\\u0441\\u044f \\u0442\\u0435\\u0431\\u0435 &laquo;\\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c\\u0438&raquo;.<\\/p>\\n<p>\\u0412\\u044b\\u044f\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0432\\u0435\\u0434\\u0443\\u0449\\u0438\\u0445 \\u0443\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043e\\u043a \\u0442\\u0440\\u0443\\u0434-\\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u0430, \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441-\\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043b\\u043e, \\u0447\\u0442\\u043e \\u0432 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0435 \\u0434\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u043d\\u0430 \\u043f\\u0435\\u0440\\u0432\\u043e\\u043c \\u043c\\u0435\\u0441\\u0442\\u0435 \\u0441\\u0442\\u043e\\u044f\\u0442 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u0430 \\u0438 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442. \\u0422\\u0435\\u0431\\u0435 \\u043d\\u0435 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f \\u043e\\u0431\\u0440\\u0435\\u043c\\u0435\\u043d\\u044f\\u0442\\u044c \\u0441\\u0435\\u0431\\u044f \\u043a\\u0430\\u043a\\u0438\\u043c\\u0438-\\u043b\\u0438\\u0431\\u043e \\u0440\\u0430\\u043c\\u043a\\u0430\\u043c\\u0438, \\u0438 \\u043b\\u044e\\u0431\\u043e\\u0435 \\u043d\\u0430\\u0447\\u0430\\u0442\\u043e\\u0435 \\u0434\\u0435\\u043b\\u043e \\u0442\\u044b \\u0441\\u0442\\u0440\\u0435\\u043c\\u0438\\u0448\\u044c\\u0441\\u044f \\u0434\\u043e\\u0432\\u0435\\u0441\\u0442\\u0438 \\u0434\\u043e \\u043a\\u043e\\u043d\\u0446\\u0430. \\u041f\\u0440\\u0438 \\u044d\\u0442\\u043e\\u043c \\u043d\\u0435 \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0437\\u0430\\u0431\\u044b\\u0432\\u0430\\u0442\\u044c \\u0438 \\u043e \\u0441\\u0430\\u043c\\u043e\\u043c \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441\\u0435, \\u0432\\u0435\\u0434\\u044c \\u043e\\u043d \\u043d\\u0435\\u043c\\u0430\\u043b\\u043e\\u0432\\u0430\\u0436\\u0435\\u043d. &nbsp;\\u0421\\u0430\\u043c\\u043e\\u0435 \\u0433\\u043b\\u0430\\u0432\\u043d\\u043e\\u0435, \\u043d\\u0435 \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0441\\u043f\\u0435\\u0448\\u0438\\u0442\\u044c, \\u0432\\u0435\\u0434\\u044c \\u043e\\u0442 \\u044d\\u0442\\u043e\\u0433\\u043e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u043e\\u0441\\u0442\\u0440\\u0430\\u0434\\u0430\\u0442\\u044c \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0430.<\\/p>\\n<p>\\u0422\\u0435\\u0441\\u0442 \\u043d\\u0430 \\u0442\\u0438\\u043f \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f \\u0432\\u044b\\u044f\\u0432\\u0438\\u043b \\u0441\\u0431\\u0430\\u043b\\u0430\\u043d\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0435 \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u0435, \\u043e\\u0434\\u043d\\u0430\\u043a\\u043e, \\u043d\\u0430 \\u043f\\u0435\\u0440\\u0435\\u0434\\u043d\\u0438\\u0439 \\u043f\\u043b\\u0430\\u043d \\u0432\\u044b\\u0445\\u043e\\u0434\\u044f\\u0442 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c \\u0438 \\u0430\\u0431\\u0441\\u0442\\u0440\\u0430\\u043a\\u0442\\u043d\\u043e-\\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435. \\u0423\\u043c\\u0435\\u043d\\u0438\\u0435 \\u043c\\u044b\\u0441\\u043b\\u0438\\u0442\\u044c \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e &nbsp;&ndash; \\u0437\\u0430\\u043c\\u0435\\u0447\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0435 \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e. \\u0421\\u0435\\u0431\\u044f \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e \\u043f\\u043e\\u0441\\u0442\\u043e\\u044f\\u043d\\u043d\\u043e \\u0434\\u0435\\u0440\\u0436\\u0430\\u0442\\u044c \\u0432 \\u0442\\u043e\\u043d\\u0443\\u0441\\u0435 &nbsp;\\u0438 \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u0442\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e, \\u0432 \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0442\\u044b \\u0441\\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0440\\u0443\\u043a\\u043e\\u0432\\u043e\\u0434\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441\\u043e\\u043c \\u0441\\u0430\\u043c\\u043e\\u0441\\u0442\\u043e\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e, \\u0433\\u0434\\u0435 \\u043d\\u0435 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0436\\u0451\\u0441\\u0442\\u043a\\u0438\\u0445 \\u0440\\u0430\\u043c\\u043e\\u043a. \\u0425\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f \\u043e\\u0442\\u043c\\u0435\\u0442\\u0438\\u0442\\u044c, \\u0447\\u0442\\u043e \\u0430\\u0431\\u0441\\u0442\\u0440\\u0430\\u043a\\u0442\\u043d\\u043e-\\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0441\\u0432\\u043e\\u0439\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e &laquo;\\u043b\\u044e\\u0434\\u044f\\u043c \\u0446\\u0438\\u0444\\u0440&raquo;. \\u0421\\u0442\\u043e\\u0438\\u0442 \\u043e\\u0431\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u0441\\u0432\\u043e\\u0451 \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0442\\u0430\\u043a\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u043a\\u0430\\u043a \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0441\\u0442, \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a, \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a, \\u0430 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u0442\\u044b \\u0443\\u0436\\u0435 \\u0441\\u0435\\u0431\\u044f \\u0441\\u0432\\u044f\\u0437\\u044b\\u0432\\u0430\\u0435\\u0448\\u044c \\u0441 \\u044d\\u0442\\u0438\\u043c\\u0438 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f\\u043c\\u0438?<\\/p>\\n<p>\\u0422\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0432\\u044b\\u044f\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0432\\u0435\\u0434\\u0443\\u0449\\u0435\\u0433\\u043e \\u0442\\u0438\\u043f\\u0430 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u0447\\u0442\\u0435\\u043d\\u0438\\u0439&nbsp; \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043b\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u0438 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u044b\\u0439 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u0446\\u0435\\u043d\\u0438\\u0442 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u0443, &nbsp;\\u043e\\u0440\\u0438\\u0433\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0438 \\u043d\\u0430\\u0445\\u043e\\u0434\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u044c. \\u042d\\u0442\\u0438 \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430 \\u043f\\u0440\\u043e\\u044f\\u0432\\u043b\\u044f\\u044e\\u0442\\u0441\\u044f \\u044f\\u0440\\u0447\\u0435&nbsp; \\u0432\\u0441\\u0435\\u0433\\u043e. \\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043f\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0442\\u0430\\u043a\\u0436\\u0435, \\u0447\\u0442\\u043e \\u0442\\u044b &ndash; \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u043a. \\u0421\\u043a\\u043e\\u0440\\u0435\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e, \\u0441 \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u043e\\u0439 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0445\\u043e\\u0440\\u043e\\u0448\\u043e \\u043d\\u0430\\u043b\\u0430\\u0436\\u0435\\u043d \\u043a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442, \\u0438 \\u043a \\u0447\\u0435\\u043c\\u0443 \\u0431\\u044b \\u0442\\u044b \\u043d\\u0435 \\u043f\\u0440\\u0438\\u043a\\u043e\\u0441\\u043d\\u0443\\u043b\\u0430\\u0441\\u044c &nbsp;&ndash; \\u043f\\u043e\\u0439\\u043c\\u0451\\u0448\\u044c, \\u043a\\u0430\\u043a \\u044d\\u0442\\u043e \\u0443\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u043e, \\u0438 \\u043a\\u0430\\u043a \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u043f\\u043e-\\u043d\\u0430\\u0448\\u0435\\u043c\\u0443 \\u043c\\u043d\\u0435\\u043d\\u0438\\u044e, \\u0443 \\u0442\\u0435\\u0431\\u044f \\u043f\\u0440\\u043e\\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441 \\u043a \\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439&nbsp; \\u0438 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u0441 \\u0442\\u0435\\u043c\\u0438 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044f\\u043c\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u043f\\u0440\\u0438\\u0432\\u0435\\u0434\\u0435\\u043d\\u044b \\u0432\\u044b\\u0448\\u0435 \\u044d\\u0442\\u043e \\u0437\\u0430\\u043c\\u0435\\u0447\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0441\\u0445\\u043e\\u0434\\u0438\\u0442\\u0441\\u044f!<\\/p>"}	2021-06-08 14:34:54	2021-06-08 14: