430\\u0436\\u043d\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0432\\u0430\\u0442\\u044c \\u0432 \\u043f\\u0435\\u0440\\u0432\\u0443\\u044e \\u043e\\u0447\\u0435\\u0440\\u0435\\u0434\\u044c \\u043a\\u043e\\u043c\\u043c\\u0443\\u043d\\u0438\\u043a\\u0430\\u0442\\u0438\\u0432\\u043d\\u044b\\u0435 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438, \\u0443\\u043c\\u0435\\u043d\\u0438\\u0435 \\u0440\\u0430\\u0437\\u0431\\u0438\\u0440\\u0430\\u0442\\u044c\\u0441\\u044f \\u0432 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043b\\u044e\\u0434\\u044f\\u0445. \\u042d\\u0442\\u0430 \\u0441\\u0444\\u0435\\u0440\\u0430 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u043d\\u0435 \\u043b\\u044e\\u0431\\u0438\\u0442 \\u0441\\u043b\\u0443\\u0447\\u0430\\u0439\\u043d\\u044b\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439. \\u041f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u0432\\u0430\\u0436\\u043d\\u043e \\u043e\\u0442\\u0434\\u0430\\u0432\\u0430\\u0442\\u044c \\u0441\\u0435\\u0431\\u0435 \\u043e\\u0442\\u0447\\u0435\\u0442 \\u0432 \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0441\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0440\\u0430\\u0431\\u043e\\u0442\\u043d\\u0438\\u043a\\u0430 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u0430\\u0433\\u0430\\u0435\\u0442: \\u043e\\u0431\\u0449\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0443\\u043c\\u0435\\u043d\\u0438\\u0435 \\u0443\\u0441\\u0442\\u0430\\u043d\\u0430\\u0432\\u043b\\u0438\\u0432\\u0430\\u0442\\u044c \\u043a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442, \\u0441\\u043b\\u0443\\u0436\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0431\\u0449\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u043c\\u0443 \\u0434\\u043e\\u043b\\u0433\\u0443, \\u0430\\u0434\\u0435\\u043a\\u0432\\u0430\\u0442\\u043d\\u0443\\u044e \\u0441\\u0