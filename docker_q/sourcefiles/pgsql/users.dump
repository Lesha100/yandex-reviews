e\\":8,\\"creativity\\":8,\\"testName\\":\\"\\\\u0422\\\\u0438\\\\u043f \\\\u043c\\\\u044b\\\\u0448\\\\u043b\\\\u0435\\\\u043d\\\\u0438\\\\u044f\\"}","3":"{\\"realistic\\":4,\\"intellectual\\":4,\\"social\\":6,\\"office\\":3,\\"enterprising\\":6,\\"artistic\\":7,\\"testName\\":\\"\\\\u041f\\\\u0440\\\\u043e\\\\u0444\\\\u0435\\\\u0441\\\\u0441\\\\u0438\\\\u043e\\\\u043d\\\\u0430\\\\u043b\\\\u044c\\\\u043d\\\\u044b\\\\u0439 \\\\u0442\\\\u0438\\\\u043f \\\\u043b\\\\u0438\\\\u0447\\\\u043d\\\\u043e\\\\u0441\\\\u0442\\\\u0438\\"}"}	\N	1	0	1
