\\\u043a\\\\u0438\\\\u0435 \\\\u0441\\\\u043f\\\\u043e\\\\u0441\\\\u043e\\\\u0431\\\\u043d\\\\u043e\\\\u0441\\\\u0442\\\\u0438\\"}","13":"{\\"process\\":10,\\"result\\":10,\\"altruism\\":10,\\"egoism\\":10,\\"testName\\":\\"\\\\u0412\\\\u044b\\\\u044f\\\\u0432\\\\u043b\\\\u0435\\\\u043d\\\\u0438\\\\u0435 \\\\u0443\\\\u0441\\\\u0442\\\\u0430\\\\u043d\\\\u043e\\\\u0432\\\\u043e\\\\u043a  \\\\\\"\\\\u043f\\\\u0440\\\\u043e\\\\u0446\\\\u0435\\\\u0441\\\\u0441-\\\\u0440\\\\u0435\\\\u0437\\\\u0443\\\\u043b\\\\u044c\\\\u0442\\\\u0430\\\\u0442\\\\\\", \\\\\\"\\\\u0430\\\\u043b\\\\u044c\\\\u0442\\\\u0440\\\\u0443\\\\u0438\\\\u0437\\\\u043c-\\\\u044d\\\\u0433\\\\u043e\\\\u0438\\\\u0437\\\\u043c\\\\\\"\\"}"}	\N	1	0	1
