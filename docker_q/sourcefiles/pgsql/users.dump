0433\\u043e \\u0432\\u043e\\u0437\\u0440\\u0430\\u0441\\u0442\\u0430. \\u0418\\u043c\\u0435\\u043d\\u043d\\u043e \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431 &ndash;&nbsp; \\u0447\\u0435\\u0440\\u0435\\u0437 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442 \\u0438 \\u0435\\u0433\\u043e \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u044e, \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u043e\\u043c\\u043e\\u0447\\u044c \\u043f\\u0440\\u0438\\u043e\\u0431\\u0440\\u0435\\u0441\\u0442\\u0438 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u0438\\u0439 \\u043e\\u043f\\u044b\\u0442 \\u0438 \\u0434\\u0430\\u0441\\u0442 \\u043f\\u043e\\u043d\\u044f\\u0442\\u044c \\u043d\\u0430\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u043e \\u044d\\u0442\\u043e \\u0442\\u0432\\u043e\\u0435 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435.<\\/p>\\n<p>\\u0421\\u0430\\u043c\\u044b\\u0435 \\u0440\\u0430\\u0441\\u043f\\u0440\\u043e\\u0441\\u0442\\u0440\\u0430\\u043d\\u0451\\u043d\\u043d\\u044b\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0438 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u043e\\u0439 \\u0441\\u0444\\u0435\\u0440\\u044b - \\u0443\\u0447\\u0435\\u043d\\u044b\\u0435, \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0438, \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0441\\u0442\\u044b, \\u044d\\u043a\\u043e\\u043d\\u043e\\u043c\\u0438\\u0441\\u0442\\u044b, \\u0430\\u0443\\u0434\\u0438\\u0442\\u043e\\u0440\\u044b, \\u0441\\u043e\\u0446\\u0438\\u043e\\u043b\\u043e\\u0433\\u0438, \\u0433\\u0435\\u043d\\u0435\\u0442\\u0438\\u043a\\u0438, \\u044d\\u043a\\u043e\\u043b\\u043e\\u0433\\u0438, \\u0444\\u0430\\u0440\\u043c\\u0430\\u0446\\u0435\\u0432\\u0442\\u044b, \\u043b\\u0438\\u043d\\u0433\\u0432\\u0438\\u0441\\u0442\\u044b, \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e\\u0432\\u0435\\u0434\\u044b.<\\/p>\\n<p>\\u041a\\u0440\\u043e\\u043c\\u0435 \\u0442\\u043e\\u0433\\u043e, \\u0442\\u044b \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u043e\\u0431\\u0449\\u0430\\u0442\\u044c\\u0441\\u044f \\u0441 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438. \\u0422\\u0435\\u0431\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0431\\u044b\\u0442\\u044c \\u0441 \\u0434\\u0440\\u0443\\u0437\\u044c\\u044f\\u043c\\u0438. \\u0422\\u0435\\u0431\\u0435 \\u043f\\u0440\\u0438\\u044f\\u0442\\u043d\\u043e, \\u043a\\u043e\\u0433\\u0434\\u0430 \\u043a \\u0442\\u0432\\u043e\\u0435\\u043c\\u0443 \\u043c\\u043d\\u0435\\u043d\\u0438\\u044e \\u043f\\u0440\\u0438\\u0441\\u043b\\u0443\\u0448\\u0438\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f, \\u0438 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0442\\u044c \\u043e\\u0434\\u043e\\u0431\\u0440\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u0441\\u0438\\u043c\\u043f\\u0430\\u0442\\u0438\\u044e \\u0441\\u043e \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b. \\u042d\\u0442\\u043e \\u0441\\u0432\\u043e\\u0439\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u0430\\u043c \\u0432 <strong><em>\\u0441\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0441\\u0444\\u0435\\u0440\\u0435<\\/em><\\/strong>.<\\/p>\\n<p>\\u041f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0441\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0441\\u0444\\u0435\\u0440\\u044b - \\u0432\\u0440\\u0430\\u0447\\u0438, \\u043f\\u0435\\u0434\\u0430\\u0433\\u043e\\u0433\\u0438, \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438, \\u044d\\u043a\\u0441\\u043a\\u0443\\u0440\\u0441\\u043e\\u0432\\u043e\\u0434\\u044b, \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b\\u0438\\u0441\\u0442\\u044b, \\u043c\\u0435\\u043d\\u0435\\u0434\\u0436\\u0435\\u0440\\u044b, \\u0434\\u0438-\\u0434\\u0436\\u0435\\u0438, \\u0442\\u0435\\u043b\\u0435- \\u0438 \\u0440\\u0430\\u0434\\u0438\\u043e\\u0432\\u0435\\u0434\\u0443\\u0449\\u0438\\u0435, \\u0431\\u043b\\u043e\\u0433\\u0435\\u0440\\u044b, \\u043f\\u0438\\u0430\\u0440-\\u043c\\u0435\\u043d\\u0435\\u0434\\u0436\\u0435\\u0440\\u044b, \\u044e\\u0440\\u0438\\u0441\\u0442\\u044b, \\u0430\\u0434\\u0432\\u043e\\u043a\\u0430\\u0442\\u044b, \\u043c\\u0430\\u0440\\u043a\\u0435\\u0442\\u043e\\u043b\\u043e\\u0433\\u0438.<\\/p>\\n<p>\\u0422\\u0435\\u0431\\u0435 \\u043d\\u0435 \\u0447\\u0443\\u0436\\u0434\\u0430 \\u043b\\u044e\\u0431\\u043e\\u0432\\u044c \\u043a \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u0443 \\u0438 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u0443. \\u0422\\u0435\\u0431\\u044f \\u043f\\u0440\\u0438\\u0432\\u043b\\u0435\\u043a\\u0430\\u0435\\u0442 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430, \\u0433\\u0434\\u0435 \\u043d\\u0435\\u0442 \\u0436\\u0435\\u0441\\u0442\\u043a\\u043e\\u0433\\u043e \\u0440\\u0435\\u0436\\u0438\\u043c\\u0430, \\u0444\\u043e\\u0440\\u043c\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439, \\u0436\\u0435\\u0441\\u0442\\u043a\\u0438\\u0445 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0439 \\u0438 \\u0433\\u0434\\u0435 \\u0432\\u0430\\u0436\\u043d\\u043e \\u0438\\u043c\\u0435\\u0442\\u044c \\u0432\\u043a\\u0443\\u0441 \\u0438 \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438: \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0435, \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043d\\u044b\\u0435, \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435. \\u042