0430\\u043b\\u0430,&nbsp;<\\/strong><span style=\\"color: #707070;\\">\\u0447\\u0442\\u043e \\u0442\\u044b \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442 \\u043a \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u044e \\u0438 \\u043d\\u0430\\u043b\\u0430\\u0436\\u0438\\u0432\\u0430\\u043d\\u0438\\u044e \\u043d\\u043e\\u0432\\u044b\\u0445 \\u043a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442\\u043e\\u0432. \\u0412\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c \\u044d\\u043a\\u0441\\u0442\\u0440\\u0430\\u0432\\u0435\\u0440\\u0441\\u0438\\u0438 \\u043f\\u0440\\u043e\\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u0432 \\u0438\\u0437\\u0431\\u044b\\u0442\\u043e\\u0447\\u043d\\u043e\\u0439 \\u043e\\u0431\\u0449\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u043d\\u0435\\u0440\\u0430\\u0437\\u0431\\u043e\\u0440\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u0438 \\u0432 \\u043d\\u043e\\u0432\\u044b\\u0445 \\u0432\\u044b\\u0441\\u0442\\u0440\\u0430\\u0438\\u0432\\u0430\\u0435\\u043c\\u044b\\u0445 \\u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u044f\\u0445, \\u0438\\u043d\\u043e\\u0433\\u0434\\u0430 \\u043c\\u0435\\u0448\\u0430\\u044e\\u0449\\u0435\\u0439 \\u0446\\u0435\\u043b\\u0435\\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u0439.\\u0422\\u044b \\u0430\\u043a\\u0442\\u0438\\u0432\\u043d\\u044b\\u0439, \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0432 \\u0441\\u0435\\u0431\\u0435, \\u0441\\u0442\\u0440\\u0435\\u043c\\u0438\\u0448\\u044c\\u0441\\u044f \\u043a \\u0441\\u0430\\u043c\\u043e\\u0441\\u0442\\u043e\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0414\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u043d\\u0430 \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u043d\\u043e\\u043c\\u0443 \\u0441\\u0430\\u043c\\u043e\\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044e, \\u0441\\u0442\\u0440\\u0435\\u043c\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0431\\u044b\\u0442\\u044c \\u043b\\u0438\\u0434\\u0435\\u0440\\u043e\\u043c. \\u0422\\u044b \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u043d\\u0435 \\u0442\\u0435\\u0440\\u043f\\u0438\\u0442 \\u0440\\u0430\\u043c\\u043a\\u0438, \\u0432 \\u0442\\u0435\\u0431\\u0435 \\u043c\\u043d\\u043e\\u0433\\u043e \\u043f\\u0441\\u0438\\u0445\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0441\\u0438\\u043b\\u044b \\u0438 \\u044d\\u0442\\u043e \\u043f\\u043e\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0432 \\u0434\\u043e\\u0441\\u0442\\u0438\\u0436\\u0435\\u043d\\u0438\\u0438 \\u0430\\u043c\\u0431\\u0438\\u0446\\u0438\\u043e\\u0437\\u043d\\u043e\\u0439 \\u0446\\u0435\\u043b\\u0438. \\u0412 \\u0442\\u0432\\u043e\\u0435\\u043c \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u0435 \\u0437\\u0430\\u043b\\u043e\\u0436\\u0435\\u043d\\u043e \\u0443\\u043f\\u043e\\u0440\\u0441\\u0442\\u0432\\u043e \\u0438 \\u0434\\u0430\\u0436\\u0435 \\u0443\\u043f\\u0440\\u044f\\u043c\\u0441\\u0442\\u0432\\u043e. \\u0414\\u043b\\u044f \\u0434\\u043e\\u0441\\u0442\\u0438\\u0436\\u0435\\u043d\\u0438\\u044f \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u0432 - \\u044d\\u0442\\u043e \\u043e\\u0442\\u043b\\u0438\\u0447\\u043d\\u043e, \\u043d\\u043e \\u0432\\u043e\\u0442 \\u0434\\u043b\\u044f \\u0432\\u044b\\u0441\\u0442\\u0440\\u0430\\u0438\\u0432\\u0430\\u043d\\u0438\\u044f \\u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u0439 \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u0435\\u0442\\u0441\\u044f \\u0431\\u044b\\u0442\\u044c \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0433\\u0438\\u0431\\u043a\\u0438\\u043c. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0438\\u0442\\u0435\\u043b\\u0435\\u043d \\u043a \\u043e\\u0446\\u0435\\u043d\\u043a\\u0435 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0430\\u044e\\u0449\\u0438\\u0445, \\u0438 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u0435\\u043d \\u0434\\u043e\\u043b\\u0433\\u043e \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u0442\\u044c \\u0441\\u0441\\u043e\\u0440\\u044b, \\u043a\\u043e\\u043d\\u0444\\u043b\\u0438\\u043a\\u0442\\u044b \\u0438 \\u0433\\u0440\\u0443\\u0431\\u043e\\u0441\\u0442\\u044c \\u043f\\u043e \\u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u044e \\u043a \\u0441\\u0435\\u0431\\u0435.&nbsp;<\\/span><\\/span><\\/p>"}	2021-01-25 17:58:48	2021-01-25 17:58:48
