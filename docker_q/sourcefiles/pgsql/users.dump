\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0439 \\u043c\\u0438\\u0440\\u0430. \\u0421\\u0435\\u0439\\u0447\\u0430\\u0441 \\u043e\\u043d \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0432\\u044b\\u0431\\u0440\\u0430\\u0442\\u044c \\u043e\\u0431\\u0449\\u0435\\u0435 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u044f, \\u043d\\u043e \\u043d\\u0435 \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0431\\u043e\\u044f\\u0442\\u044c\\u0441\\u044f \\u0435\\u0433\\u043e \\u043c\\u0435\\u043d\\u044f\\u0442\\u044c. \\u0415\\u0441\\u043b\\u0438 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043e\\u043a \\u043f\\u043e\\u0439\\u043c\\u0435\\u0442, \\u0447\\u0442\\u043e \\u0435\\u0433\\u043e \\u0443\\u0432\\u043b\\u0435\\u043a\\u043b\\u043e \\u0447\\u0442\\u043e-\\u0442\\u043e \\u043d\\u043e\\u0432\\u043e\\u0435 \\u0438\\u043b\\u0438 \\u0447\\u0442\\u043e \\u0435\\u043c\\u0443 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f \\u0432\\u044b\\u0431\\u0440\\u0430\\u0442\\u044c \\u0441\\u043c\\u0435\\u0436\\u043d\\u043e\\u0435 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438, \\u043e\\u043d \\u043c\\u043e\\u0436\\u0435\\u0442 \\u044d\\u0442\\u043e \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c. \\u041d\\u0438\\u043a\\u043e\\u0433\\u0434\\u0430 \\u043d\\u0435 \\u043f\\u043e\\u0437\\u0434\\u043d\\u043e \\u0447\\u0442\\u043e-\\u0442\\u043e \\u0438\\u0437\\u043c\\u0435\\u043d\\u0438\\u0442\\u044c, \\u0442\\u0435\\u043c \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0447\\u0442\\u043e \\u0441\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u044b\\u0439 \\u043c\\u0438\\u0440 \\u043f\\u0440\\u04