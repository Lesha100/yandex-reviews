18887	1	admin/instruction/update/7/2	POST	77.238.236.109	{"_token":"1SZKO2oKO9JG3Gdqhst2db6o6oeFWyxX7PK3MZeq","description":"\\u0414\\u0430\\u043d\\u043d\\u044b\\u0439 \\u0442\\u0435\\u0441\\u0442 \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u0447\\u0430\\u0441\\u0442\\u044c\\u044e \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u044b, \\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043d\\u043d\\u043e\\u0439 \\"\\u041d\\u0430\\u0443\\u0447\\u043d\\u043e-\\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u043c \\u0446\\u0435\\u043d\\u0442\\u0440\\u043e\\u043c \\u0434\\u0435\\u0442\\u0441\\u043a\\u043e\\u0439 \\u043d\\u0435\\u0432\\u0440\\u043e\\u043b\\u043e\\u0433\\u0438\\u0438 \\u0438\\u043c. \\u0421\\u0443\\u0445\\u0430\\u0440\\u0435\\u0432\\u043e\\u0439\\" \\u0438 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0435\\u0442\\u0441\\u044f \\u0432 \\u0446\\u0435\\u043b\\u044f\\u0445 \\u0443\\u0434\\u0430\\u043b\\u0435\\u043d\\u043d\\u043e\\u0439 \\u043f\\u0435\\u0440\\u0432\\u0438\\u0447\\u043d\\u043e\\u0439 \\u0434\\u0438\\u0430\\u0433\\u043d\\u043e\\u0441\\u0442\\u0438\\u043a\\u0438","point":["\\u041f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0435 \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435, \\u0435\\u0441\\u043b\\u0438 \\u0412\\u044b \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043d\\u044b \\u0441 \\u043d\\u0438\\u043c \\u043d\\u0430\\u0436\\u043c\\u0438\\u0442\\u0435 \\"\\u0412\\u0435\\u0440\\u043d\\u043e\\", \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0435 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043d\\u044b \\"\\u041d\\u0435\\u0432\\u0435\\u0440\\u043d\\u043e\\"","\\u0411\\u0443\\u0434\\u044c\\u0442\\u0435 \\u0432\\u043d\\u0438\\u043c\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b: \\u0435\\u0441\\u043b\\u0438 \\u0437\\u0432\\u0443\\u0447\\u0438\\u0442 \\u043e\\u0442\\u0440\\u0438\\u0446\\u0430\\u043d\\u0438\\u0435, \\u043a \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440\\u0443 \\u00ab\\u042f \\u043d\\u0435 \\u043b\\u044e\\u0431\\u043b\\u044e \\u0445\\u043e\\u0434\\u0438\\u0442\\u044c \\u0432 \\u0433\\u043e\\u0441\\u0442\\u0438...\\u00bb, \\u0442\\u043e \\u0432\\u0430\\u0448\\u0435 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0438\\u0435 - \\u00ab\\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0435\\u043d, \\u043d\\u0435 \\u043b\\u044e\\u0431\\u043b\\u044e\\u00bb \\u043e\\u0431\\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u043a\\u0430\\u043a \\u00ab\\u0412\\u0435\\u0440\\u043d\\u043e\\u00bb.","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043d\\u0435 \\u0442\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u043c\\u043d\\u043e\\u0433\\u043e \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438 \\u043d\\u0430 \\u043e\\u0431\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u043d\\u0438\\u0435","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043e\\u0442\\u0432\\u0435\\u0447\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a \\u043c\\u043e\\u0436\\u043d\\u043e \\u0438\\u0441\\u043a\\u0440\\u0435\\u043d\\u043d\\u0435\\u0439","\\u041f\\u043e\\u043c\\u043d\\u0438\\u0442\\u0435, \\u0447\\u0442\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b \\u043d\\u0430 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441 \\u043d\\u0438\\u0433\\u0434\\u0435 \\u043d\\u0435 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f, \\u0438 \\u043d\\u0438\\u043a\\u0442\\u043e (\\u0434\\u0430\\u0436\\u0435 \\u0432\\u044b \\u0441\\u0430\\u043c\\u0438) \\u043d\\u0435 \\u0441\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0438\\u0445 \\u0443\\u0432\\u0438\\u0434\\u0435\\u0442\\u044c \\u043f\\u043e \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u043d\\u0438\\u0438 \\u0442\\u0435\\u0441\\u0442\\u0430","\\u041f\\u043e \\u043e\\u