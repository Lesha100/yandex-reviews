17395	9	admin/users/report/edit/228/resume	POST	77.238.236.109	{"resume":"<p><span style=\\"color: #2761a0;\\">\\u0421\\u0440\\u0430\\u0437\\u0443 \\u043e\\u0442\\u043c\\u0435\\u0442\\u0438\\u043c,<\\/span> \\u0447\\u0442\\u043e \\u043f\\u043e \\u043d\\u0430\\u0448\\u0435\\u043c\\u0443 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u044e, \\u0442\\u0435\\u0441\\u0442\\u044b \\u0432\\u044b\\u0437\\u0432\\u0430\\u043b\\u0438 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0437\\u0430\\u0442\\u0440\\u0443\\u0434\\u043d\\u0435\\u043d\\u0438\\u0435. \\u041f\\u043e\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u0443 \\u0442\\u0435\\u0441\\u0442\\u044b \\u043f\\u0440\\u0438\\u0437\\u0432\\u0430\\u043d\\u044b \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0438\\u0442\\u044c \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0447\\u0435\\u0440\\u0442 \\u0438 \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u0438\\u0441\\u0442\\u0438\\u043a \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0430 \\u0438, \\u043d\\u0430\\u043e\\u0431\\u043e\\u0440\\u043e\\u0442, &nbsp;\\u043d\\u0435\\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c &nbsp;\\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u0447\\u0435\\u0440\\u0442, \\u0447\\u0442\\u043e \\u043a\\u0430\\u043a \\u0440\\u0430\\u0437 \\u0438 \\u0434\\u0430\\u0435\\u0442 \\u0438\\u043d\\u0434\\u0438\\u0432\\u0438\\u0434\\u0443\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 &nbsp;\\u043f\\u043e\\u0440\\u0442\\u0440\\u0435\\u0442 , &nbsp;\\u0442\\u043e \\u043d\\u0430\\u043b\\u0438\\u0447\\u0438\\u0435 \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043e\\u0434\\u0438\\u043d\\u0430\\u043a\\u043e\\u0432\\u044b\\u0445 \\u0431\\u0430\\u043b\\u043b\\u043e\\u0432 \\u043f\\u043e \\u0432\\u0441\\u0435\\u043c \\u0448\\u043a\\