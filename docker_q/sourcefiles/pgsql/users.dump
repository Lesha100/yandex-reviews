\\u043c\\u0430\\u043c\\u0438, \\u0432 \\u0442\\u043e\\u043c \\u0447\\u0438\\u0441\\u043b\\u0435 \\u0441 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435\\u043c \\u043a\\u043e\\u043c\\u043f\\u044c\\u044e\\u0442\\u0435\\u0440\\u043d\\u044b\\u0445 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432. \\u0414\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u0432\\u0430\\u0436\\u043d\\u043e \\u0447\\u0442\\u043e\\u0431\\u044b \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0431\\u044b\\u043b\\u0430 \\u0441\\u043f\\u043e\\u043a\\u043e\\u0439\\u043d\\u0430\\u044f, \\u0441 \\u0447\\u0435\\u0442\\u043a\\u0438\\u043c \\u0433\\u0440\\u0430\\u0444\\u0438\\u043a\\u043e\\u043c \\u0438 \\u0441\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u043e\\u0439. \\u0414\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u0432\\u0430\\u0436\\u043d\\u043e \\u0438\\u043c\\u0435\\u0442\\u044c \\u0447\\u0435\\u0442\\u043a\\u0438\\u0439 \\u043f\\u0435\\u0440\\u0435\\u0447\\u0435\\u043d\\u044c \\u0444\\u0443\\u043d\\u043a\\u0446\\u0438\\u0439 \\u0438 \\u043e\\u0431\\u044f\\u0437\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439. \\u0422\\u044b \\u043e\\u0442\\u043b\\u0438\\u0447\\u0430\\u0435\\u0448\\u044c\\u0441\\u044f \\u0443\\u0441\\u0438\\u0434\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u044c\\u044e,\\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e, \\u0430\\u043a\\u043a\\u0443\\u0440\\u0430\\u0442\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e. \\u0426\\u0435\\u043d\\u0438\\u0448\\u044c \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043f\\u0443\\u043d\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0430 \\u043c\\u0430\\u0442\\u0435\\u0440\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0431\\u043b\\u0430\\u0433\\u043e\\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0435 \\u0438\\u043c\\u0435\\u0435\\u0442 \\u0431\\u043e\\u043b\\u044c\\u0448\\u043e\\u0435 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435. \\u0422\\u0435\\u0431\\u0435 \\u043f\\u043e\\u0434\\u043e\\u0439\\u0434\\u0443\\u0442 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438: \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u043b\\u0435\\u0440, \\u0444\\u0438\\u043d\\u0430\\u043d\\u0441\\u0438\\u0441\\u0442, \\u043b\\u043e\\u0433\\u0438\\u0441\\u0442, \\u0431\\u0443\\u0445\\u0433\\u0430\\u043b\\u0442\\u0435\\u0440.<\\/p>\\n<p>\\u0415\\u0441\\u0442\\u044c \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u0441\\u044b\\u043b\\u043a\\u0438 \\u043a <strong>\\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439, \\u0441\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0438 \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0442\\u043e\\u0440\\u0441\\u043a\\u043e\\u0439<\\/strong> \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044f\\u043c. \\u0422\\u043e \\u0435\\u0441\\u0442\\u044c \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0443\\u0437\\u043d\\u0430\\u0432\\u0430\\u0442\\u044c, \\u043a\\u0430\\u043a \\u0443\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u0430 \\u0436\\u0438\\u0437\\u043d\\u044c, \\u0442\\u044b \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0435 \\u0441 \\u0434\\u0440\\u0443\\u0437\\u044c\\u044f\\u043c\\u0438, \\u0442\\u044b \\u0433\\u043e\\u0442\\u043e\\u0432 \\u043a \\u0442\\u043e\\u043c\\u0443, \\u0447\\u0442\\u043e\\u0431\\u044b \\u0432\\u0437\\u044f\\u0442\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0437\\u0430 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439. \\u0422\\u0435\\u0431\\u044f \\u0440\\u0430\\u0434\\u0443\\u0435\\u0442, \\u043a\\u043e\\u0433\\u0434\\u0430 \\u0442\\u0432\\u043e\\u0435\\u043c\\u0443 \\u043c\\u043d\\u0435\\u043d\\u0438\\u044e \\u043f\\u0440\\u0438\\u0441\\u043b\\u0443\\u0448\\u0438\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f. \\u0422\\u044b \\u043d\\u0435 \\u0431\\u043e\\u0448\\u044c\\u0441\\u044f \\u043c\\u043d\\u043e\\u0433\\u043e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c. \\u041e\\u0442 \\u043f\\u0440\\u0438\\u0440\\u043e\\u0434\\u044b \\u0442\\u044b \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u0435\\u0448\\u044c, \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e, \\u0441\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u043e\\u043c, \\u0435\\u0441\\u0442\\u044c \\u043b\\u0438\\u0434\\u0435\\u0440\\u0441\\u043a\\u0438\\u0439 \\u043f\\u043e\\u0442\\u0435\\u043d\\u0446\\u0438\\u0430\\u043b. \\u041f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u043f\\u043e\\u0434\\u043e\\u0439\\u0434\\u0442 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0442\\u0440\\u0435\\u0431\\u0443\\u044e\\u0442 \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0442\\u043e\\u0440\\u0441\\u043a\\u0438\\u0445, \\u043b\\u0438\\u0434\\u0435\\u0440\\u0441\\u043a\\u0438\\u0445 \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432. \\u0422\\u0430\\u043a\\u0436\\u0435 \\u043c\\u043e\\u0436\\u043d\\u043e \\u0440\\u0430\\u0441\\u0441\\u043c\\u0430\\u0442\\u0440\\u0438\\u0432\\u0430\\u0442\\u044c \\u0441\\u0444\\u0435\\u0440\\u044b, \\u0441\\u0432\\u044f\\u0437\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0441 \\u0432\\u0440\\u0430\\u0447\\u0435\\u0431\\u043d\\u044b\\u043c, \\u0430\\u0434\\u0432\\u043e\\u043a\\u0430\\u0442\\u0441\\u043a\\u0438\\u043c \\u0438 \\u0443\\u0447\\u0438\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u0438\\u043c \\u0434\\u0435\\u043b\\u043e\\u043c.<\\/p>\\n<p><span style=\\"color: #2761a0;\\"><strong>\\u0422\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u043d\\u043