u0432\\u043e\\u0435\\u0433\\u043e \\u0442\\u0440\\u0443\\u0434\\u0430. \\u042d\\u0442\\u043e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0434\\u043b\\u044f \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442\\u0441\\u044f \\u0430\\u043a\\u043a\\u0443\\u0440\\u0430\\u0442\\u043d\\u043e\\u0441\\u0442\\u044c \\u0434\\u0432\\u0438\\u0436\\u0435\\u043d\\u0438\\u0439, \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0432 \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0442\\u044b \\u0441\\u043e\\u0437\\u0434\\u0430\\u0435\\u0448\\u044c \\u0447\\u0442\\u043e-\\u043b\\u0438\\u0431\\u043e \\u0441\\u0430\\u043c\\u0430. \\u042d\\u0442\\u043e \\u0436\\u0435 \\u043a\\u0430\\u0441\\u0430\\u0435\\u0442\\u0441\\u044f \\u0438 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043a \\"\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u043e\\" \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u043d\\u043e\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0435. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0441\\u0435\\u0439\\u0447\\u0430\\u0441 \\u0442\\u0435\\u0431\\u044f \\u0440\\u0430\\u0437\\u0434\\u0440\\u0430\\u0436\\u0430\\u0435\\u0442, \\u043a\\u043e\\u0433\\u0434\\u0430 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u044f\\u0435\\u0442\\u0441\\u044f \\u0431\\u0435\\u0449\\u043e\\u043b\\u0430\\u0431\\u0435\\u0440\\u043d\\u043e. \\u0427\\u0442\\u043e \\u043a\\u0430\\u0441\\u0430\\u0435\\u0442\\u0441\\u044f \\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 - \\u0432\\u0442\\u043e\\u0440\\u043e\\u0435 \\u043d\\u0430\\u0437\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u0438\\u0439 \\u0442\\u0438\\u043f \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0446\\u0438