g><\\/span> \\u0434\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u0447\\u0442\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u0430 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0441 \\u0447\\u0435\\u0442\\u043a\\u0438\\u043c \\u043a\\u0440\\u0443\\u0433\\u043e\\u043c \\u043e\\u0431\\u044f\\u0437\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439 \\u0438 \\u0440\\u0435\\u0433\\u043b\\u0430\\u043c\\u0435\\u043d\\u0442\\u043e\\u043c, \\u0442\\u0440\\u0435\\u0431\\u0443\\u044e\\u0449\\u0430\\u044f \\u0442\\u043e\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438, \\u0430\\u043a\\u043a\\u0443\\u0440\\u0430\\u0442\\u043d\\u043e\\u0441\\u0442\\u0438, \\u0443\\u0441\\u0438\\u0434\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u0438, \\u0441 \\u044f\\u0441\\u043d\\u043e \\u0441\\u0444\\u043e\\u0440\\u043c\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u043c\\u0438 \\u043a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u044f\\u043c\\u0438 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u044f \\u0437\\u0430\\u0434\\u0430\\u0447.&nbsp; \\u041d\\u0430\\u043f\\u0440\\u0438\\u043c\\u0435\\u0440,&nbsp; \\u0441\\u043e\\u0442\\u0440\\u0443\\u0434\\u043d\\u0438\\u043a \\u043e\\u0444\\u0438\\u0441\\u0430, \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0441 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430\\u043c\\u0438, \\u0446\\u0438\\u0444\\u0440\\u0430\\u043c\\u0438, \\u0434\\u0438\\u0430\\u0433\\u0440\\u0430\\u043c\\u043c\\u0430\\u043c\\u0438. \\u041d\\u0443\\u0436\\u043d\\u043e \\u0438\\u043c\\u0435\\u0442\\u044c \\u0432\\u0432\\u0438\\u0434\\u0443, \\u0447\\u0442\\u043e \\u0434\\u043b\\u044f \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0432\\u0430\\u0442\\u044c \\u0430\\u0431\\u0441\\u0442\\u0440\\u0430\\u043a\\u0442\\u043d\\u043e-\\u043b\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435, \\u0432 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043c\\u043e\\u043c\\u0435\\u043d\\u0442 \\u0442\\u0432\\u043e\\u0439 \\u0431\\u0430\\u043b\\u043b \\u0432 \\u044d\\u0442\\u043e\\u0439 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438 \\u043d\\u0435 \\u043e\\u0447\\u0435\\u043d\\u044c \\u0432\\u044b\\u0441\\u043e\\u043a. \\u041c\\u0430\\u0442\\u0435\\u0440\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0431\\u043b\\u0430\\u0433\\u043e\\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0435 \\u0434\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u0432\\u0430\\u0436\\u043d\\u0430\\u044f \\u0432\\u0435\\u0449\\u044c, \\u0442\\u044b \\u0446\\u0435\\u043d\\u0438\\u0448\\u044c \\u043a\\u043e\\u043c\\u0444\\u043e\\u0440\\u0442, \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u0435\\u0441\\u043b\\u0438 \\u0432\\u044b\\u0431\\u0435\\u0440\\u0435\\u0448\\u044c \\u0434\\u0430\\u043d\\u043d\\u0443\\u044e \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u044c \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0443\\u0434\\u0435\\u043b\\u0438\\u0442\\u044c \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430\\u0432\\u044b\\u043a\\u0430\\u043c \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f \\u0430\\u0431\\u0441\\u0442\\u0440\\u0430\\u043a\\u0442\\u043d\\u043e-\\u043b\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0445 \\u0437\\u0430\\u0434\\u0430\\u0447. \\u041a \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u0430\\u043c \\u0434\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f \\u043c\\u043e\\u0436\\u043d\\u043e \\u043e\\u0442\\u043d\\u0435\\u0441\\u0442\\u0438 \\u043e\\u0444\\u0438\\u0441\\u043d\\u044b\\u0445 \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442\\u043e\\u0432, \\u0431\\u0443\\u0445\\u0433\\u0430\\u043b\\u0442\\u0435\\u0440\\u043e\\u0432, \\u0442\\u043e\\u0432\\u0430\\u0440\\u043e\\u0432\\u0435\\u0434\\u043e\\u0432, \\u043b\\u043e\\u0433\\u0438\\u0441\\u0442\\u0438\\u043a\\u043e\\u0432, \\u0445\\u0438\\u043c\\u0438\\u043a\\u043e\\u0432-\\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u043e\\u0432, \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u043e\\u0432 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0441\\u0442\\u0432\\u0430, \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442\\u043e\\u0432 \\u0440\\u0435\\u043c\\u043e\\u043d\\u0442\\u043d\\u044b\\u0445 \\u0440\\u0430\\u0431\\u043e\\u0442, \\u043a\\u043e\\u0440\\u0440\\u0435\\u043a\\u0442\\u043e\\u0440\\u043e\\u0432.<\\/p>\\n<p><strong><span style=\\"color: #f3705c;\\">\\u0421\\u0447\\u0438\\u0442\\u0430\\u0435\\u043c \\u043d\\u0443\\u0436\\u043d\\u044b\\u043c \\u043e\\u0431\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0442\\u043e,<\\/span> <\\/strong>\\u0447\\u0442\\u043e \\u043d\\u0430 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043c\\u043e\\u043c\\u0435\\u043d\\u0442 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e \\u043d\\u0438\\u0437\\u043a\\u0438\\u0435 \\u0431\\u0430\\u043b\\u043b\\u044b \\u043f\\u043e \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c \\u0442\\u0438\\u043f\\u0430\\u043c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f &ndash; \\u0441\\u043b\\u043e\\u0432\\u0435\\u0441\\u043d\\u043e-\\u043b\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435, \\u043d\\u0430\\u0433\\u043b\\u044f\\u0434\\u043d\\u043e-\\u043e\\u0431\\u0440\\u0430\\u0437\\u043d\\u043e\\u0435, \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0435. \\u0421\\u0435\\u0439\\u0447\\u0430\\u0441 \\u0442\\u044b \\u0432 \\u043d\\u0430\\u0447\\u0430\\u043b\\u0435 \\u043f\\u0443\\u0442\\u0438, \\u0435\\u0441\\u043b\\u0438 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c \\u0443\\u0441\\u0438\\u043b\\u0438\\u044f \\u0438 \\u0437\\u0430\\u043d\\u044f\\u0442\\u044c\\u0441\\u044f \\u0441\\u0432\\u043e\\u0438\\u043c \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u0435\\u043c, \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0434\\u043e\\u0441\\u0442\\u0438\\u0447\\u044c \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435\\u0433\\u043e. \\u0412\\u0441\\u0435 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0437\\u0430\\u0432\\u0438\\u0441\\u0435\\u0442\\u044c \\u043e\\u0442 \\u0442\\u0435\\u0431\\u044f, \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u0439 \\u043e \\u0441\\u0432\\u043e\\u0438\\u0445 \\u0446\\u0435\\u043b\\u044f\\u0445. \\u0427\\u0435\\u0433\\u043e \\u0431\\u044b \\u0442\\u044b \\u0445\\u043e\\u0442\\u0435\\u043b \\u0432 \\u0436\\u0438\\u0437\\u043d\\u0438? \\u0427\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u043e? \\u0427\\u0442\\u043e \\u0442\\u0435\\u0431\\u044f \\u043f\\u0440\\u0438\\u0432\\u043b\\u0435\\u043a\\u0430\\u0435\\u0442 \\u0438 \\u043d\\u0430\\u043e\\u0431\\u043e\\u0440\\u043e\\u0442, \\u0447\\u0442\\u043e &ndash; \\u0432\\u043e\\u0442 \\u0432\\u043e\\u043e\\u0431\\u0449\\u0435 \\u043d\\u0435 \\u0442\\u0432\\u043e\\u0435. \\u0415\\u0441\\u0442\\u044c \\u043b\\u0438 \\u043b\\u044e\\u0434\\u0438, \\u043d\\u0430 \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0445 \\u0442\\u044b \\u0431\\u044b \\u0445\\u043e\\u0442\\u0435\\u043b \\u0431\\u044b\\u0442\\u044c \\u043f\\u043e\\u0445\\u043e\\u0436\\u0438\\u043c? \\u0427\\u0442\\u043e \\u0432 \\u043d\\u0438\\u0445 \\u0442\\u0435\\u0431\\u0435 \\u0438\\u043c\\u043f\\u043e\\u043d\\u0438\\u0440\\u0443\\u0435\\u0442, \\u043a\\u0430\\u043a\\u0438\\u0435 \\u043e\\u043d\\u0438? \\u0415\\u0441\\u043b\\u0438 \\u0441\\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442\\u0438\\u0442\\u044c \\u043d\\u0430 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441 \\u0438 \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 \\u0440\\u043e\\u0434\\u0438\\u0442\\u044c\\u0441\\u044f &laquo;\\u0412\\u043e\\u0442, \\u0445\\u043e\\u0447\\u0443 \\u0442\\u0430\\u043a\\u0436\\u0435&raquo; - \\u044d\\u0442\\u043e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0441\\u0442\\u0430\\u0442\\u044c \\u0434\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u043e\\u0433\\u0440\\u043e\\u043c\\u043d\\u044b\\u043c \\u0441\\u0442\\u0438\\u043c\\u0443\\u043b\\u043e\\u043c \\u0438 \\u043f\\u043e\\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u0440\\u0435\\u043e\\u0434\\u043e\\u043b\\u0435\\u0442\\u044c, \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u043b\\u0435\\u043d\\u044c, \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u043e\\u043f\\u0430\\u0441\\u0435\\u043d\\u0438\\u044f, \\u0441\\u0442\\u0440\\u0430\\u0445\\u0438. \\u0415\\u0441\\u043b\\u0438 \\u043d\\u0443\\u0436\\u043d\\u0430 \\u043f\\u043e\\u043c\\u043e\\u0449\\u044c \\u0432 \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0438 \\u0441\\u0435\\u0431\\u044f &ndash; \\u043c\\u044b \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u0433\\u043e\\u0442\\u043e\\u0432\\u044b \\u043f\\u043e\\u043c\\u043e\\u0447\\u044c!<\\/p>\\n<p><span style=\\"color: #2761a0;\\"><strong>\\u0422\\u044b \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u043e\\u0431\\u0449\\u0430\\u0442\\u044c\\u0441\\u044f \\u0441 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438,<\\/strong> <\\/span>\\u0442\\u0435\\u0431\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0431\\u044b\\u0442\\u044c \\u0441 \\u0434\\u0440\\u0443\\u0437\\u044c\\u044f\\u043c\\u0438, \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0442\\u044c \\u043e\\u0434\\u043e\\u0431\\u0440\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u0441\\u0438\\u043c\\u043f\\u0430\\u0442\\u0438\\u0438 \\u0441\\u043e \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f. \\u041c\\u043e\\u0436\\u0435\\u043c \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0443\\u0434\\u0430\\u0435\\u0442\\u0441\\u044f \\u0431\\u044b\\u0442\\u044c \\u044d\\u043c\\u043f\\u0430\\u0442\\u0438\\u0447\\u043d\\u044b\\u043c, \\u0442\\u043e \\u0435\\u0441\\u0442\\u044c \\u0432 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0438\\u043d\\u0441\\u0442\\u0432\\u0435 \\u0441\\u043b\\u0443\\u0447\\u0430\\u0435\\u0432 \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c, \\u0447\\u0442\\u043e \\u043f\\u0440\\u043e\\u0438\\u0441\\u0445\\u043e\\u0434\\u0438\\u0442 \\u0441 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u043e\\u043c, \\u0441 \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u043c \\u0442\\u044b \\u0432 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043c\\u043e\\u043c\\u0435\\u043d\\u0442 \\u043e\\u0431\\u0449\\u0430\\u0435\\u0448\\u044c\\u0441\\u044f. \\u042d\\u0442\\u043e \\u0434\\u0430\\u0435\\u0442 \\u0442\\u0435\\u0431\\u0435 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043f\\u0440\\u0435\\u0438\\u043c\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0430 \\u0432 \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0438 &ndash; \\u043b\\u044e\\u0434\\u0438 \\u0446\\u0435\\u043d\\u044f\\u0442, \\u043a\\u043e\\u0433\\u0434\\u0430 \\u0438\\u0445 \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u044e\\u0442. \\u041a\\u0441\\u0442\\u0430\\u0442\\u0438 \\u044d\\u043c\\u043f\\u0430\\u0442\\u0438\\u044f \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0432\\u0430\\u0436\\u043d\\u0430 \\u0438 \\u043f\\u0440\\u0438 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0435 \\u0441 \\u0436\\u0438\\u0432\\u043e\\u0442\\u043d\\u044b\\u043c\\u0438, \\u043d\\u0430\\u043f\\u0440\\u0438\\u043c\\u0435\\u0440, \\u044d\\u0442\\u043e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0431\\u044b\\u0442\\u044c \\u0434\\u0440\\u0435\\u0441\\u0441\\u0438\\u0440\\u043e\\u0432\\u043a\\u0430 \\u0436\\u0438\\u0432\\u043e\\u0442\\u043d\\u044b\\u0445 \\u0438\\u043b\\u0438 \\u0432\\u0435\\u0442\\u0435\\u0440\\u0438\\u043d\\u0430\\u0440\\u0438\\u044f.<\\/p>\\n<p><span style=\\"color: #2761a0;\\"><strong>\\u0414\\u043b\\u044f \\u043a\\u0430\\u0436\\u0434\\u043e\\u0433\\u043e \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0430 \\u0432\\u0430\\u0436\\u043d\\u043e<\\/strong><\\/span>, \\u0447\\u0442\\u043e\\u0431\\u044b \\u043f\\u0440\\u0438\\u0441\\u043b\\u0443\\u0448\\u0438\\u0432\\u0430\\u043b\\u0438\\u0441\\u044c \\u043a \\u0435\\u0433\\u043e \\u043c\\u043d\\u0435\\u043d\\u0438\\u044e, \\u0443\\u0432\\u0430\\u0436\\u0430\\u043b\\u0438 \\u0435\\u0433\\u043e. \\u0417\\u043d\\u0430\\u0447\\u0438\\u0442, \\u0438 \\u0437\\u0434\\u0435\\u0441\\u044c \\u0432\\u0430\\u0436\\u043d\\u043e &laquo;\\u043f\\u0440\\u043e\\u043a\\u0430\\u0447\\u0438\\u0432\\u0430\\u0442\\u044c&raquo; \\u0441\\u0432\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435. \\u041f\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0439 \\u043d\\u0430\\u0434 \\u0442\\u0430\\u043a\\u0438\\u043c\\u0438 \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430\\u043c\\u0438, \\u043a\\u0430\\u043a \\u0443\\u0441\\u0438\\u0434\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u044c, \\u0441\\u0430\\u043c\\u043e\\u0434\\u0438\\u0441\\u0446\\u0438\\u043f\\u043b\\u0438\\u043d\\u0430, \\u043a\\u043e\\u043d\\u0446\\u0435\\u043d\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u044f, \\u0443\\u043c\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e\\u0436\\u0435\\u0440\\u0442\\u0432\\u043e\\u0432\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u0438\\u043c\\u0438 \\u0441\\u0438\\u044e\\u043c\\u0438\\u043d\\u0443\\u0442\\u043d\\u044b\\u043c\\u0438 \\u0443\\u0434\\u043e\\u0432\\u043e\\u043b\\u044c\\u0441\\u0442\\u0432\\u0438\\u044f\\u043c\\u0438 &nbsp;\\u0440\\u0430\\u0434\\u0438 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0435\\u043d\\u0438\\u044f \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u0435\\u0440\\u044c\\u0435\\u0437\\u043d\\u044b\\u0445 \\u0438 \\u0432\\u0430\\u0436\\u043d\\u044b\\u0445 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u0432 \\u0432 \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u043c. \\u0421\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0441\\u0444\\u0435\\u0440\\u0430 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c \\u0442\\u0435\\u0431\\u0435 \\u0442\\u0430\\u043a\\u0438\\u0435 \\u044f\\u0440\\u043a\\u0438\\u0435 \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u044b \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439, \\u043a\\u0430\\u043a \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b\\u0438\\u0441\\u0442\\u044b, \\u0434\\u0438-\\u0434\\u0436\\u0435\\u0438, \\u0442\\u0435\\u043b\\u0435- \\u0438 \\u0440\\u0430\\u0434\\u0438\\u043e\\u0432\\u0435\\u0434\\u0443\\u0449\\u0438\\u0435, \\u043f\\u0438\\u0430\\u0440-\\u043c\\u0435\\u043d\\u0435\\u0434\\u0436\\u0435\\u0440\\u044b, \\u043c\\u0430\\u0440\\u043a\\u0435\\u0442\\u043e\\u043b\\u043e\\u0433\\u0438. \\u0422\\u0435\\u043c \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0447\\u0442\\u043e \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0435\\u0441\\u0442\\u044c \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u0430\\u044f \\u043f\\u0440\\u0435\\u0434\\u0440\\u0430\\u0441\\u043f\\u043e\\u043b\\u043e\\u0436\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a \\u0441\\u0444\\u0435\\u0440\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0442\\u0435\\u043b\\u044c\\u0441\\u0442\\u0432\\u0430, \\u0433\\u0434\\u0435 \\u0432\\u0430\\u0436\\u043d\\u044b \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0442\\u043e\\u0440\\u0441\\u043a\\u0438\\u0435 \\u043d\\u0430\\u0432\\u044b\\u043a\\u0438. \\u0422\\u044b \\u0446\\u0435\\u043d\\u0438\\u0448\\u044c \\u0438\\u043d\\u0438\\u0446\\u0438\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c, \\u044d\\u043d\\u0435\\u0440\\u0433\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0438\\u043d\\u043e\\u0433\\u0434\\u0430 \\u0433\\u043e\\u0442\\u043e\\u0432 \\u0440\\u0438\\u0441\\u043a\\u043d\\u0443\\u0442\\u044c \\u0438 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044c \\u0441\\u0430\\u043c\\u043e\\u0441\\u0442\\u043e\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435. \\u0421\\u0443\\u0434\\u044f \\u043f\\u043e \\u0442\\u0435\\u0441\\u0442\\u0430\\u043c, \\u0442\\u044b \\u0431\\u044b \\u0445\\u043e\\u0442\\u0435\\u043b \\u0431\\u044b\\u0442\\u044c \\u0441\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c, \\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u044b\\u043c \\u0438 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u043d\\u044b\\u043c \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u043e\\u043c, \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u044b\\u043c \\u0432\\u043b\\u0438\\u044f\\u0442\\u044c \\u043d\\u0430 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445.&nbsp; \\u0422\\u0438\\u043f\\u0438\\u0447\\u043d\\u044b\\u0435 \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044f \\u0434\\u043b\\u044f \\u0442\\u0430\\u043a\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439 - \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0446\\u0438\\u044f \\u0440\\u0430\\u0437\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044f \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445, \\u043f\\u043e\\u0441\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0431\\u0449\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0445 \\u043c\\u0435\\u0440\\u043e\\u043f\\u0440\\u0438\\u044f\\u0442\\u0438\\u0439, \\u0441\\u043e\\u0431\\u0440\\u0430\\u043d\\u0438\\u0439, \\u0434\\u043e\\u0431\\u0440\\u043e\\u0432\\u043e\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u0435 \\u0431\\u043b\\u0430\\u0433\\u043e\\u0442\\u0432\\u043e\\u0440\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0438 \\u0441\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b. \\u0415\\u0441\\u043b\\u0438 \\u0447\\u0442\\u043e-\\u0442\\u043e \\u043e\\u0442\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f, \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0435\\u0441\\u0442\\u044c, \\u043e\\u0441\\u0442\\u0430\\u0435\\u0442\\u0441\\u044f \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u043d\\u0430\\u0434 \\u044d\\u0440\\u0443\\u0434\\u0438\\u0446\\u0438\\u0435\\u0439, \\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442\\u043e\\u043c \\u0438, \\u043a\\u0430\\u043a \\u0441\\u043b\\u0435\\u0434\\u0441\\u0442\\u0432\\u0438\\u0435, \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0432 \\u0441\\u0435\\u0431\\u0435. &nbsp;\\u041c\\u043e\\u0436\\u0435\\u043c \\u043f\\u043e\\u0434\\u0441\\u043a\\u0430\\u0437\\u0430\\u0442\\u044c \\u044d\\u0444\\u0444\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u044b\\u0435 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u044b!<\\/p>"}	2021-01-25 11:39:53	2021-01-25 11:39:53
