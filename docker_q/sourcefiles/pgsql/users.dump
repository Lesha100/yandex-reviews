3c\\u043e\\u0433\\u0443\\u0442 \\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u044c\\u0441\\u044f \\u043d\\u0435\\u0432\\u043e\\u0441\\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u043c\\u0438 \\u0438\\u043b\\u0438 \\u043c\\u0430\\u043b\\u043e\\u043e\\u043f\\u043b\\u0430\\u0447\\u0438\\u0432\\u0430\\u0435\\u043c\\u044b\\u043c\\u0438. \\u041f\\u0440\\u0435\\u0434\\u0443\\u0433\\u0430\\u0434\\u0430\\u0442\\u044c \\u0442\\u0430\\u043a\\u0438\\u0435 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f \\u043d\\u0435\\u043b\\u0435\\u0433\\u043a\\u043e. \\u0412\\u043e\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0439\\u0441\\u044f \\u0430\\u0442\\u043b\\u0430\\u0441\\u043e\\u043c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 https:\\/\\/atlas100.ru\\/upload\\/pdf_files\\/atlas.pdf&nbsp;&nbsp;- \\u044d\\u0442\\u043e \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u0439, \\u0431\\u0435\\u0441\\u043f\\u043b\\u0430\\u0442\\u043d\\u044b\\u0439 \\u0440\\u0435\\u0441\\u0443\\u0440\\u0441. \\u0422\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043e\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u0438\\u0442\\u044c\\u0441\\u044f \\u0441 \\u0446\\u0438\\u0444\\u0440\\u043e\\u0432\\u043e\\u0439 \\u0432\\u0435\\u0440\\u0441\\u0438\\u0435\\u0439 \\u0430\\u0442\\u043b\\u0430\\u0441\\u0430 \\u0438 \\u043f\\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u0442\\u044c, \\u043a\\u0430\\u043a\\u0438\\u0435 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u0438\\u0437\\u043e\\u0439\\u0434\\u0443\\u0442 \\u0441 \\u043c\\u0438\\u0440\\u043e\\u043c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u0432 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u043c (\\u0438 \\u043d\\u0435 \\u0441\\u043e\\u0432\\u0441\\u0435\\u043c) \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u043c. \\u0422\\u044b \\u043d\\u0435 \\u043e\\u0431\\u044f\\u0437\\u0430\\u043d \\u0432\\u044b\\u0431\\u0