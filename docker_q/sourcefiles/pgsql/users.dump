u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0439 \\u0438 \\u0444\\u043e\\u0440\\u043c\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439, \\u0433\\u0434\\u0435 \\u0446\\u0435\\u043d\\u0438\\u0442\\u0441\\u044f \\u043f\\u043e\\u043b\\u0435\\u0442 \\u0444\\u0430\\u043d\\u0442\\u0430\\u0437\\u0438\\u0438, \\u0432\\u043e\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u0438\\u0435, \\u0433\\u0434\\u0435 \\u0432\\u0430\\u0436\\u043d\\u043e \\u0438\\u043c\\u0435\\u0442\\u044c \\u0432\\u043a\\u0443\\u0441 \\u0438 \\u0442\\u0430\\u043b\\u0430\\u043d\\u0442 &ndash; \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0439, \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043d\\u044b\\u0439, \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439. &nbsp;\\u041e\\u0431\\u0440\\u0430\\u0442\\u0438 \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0442\\u0438\\u043f\\u0438\\u0447\\u043d\\u044b\\u0435 \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044f &laquo;\\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u0449\\u0438\\u043a\\u043e\\u0432&raquo; - \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\\u0438\\u044f, \\u043a\\u0438\\u043d\\u043e, \\u0442\\u0435\\u0430\\u0442\\u0440, \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435, \\u0442\\u0430\\u043d\\u0446\\u0435\\u0432\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435, \\u0438\\u0437\\u043e\\u0431\\u0440\\u0430\\u0437\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e, \\u0430 \\u0442\\u0430\\u043a\\u0436\\u0435 &ndash; &nbsp;\\u043c\\u043e\\u0434\\u0435\\u043b\\u044c\\u043d\\u0430\\u044f \\u0438\\u043d\\u0434\\u0443\\u0441\\u0442\\u0440\\u0438\\u044f, \\u0441\\u0444\\u0435\\u0440\\u0430 \\u043a\\u0440\\u0430\\u0441\\u043e\\u0442\\u044b, \\u0440\\u0435\\u043a\\u043b\\u0430\\u043c\\u043d\\u044b\\u0439 \\u0431\\u0438\\u0437\\u043d\\u0435\\u0441.<\\/p>\\n<p><span style=\\"color: #2761a0;\\">\\u041a\\u0440\\u043e\\u043c\\u0435 \\u0442\\u043e\\u0433\\u043e,<\\/span> \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0448\\u0438\\u043a\\u0430\\u0440\\u043d\\u044b\\u0439 \\u043d\\u0430\\u0431\\u043e\\u0440 \\u043f\\u0440\\u0435\\u0438\\u043c\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432. \\u041d\\u0430\\u0440\\u044f\\u0434\\u0443 \\u0441 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0442\\u044b \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u0435\\u0448\\u044c \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u043a \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438, \\u043f\\u0440\\u0438\\u043d\\u043e\\u0441\\u044f\\u0449\\u0435\\u0439 \\u0440\\u0435\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b, \\u0442\\u0440\\u0435\\u0431\\u0443\\u044e\\u0449\\u0435\\u0439 \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0433\\u043e \\u0441\\u043a\\u043b\\u0430\\u0434\\u0430 \\u0443\\u043c\\u0430 \\u0438 \\u0445\\u043e\\u0440\\u043e\\u0448\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u044b\\u0445 \\u0434\\u0432\\u0438\\u0433\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u043d\\u0430\\u0432\\u044b\\u043a\\u043e\\u0432. \\u0422\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u0443\\u0435\\u0442 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e-\\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\