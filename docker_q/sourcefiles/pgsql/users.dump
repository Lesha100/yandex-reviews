\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0432\\u0445\\u043e\\u0434\\u0438\\u0442, \\u0432 \\u043f\\u0435\\u0440\\u0432\\u0443\\u044e \\u043e\\u0447\\u0435\\u0440\\u0435\\u0434\\u044c, \\u0441\\u043e\\u0437\\u0434\\u0430\\u043d\\u0438\\u0435 \\u0438\\u0434\\u0435\\u0438 \\u0437\\u0434\\u0430\\u043d\\u0438\\u044f \\u0438 \\u0432\\u0438\\u0437\\u0443\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u044f \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0430 \\u0432 \\u0432\\u0438\\u0434\\u0435 \\u043c\\u0430\\u043a\\u0435\\u0442\\u0430. \\u041e\\u043d \\u043f\\u0440\\u043e\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442 \\u0432 \\u0434\\u0435\\u0442\\u0430\\u043b\\u044f\\u0445 \\u0432 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0435 \\u0441 \\u0438\\u043d\\u0436\\u0435\\u043d\\u0435\\u0440\\u0430\\u043c\\u0438-\\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0438\\u0440\\u043e\\u0432\\u0449\\u0438\\u043a\\u0430\\u043c\\u0438, \\u0441\\u043c\\u0435\\u0436\\u043d\\u0438\\u043a\\u0430\\u043c\\u0438, \\u044d\\u043a\\u043e\\u043d\\u043e\\u043c\\u0438\\u0441\\u0442\\u0430\\u043c\\u0438. \\u041a\\u0430\\u0436\\u0434\\u043e\\u0435 \\u0437\\u0434\\u0430\\u043d\\u0438\\u0435 \\u0434\\u043e\\u043b\\u0436\\u043d\\u043e \\u0441\\u043e\\u0447\\u0435\\u0442\\u0430\\u0442\\u044c \\u043a\\u0440\\u0430\\u0441\\u043e\\u0442\\u0443, \\u0443\\u0434\\u043e\\u0431\\u0441\\u0442\\u0432\\u043e \\u0438 \\u0432\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f \\u0432 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0430\\u044e\\u0449\\u0443\\u044e \\u0441\\u0440\\u0435\\u0434\\u0443. \\u041a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0446\\u0438\\u044e \\u0437\\u0434\\u0430\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0438\\u043c\\u0435\\u043d\\u043d\\u043e \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440.&nbsp;\\u0412 \\u0434\\u0430\\u043b\\u044c\\u043d\\u0