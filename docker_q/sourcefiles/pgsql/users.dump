9\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u0442\\u044c \\u0432 \\u0440\\u0430\\u043c\\u043a\\u0430\\u0445 \\u0436\\u0435\\u0441\\u0442\\u043a\\u0438\\u0445 \\u0440\\u0435\\u0433\\u043b\\u0430\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432. \\u0422\\u044b \\u0438 \\u0441\\u0430\\u043c\\u0430 \\u0437\\u043d\\u0430\\u0435\\u0448\\u044c \\u043f\\u0440\\u0438\\u0447\\u0438\\u043d\\u0443 - \\u043a\\u043e\\u0433\\u0434\\u0430 \\u0440\\u0435\\u0433\\u043b\\u0430\\u043c\\u0435\\u043d\\u0442 \\u0431\\u0435\\u0437\\u043e\\u043b\\u0430\\u0431\\u0435\\u0440\\u043d\\u044b\\u0439, \\u0435\\u043c\\u0443 \\u043d\\u0435 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f \\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u044c.&nbsp;<\\/span><\\/span><\\/p>\\n<p class=\\"small-report__heading heading-a\\"><span style=\\"color: #2761a0;\\"><span style=\\"color: #000000;\\"><span style=\\"color: #2761a0;\\"><strong>\\u041e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438.<\\/strong> <\\/span>\\u0422\\u0435\\u0431\\u0435 \\u0438\\u043c\\u043f\\u043e\\u043d\\u0438\\u0440\\u0443\\u0435\\u0442 \\u0441\\u0444\\u0435\\u0440\\u0430 \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u0430, \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0441 \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u043e\\u0439 \\u0438 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u0438\\u043b\\u0438 \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u044f\\u0437\\u044b\\u043a\\u0438 (\\u0442\\u0430\\u0431\\u043b\\u0438\\u0447\\u043a\\u0438-\\u0442\\u0430\\u0431\\u043b\\u0438\\u0447\\u043a\\u0438). \\u042d\\u0442\\u043e \\u0437\\u043e\\u043d\\u0430 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u0430. \\u042f \\u0431\\u044b \\u