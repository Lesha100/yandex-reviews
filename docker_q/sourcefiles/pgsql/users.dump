33222	1	admin/users/report/edit/290/comment	POST	77.238.236.109	{"recommendations":"<p>\\u0421\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442 \\u0434\\u0432\\u0430 \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u0430 \\u043a \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u043c\\u0443 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0443. \\u041f\\u0435\\u0440\\u0432\\u044b\\u0439, \\u043a\\u043b\\u0430\\u0441\\u0441\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440 - \\u0443 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430 \\u0445\\u043e\\u0440\\u043e\\u0448\\u0438\\u0435 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438 \\u043f\\u043e \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u0435, \\u0438 \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u043e\\u043d \\u043f\\u043e\\u0441\\u0442\\u0443\\u043f\\u0430\\u0435\\u0442 \\u043d\\u0430 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 &laquo;\\u0436\\u0443\\u0440\\u043d\\u0430\\u043b\\u0438\\u0441\\u0442\\u0438\\u043a\\u0430&raquo;, \\u0438\\u043b\\u0438 \\u0443 \\u043d\\u0435\\u0433\\u043e \\u0445\\u043e\\u0440\\u043e\\u0448\\u0438\\u0435 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438 \\u043f\\u043e \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0435, \\u043e\\u043d \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0443\\u0447\\u0438\\u0442\\u044c\\u0441\\u044f \\u043d\\u0430 \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0422\\u043e \\u0435\\u0441\\u0442\\u044c \\u0440\\u0435\\u0431\\u0435\\u043d\\u043e\\u043a \\u0434\\u0432\\u0438\\u0433\\u0430\\u0435\\u0442\\u0441\\u044f \\u0432 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0435 \\u043e\\u0442 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u043b\\u0443\\u0447\\u0448\\u0435 \\u0438\\u043b\\u0438 \\u0447\\u0442\\u043e \\u0434\\u0430\\u0435\\u0442\\u0441\\u044f \\u043b\\u0435\\u0433\\u0447\\u0435. \\u042d\\u0442\\u043e \\u0440\\u0430\\u0441\\u043f\\u0440\\u043e\\u0441\\u0442\\u0440\\u0430\\u043d\\u0435\\u043d\\u043d\\u044b\\u0439 \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440, \\u0431\\u043e\\u043b\\u044c\\u0448\\u0438\\u043d\\u0441\\u0442\\u0432\\u043e \\u043c\\u043e\\u043b\\u043e\\u0434\\u044b\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439 \\u0441\\u043e\\u0432\\u0435\\u0440\\u0448\\u0430\\u044e\\u0442 \\u0441\\u0432\\u043e\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 \\u0438\\u043c\\u0435\\u043d\\u043d\\u043e \\u043d\\u0430 \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0438 \\u0443\\u0440\\u043e\\u0432\\u043d\\u044f \\u0448\\u043a\\u043e\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0443\\u0441\\u043f\\u0435\\u0432\\u0430\\u0435\\u043c\\u043e\\u0441\\u0442\\u0438.&nbsp;<\\/p>\\n<p>\\u0412\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u043b\\u043e\\u0436\\u043d\\u044b\\u0439, \\u043d\\u043e \\u043f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b\\u0439 &ndash; \\u0440\\u0435\\u0431\\u0435\\u043d\\u043e\\u043a \\u043e\\u043f\\u0438\\u0440\\u0430\\u0435\\u0442\\u0441\\u044f \\u043d\\u0430 \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0435\\u043c\\u0443 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0438 \\u043d\\u0430 \\u0442\\u043e, \\u0447\\u0435\\u0433\\u043e \\u0435\\u043c\\u0443 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f. \\u0415\\u0441\\u043b\\u0438 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043e\\u043a \\u043c\\u0435\\u0447\\u0442\\u0430\\u0435\\u0442 \\u0441\\u0442\\u0430\\u0442\\u044c \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u043e\\u043c, \\u043d\\u043e \\u043f\\u0440\\u0438 \\u044d\\u0442\\u043e\\u043c \\u043f\\u043e \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0435 \\u0443 \\u043d\\u0435\\u0433\\u043e \\"\\u0442\\u0432\\u0435\\u0440\\u0434\\u0430\\u044f \\u0434\\u0432\\u043e\\u0439\\u043a\\u0430\\", \\u0442\\u043e, \\u043a\\u043e\\u043d\\u0435\\u0447\\u043d\\u043e, \\u0435\\u043c\\u0443 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442\\u0441\\u044f \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0443\\u0441\\u0438\\u043b\\u0438\\u0439. \\u041d\\u043e \\u0443\\u0441\\u0438\\u043b\\u0438\\u044f \\u043f\\u0440\\u0438\\u043a\\u043b\\u0430\\u0434\\u044b\\u0432\\u0430\\u0442\\u044c \\u043f\\u0440\\u043e\\u0449\\u0435, \\u0430 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u043b\\u0443\\u0447\\u0448\\u0435, \\u043a\\u043e\\u0433\\u0434\\u0430 \\u043d\\u0430\\u043c \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0442\\u043e, \\u0447\\u0442\\u043e \\u043c\\u044b \\u0434\\u0435\\u043b\\u0430\\u0435\\u043c? \\u0412\\u0435\\u0440\\u043d\\u043e?&nbsp;<\\/p>\\n<p>\\u0412 \\u043b\\u044e\\u0431\\u043e\\u043c \\u0441\\u043b\\u0443\\u0447\\u0430\\u0435 &ndash; \\u043f\\u0440\\u0438 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u0441\\u0430\\u043c\\u043e\\u0435 \\u043f\\u0435\\u0440\\u0432\\u043e\\u0435, \\u0447\\u0442\\u043e \\u043d\\u0443\\u0436\\u043d\\u043e \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c &ndash; \\u043d\\u0430\\u0439\\u0442\\u0438 \\u0438 \\u043f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0442\\u044c \\u0441\\u0442\\u0430\\u0442\\u044c\\u0438 \\u043e \\u0442\\u043e\\u043c, \\u0430 \\u0447\\u0435\\u043c, \\u0441\\u043e\\u0431\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e, \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442\\u0441\\u044f \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442 \\u0432 \\u044d\\u0442\\u043e\\u0439 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438. \\u0427\\u0442\\u043e &laquo;\\u043d\\u0430\\u0442\\u0443\\u0440\\u0430\\u043b\\u044c\\u043d\\u043e&raquo; \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442 \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433? \\u041a\\u0430\\u043a\\u043e\\u0439 \\u0435\\u0433\\u043e \\u0440\\u0430\\u0431\\u043e\\u0447\\u0438\\u0439 \\u0434\\u0435\\u043d\\u044c? \\u0427\\u0435\\u043c \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442\\u0441\\u044f \\u043f\\u043e\\u0432\\u0430\\u0440? \\u041a\\u0430\\u043a \\u0432\\u044b\\u0433\\u043b\\u044f\\u0434\\u0438\\u0442 \\u0440\\u0430\\u0431\\u043e\\u0447\\u0438\\u0439 \\u0434\\u0435\\u043d\\u044c \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0441\\u0442\\u0430?&nbsp;<\\/p>\\n<p>\\u041b\\u044e\\u0431\\u0430\\u044f \\u043d\\u043e\\u0432\\u0430\\u044f \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044f \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043c\\u0435\\u043d\\u044f\\u0442\\u044c \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430 \\u0432 \\u0442\\u0443 \\u0438\\u043b\\u0438 \\u0438\\u043d\\u0443\\u044e \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0443. \\u041d\\u043e \\u0432 \\u0446\\u0435\\u043b\\u043e\\u043c - \\u043f\\u043e\\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044c \\u0432\\u0435\\u0440\\u043d\\u043e\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435.&nbsp;<\\/p>","name":null,"post":null,"comment":null}	2021-08-02 13:50:45	2021-08-02 13:50:45
