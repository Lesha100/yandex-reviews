u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043a \\u043d\\u0435\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u044b\\u043c \\u0438\\u043b\\u0438 \\u043d\\u0435\\u0431\\u043b\\u0438\\u0437\\u043a\\u0438\\u043c \\u043b\\u044e\\u0434\\u044f\\u043c. \\u0421 \\u043f\\u043e\\u0441\\u043b\\u0435\\u0434\\u043d\\u0435\\u0439 \\u043a\\u0430\\u0442\\u0435\\u0433\\u043e\\u0440\\u0438\\u0435\\u0439 \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0431\\u044b\\u0442\\u044c, \\u043d\\u0430\\u043f\\u0440\\u043e\\u0442\\u0438\\u0432, \\u0443\\u043f\\u0440\\u044f\\u043c\\u043e\\u0439, \\u0438\\u043d\\u043e\\u0433\\u0434\\u0430 \\u0438\\u043c\\u043f\\u0443\\u043b\\u044c\\u0441\\u0438\\u0432\\u043d\\u043e\\u0439, \\u0438\\u0441\\u043f\\u044b\\u0442\\u044b\\u0432\\u0430\\u0442\\u044c \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u0435 \\u0441\\u0430\\u043c\\u043e\\u0443\\u0442\\u0432\\u0435\\u0440\\u0434\\u0438\\u0442\\u044c\\u0441\\u044f \\u0438 \\u043e\\u0442\\u0441\\u0442\\u043e\\u044f\\u0442\\u044c \\u0441\\u0432\\u043e\\u0435 \\u043c\\u043d\\u0435\\u043d\\u0438\\u0435, \\u043d\\u0435 \\u043e\\u0447\\u0435\\u043d\\u044c \\u043e\\u0431\\u0440\\u0430\\u0449\\u0430\\u044f \\u043d\\u0430 \\u0438\\u0445 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u044b \\u0438 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438. &nbsp;<\\/p>\\n<p><span style=\\"color: #2761a0;\\">\\u0412\\u0441\\u0435 \\u0432\\u044b\\u0448\\u0435\\u043f\\u0435\\u0440\\u0435\\u0447\\u0438\\u0441\\u043b\\u0435\\u043d\\u043d\\u043e\\u0435<\\/span> \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0442\\u044c \\u0432 \\u0442\\u0435\\u0431\\u0435 \\u0441\\u043b\\u0438\\u0448\\u043a\\u043e\\u043c \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c \\u0442\\u0440\\u0435\\u0432\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u043d\\u0430\\u043f\\u0440\\u044f\\u0436\\u0435\\u043d\\