435\\u043d\\u0435\\u043d\\u0438\\u0439 \\u0432 \\u0440\\u0430\\u0431\\u043e\\u0447\\u0438\\u0445 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441\\u0430\\u0445. \\u0415\\u0441\\u043b\\u0438 \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u043e, \\u0442\\u043e \\u043f\\u043e\\u0434\\u043e\\u0439\\u0434\\u0443\\u0442 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438: \\u0434\\u0438\\u0441\\u043f\\u0435\\u0442\\u0447\\u0435\\u0440\\u044b, \\u0430\\u0432\\u0442\\u043e\\u043c\\u0435\\u0445\\u0430\\u043d\\u0438\\u043a\\u0438, \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0441\\u0442\\u044b, \\u0442\\u0440\\u0435\\u043d\\u0435\\u0440\\u044b \\u0432 \\u0441\\u043f\\u043e\\u0440\\u0442\\u0435, \\u043a\\u0438\\u043d\\u043e\\u043e\\u043f\\u0435\\u0440\\u0430\\u0442\\u043e\\u0440\\u044b, \\u0437\\u0432\\u0443\\u043a\\u043e\\u0440\\u0435\\u0436\\u0438\\u0441\\u0441\\u0435\\u0440\\u044b, \\u043e\\u043f\\u0435\\u0440\\u0430\\u0442\\u043e\\u0440\\u044b \\u041f\\u041a, \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u0438, \\u044e\\u0432\\u0435\\u043b\\u0438\\u0440\\u044b, \\u0438\\u043d\\u0436\\u0435\\u043d\\u0435\\u0440\\u044b, \\u043c\\u043e\\u0440\\u044f\\u043a\\u0438, \\u0444\\u0435\\u0440\\u043c\\u0435\\u0440\\u044b, \\u043f\\u043e\\u0432\\u0430\\u0440\\u0430, \\u0441\\u0430\\u0434\\u043e\\u0432\\u043e\\u0434\\u044b, \\u043f\\u0438\\u043b\\u043e\\u0442\\u044b, \\u0441\\u0442\\u043e\\u043c\\u0430\\u0442\\u043e\\u043b\\u043e\\u0433\\u0438, \\u0444\\u043e\\u0442\\u043e\\u043a\\u043e\\u0440\\u0440\\u0435\\u0441\\u043f\\u043e\\u043d\\u0434\\u0435\\u043d\\u0442\\u044b, \\u0432\\u0440\\u0430\\u0447\\u0438, \\u044d\\u043a\\u043e\\u043d\\u043e\\u043c\\u0438\\u0441\\u0442\\u044b, \\u0431\\u0443\\u0445\\u0433\\u0430\\u043b\\u0442\\u0435\\u0440\\u044b, \\u0444\\u0438\\u043d\\u0430\\u043d\\u0441\\u0438\\u0441\\u0442\\u044b, \\u044d\\u043a\\u043e\\u043d\\u043e\\u043c\\u0438\\u0441\\u0442\\u044b