\u0441\\u044f \\u043d\\u0430 \\u0441\\u043e\\u0431\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0445 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430\\u0445. \\u0412 \\u0441\\u0435\\u043c\\u044c\\u0435 \\u0446\\u0430\\u0440\\u0438\\u0442 \\u0430\\u0442\\u043c\\u043e\\u0441\\u0444\\u0435\\u0440\\u0430 \\u0442\\u0435\\u043f\\u043b\\u0430 \\u0438 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u0438\\u044f \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430 \\u0441\\u043e \\u0432\\u0441\\u0435\\u043c\\u0438 \\u0435\\u0433\\u043e \\u043f\\u043b\\u044e\\u0441\\u0430\\u043c\\u0438 \\u0438 \\u043c\\u0438\\u043d\\u0443\\u0441\\u0430\\u043c\\u0438, \\u044d\\u043c\\u043e\\u0446\\u0438\\u044f\\u043c\\u0438 \\u0438 \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u043d\\u0438\\u044f\\u043c\\u0438. \\u0420\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u0438 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b \\u0434\\u043b\\u044f \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u044f \\u0441 \\u0434\\u0435\\u0442\\u044c\\u043c\\u0438.<\\/p>\\n<p>\\u041f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043f\\u043e\\u043b\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0434\\u043e\\u0432\\u0435\\u0440\\u044f\\u044f \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0443, \\u0440\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u0438 \\u0441\\u043d\\u0438\\u043c\\u0430\\u044e\\u0442 \\u0441 \\u0441\\u0435\\u0431\\u044f \\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0437\\u0430 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442. \\u0420\\u0435\\u0431\\u0435\\u043d\\u043a\\u0443 \\u043c\\u043e\\u0436\\u043d\\u043e \\u043c\\u043d\\u043e\\u0433\\u043e\\u0435, \\u0447\\u0435\\u0433\\u043e \\u043d\\u0435 \\u0434\\u043e\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f \\u0432 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u0441\\u0435\\u043c\\u044c\\u044f\\u0445. \\u041f\\u043e \\u043c\\u043d\\u0435\\