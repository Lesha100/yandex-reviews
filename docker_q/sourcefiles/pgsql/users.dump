43e\\u0432. \\u0418, \\u0434\\u0430 - \\u0445\\u043e\\u0440\\u043e\\u0448\\u0438\\u0435 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438 \\u043f\\u043e \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e\\u0439 \\u0434\\u0438\\u0441\\u0446\\u0438\\u043f\\u043b\\u0438\\u043d\\u0435 \\u043d\\u0435 \\u0440\\u0430\\u0432\\u043d\\u044b \\u0432\\u044b\\u0441\\u043e\\u043a\\u043e\\u043c\\u0443 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u0438\\u0437\\u043c\\u0443 \\u0438 \\u0434\\u0430\\u0436\\u0435 \\u043d\\u0435 \\u044f\\u0432\\u043b\\u044f\\u044e\\u0442\\u0441\\u044f \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435\\u043c \\u0434\\u043b\\u044f \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438.<\\/li>\\n<li>\\u041d\\u0430\\u0448\\u0438 \\u0440\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u0438 \\u0436\\u0438\\u043b\\u0438 \\u0432 \\u0434\\u0440\\u0443\\u0433\\u043e\\u043c \\u043c\\u0438\\u0440\\u0435. \\u0421\\u0442\\u0430\\u0440\\u0448\\u0435\\u0435 \\u043f\\u043e\\u043a\\u043e\\u043b\\u0435\\u043d\\u0438\\u0435 \\u043c\\u043e\\u0433\\u043b\\u043e \\u043c\\u0435\\u043d\\u044f\\u0442\\u044c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e \\u043e\\u0442 3 \\u0434\\u043e 5 \\u0440\\u0430\\u0437 \\u0437\\u0430 \\u0436\\u0438\\u0437\\u043d\\u044c. \\u0418\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 &laquo;\\u0412\\u044b\\u0441\\u0448\\u0435\\u0439 \\u0448\\u043a\\u043e\\u043b\\u044b \\u044d\\u043a\\u043e\\u043d\\u043e\\u043c\\u0438\\u043a\\u0438&raquo; \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043b\\u043e, \\u0447\\u0442\\u043e \\u0432\\u044b \\u0438 \\u0432\\u0430\\u0448\\u0438 \\u0441\\u0432\\u0435\\u0440\\u0441\\u0442\\u043d\\u0438\\u043a\\u0438 \\u0443\\u0441\\u043f\\u0435\\u044e\\u0442 \\u043f\\u043e\\u043c\\u0435\\u043d\\u044f\\u0442\\u044c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e \\u043e\\u0442 10 \\u0434\\u043e 15 \\u0440\\u0430\\u0437 \\u0437\\u0430 \\u0436\\u0438\\u0437\\u043d\\u044c. \\u0418 \\u044d\\u0442\\u043e \\u043f\\u0440\\u0438 \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0431\\u0443\\u0434\\u0443\\u0442 \\u043f\\u0440\\u043e\\u0438\\u0441\\u0445\\u043e\\u0434\\u0438\\u0442\\u044c \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 \\u0441\\u0444\\u0435\\u0440\\u044b, \\u043d\\u043e \\u0438 \\u043c\\u0435\\u0436\\u0434\\u0443 \\u043e\\u0442\\u0440\\u0430\\u0441\\u043b\\u044f\\u043c\\u0438. \\u041e\\u0447\\u0435\\u043d\\u044c \\u0441\\u043a\\u043e\\u0440\\u043e \\u0432\\u044b\\u0439\\u0434\\u0435\\u0442 \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0430\\u0442\\u043b\\u0430\\u0441 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u0433\\u043e, \\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043d\\u043d\\u044b\\u0439 &laquo;\\u0410\\u0433\\u0435\\u043d\\u0442\\u0441\\u0442\\u0432\\u043e\\u043c \\u0441\\u0442\\u0440\\u0430\\u0442\\u0435\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0445 \\u0438\\u043d\\u0438\\u0446\\u0438\\u0430\\u0442\\u0438\\u0432&raquo;. \\u042d\\u0442\\u043e \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u0439, \\u0431\\u0435\\u0441\\u043f\\u043b\\u0430\\u0442\\u043d\\u044b\\u0439 \\u0440\\u0435\\u0441\\u0443\\u0440\\u0441. \\u041f\\u043e\\u043a\\u0430 \\u043c\\u044b \\u0436\\u0434\\u0435\\u043c \\u043d\\u043e\\u0432\\u043e\\u0433\\u043e, \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043e\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u0438\\u0442\\u044c\\u0441\\u044f \\u0441 \\u0432\\u0435\\u0440\\u0441\\u0438\\u0435\\u0439 2014 \\u0433\\u043e\\u0434\\u0430 \\u0438 \\u043f\\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u0442\\u044c, \\u043a\\u0430\\u043a\\u0438\\u0435 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f \\u0441\\u043b\\u0443\\u0447\\u0430\\u0442\\u0441\\u044f \\u0441 \\u043c\\u0438\\u0440\\u043e\\u043c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u0432 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u043c (\\u0438 \\u043d\\u0435 \\u0441\\u043e\\u0432\\u0441\\u0435\\u043c) \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u043c.&nbsp;<a href=\\"http:\\/\\/atlas100.ru\\/\\">http:\\/\\/atlas100.ru<\\/a><\\/li>\\n<li>\\u0425\\u043e\\u0440\\u043e\\u0448\\u043e, \\u0435\\u0441\\u043b\\u0438 \\u0442\\u0435\\u0431\\u044f \\u043f\\u043e\\u0434\\u0434\\u0435\\u0440\\u0436\\u0438\\u0432\\u0430\\u044e\\u0442 \\u0432 \\u0443\\u0441\\u0442\\u0440\\u0435\\u043c\\u043b\\u0435\\u043d\\u0438\\u044f\\u0445. \\u0410 \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0435\\u0442, \\u0442\\u043e&hellip; \\u0421\\u0430\\u043c\\u043e\\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0435 &mdash; \\u044d\\u0442\\u043e \\u043d\\u0430\\u0448\\u0430 \\u0432\\u043d\\u0443\\u0442\\u0440\\u0435\\u043d\\u043d\\u044f\\u044f \\u0437\\u0430\\u0434\\u0430\\u0447\\u0430, \\u044d\\u0442\\u043e \\u043d\\u0435\\u043f\\u0440\\u0435\\u0440\\u044b\\u0432\\u043d\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441, \\u0430 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u0441\\u0430\\u043c\\u043e\\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u044f &ndash; \\u044d\\u0442\\u043e \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u043d\\u0430\\u0448\\u0435\\u0433\\u043e \\u043b\\u0438\\u0447\\u043d\\u043e\\u0433\\u043e \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430. \\u041f\\u0440\\u043e\\u0431\\u0443\\u0439 \\u0438 \\u0432\\u0441\\u0451 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u0441\\u044f.<\\/li>\\n<li>\\u0423\\u0447\\u0438\\u0442\\u0435\\u0441\\u044c, \\u0443\\u0447\\u0438\\u0442\\u0435\\u0441\\u044c \\u0438 \\u0435\\u0449\\u0435 \\u0440\\u0430\\u0437 \\u0443\\u0447\\u0438\\u0442\\u0435\\u0441\\u044c. \\u0423\\u0447\\u0435\\u0431\\u0430 &ndash; \\u044d\\u0442\\u043e \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0442\\u043e, \\u0447\\u0442\\u043e \\u043c\\u044b \\u0432\\u0438\\u0434\\u0438\\u043c \\u0432 \\u0448\\u043a\\u043e\\u043b\\u0435. \\u0421\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0442 \\u0441\\u043e\\u0442\\u043d\\u0438 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u0445 \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442\\u043e\\u0432, \\u043c\\u044b \\u043c\\u043e\\u0436\\u0435\\u043c \\u0443\\u0447\\u0438\\u0442\\u044c\\u0441\\u044f \\u0432 \\u043b\\u044e\\u0431\\u043e\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u0438 \\u0432 \\u043b\\u044e\\u0431\\u043e\\u043c \\u0443\\u0434\\u043e\\u0431\\u043d\\u043e\\u043c \\u0440\\u0435\\u0436\\u0438\\u043c\\u0435. \\u041f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0447\\u0442\\u043e \\u0443\\u0447\\u0438\\u0442\\u044c\\u0441\\u044f - \\u0432\\u0430\\u0436\\u043d\\u043e \\u043d\\u0430\\u043c \\u0441\\u0430\\u043c\\u0438\\u043c.&nbsp;<\\/li>\\n<\\/ol>\\n<p><strong>\\u041f<\\/strong><strong>\\u043e\\u043c\\u043d\\u0438<\\/strong>, \\u0447\\u0442\\u043e \\u043c\\u044b \\u0432\\u0435\\u0440\\u0438\\u043c \\u0432 \\u0442\\u0435\\u0431\\u044f. \\u041d\\u0435 \\u0432 \\u043d\\u043e\\u0432\\u043e\\u0435 \\u043f\\u043e\\u043a\\u043e\\u043b\\u0435\\u043d\\u0438\\u0435, \\u043d\\u0435\\u0442.&nbsp; \\u041f\\u043e\\u043a\\u043e\\u043b\\u0435\\u043d\\u0438\\u0435 - \\u0431\\u0435\\u0437\\u044b\\u043c\\u044f\\u043d\\u043d\\u043e. \\u041c\\u044b \\u0432\\u0435\\u0440\\u0438\\u043c \\u043b\\u0438\\u0447\\u043d\\u043e \\u0432 \\u0442\\u0435\\u0431\\u044f \\u0438 \\u0442\\u04