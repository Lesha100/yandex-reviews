15679	8	admin/users/report/edit/175/resume	POST	77.238.236.109	{"resume":"<p><strong><span style=\\"color: #2761a0;\\">\\u041d\\u0435\\u0431\\u043e\\u043b\\u044c\\u0448\\u043e\\u0435 \\u043b\\u0438\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u0438\\u043d\\u0442\\u0440\\u043e.<\\/span>&nbsp;<\\/strong>\\u041d\\u0435 \\u043f\\u0443\\u0433\\u0430\\u0439\\u0441\\u044f, \\u0435\\u0441\\u043b\\u0438 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u043e\\u0432 \\u043f\\u043e\\u043a\\u0430\\u0436\\u0443\\u0442\\u0441\\u044f \\u0442\\u0435\\u0431\\u0435 \\"\\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c\\u0438\\". \\u0422\\u0430\\u043a \\u043a\\u0430\\u043a \\u0442\\u044b \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u0443\\u0435\\u0448\\u044c\\u0441\\u044f \\u043f\\u0435\\u0434\\u0430\\u0433\\u043e\\u0433\\u0438\\u043a\\u043e\\u0439, \\u0442\\u043e \\u043c\\u044b \\u043e\\u0442\\u043a\\u0440\\u043e\\u0435\\u043c \\u043d\\u0435\\u0431\\u043e\\u043b\\u044c\\u0448\\u043e\\u0439 \\u0441\\u0435\\u043a\\u0440\\u0435\\u0442 - \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u044d\\u0442\\u043e \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0441\\u0430\\u043c\\u0430 \\u0440\\u0430\\u0441\\u0441\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0448\\u044c \\u043e \\u0441\\u0435\\u0431\\u0435.&nbsp;<\\/p>\\n<p><strong><span style=\\"color: #2761a0;\\">\\u0418\\u0441\\u0445\\u043e\\u0434\\u044f \\u0438\\u0437 \\u0430\\u043d\\u0430\\u043b\\u0438\\u0437\\u0430 \\u0430\\u043d\\u043a\\u0435\\u0442\\u044b<\\/span>,<\\/strong> \\u0435\\u0441\\u0442\\u044c \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435, \\u0447\\u0442\\u043e \\u0442\\u044b \\u043e\\u0447\\u0435\\u043d\\u044c \\u0440\\u0430\\u0437\\u043d\\u043e\\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u043d\\u044f\\u044f \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c. \\u041f\\u043e - \\u0432\\u0438\\u0434\\u0438\\u043c\\u043e\\u043c\\u0443, \\u0437\\u0430 \\u0447\\u0442\\u043e\\u0431\\u044b \\u0442\\u044b \\u043d\\u0435 \\u0432\\u0437\\u044f\\u043b\\u0430\\u0441\\u044c \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0432\\u0441\\u0435 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f. \\u041d\\u043e \\u0434\\u0430\\u0432\\u0430\\u0439 \\u043f\\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0438\\u043c \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u043e\\u0432 \\u0438 \\u043f\\u043e\\u0439\\u043c\\u0435\\u043c, \\u043a\\u0430\\u043a\\u0430\\u044f \\u0441\\u0444\\u0435\\u0440\\u0430 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0442\\u0435\\u0431\\u0435 \\u0431\\u043b\\u0438\\u0436\\u0435.<\\/p>\\n<p>&nbsp;<\\/p>"}	2021-01-29 15:02:31	2021-01-29 15:02:31
