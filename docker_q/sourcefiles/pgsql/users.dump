440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0430. \\u0422\\u044b \\u043a\\u0430\\u043a \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u044b\\u0439 \\u043a \\u0438\\u043d\\u0442\\u0440\\u043e\\u0432\\u0435\\u0440\\u0441\\u0438\\u0438 \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u043f\\u043e\\u0440\\u0430\\u0437\\u043c\\u044b\\u0448\\u043b\\u044f\\u0442\\u044c \\u043e \\u0441\\u0435\\u0431\\u0435, &nbsp;\\u043f\\u043e\\u0431\\u044b\\u0442\\u044c \\u0432 \\u0441\\u0432\\u043e\\u0435\\u043c &laquo;\\u0434\\u043e\\u043c\\u0438\\u043a\\u0435&raquo; \\u0438 \\u0442\\u0435\\u0431\\u0435 \\u0442\\u0430\\u043c \\u043d\\u0435 \\u0441\\u043a\\u0443\\u0447\\u043d\\u043e. \\u041c\\u043e\\u0437\\u0433 \\u0443 \\u043b\\u044e\\u0434\\u0435\\u0439, \\u043f\\u043e\\u0434\\u043e\\u0431\\u043d\\u044b\\u0445 \\u0442\\u0435\\u0431\\u0435, \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442 \\u0433\\u043e\\u0440\\u0430\\u0437\\u0434\\u043e \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0441\\u0442\\u0438\\u043c\\u0443\\u043b\\u043e\\u0432 \\u043e\\u0442 \\u0432\\u043d\\u0435\\u0448\\u043d\\u0435\\u0439 \\u0441\\u0440\\u0435\\u0434\\u044b, \\u0438 \\u043d\\u0443\\u0436\\u043d\\u043e \\u0432\\u0440\\u0435\\u043c\\u044f \\u0438 \\u0441\\u0438\\u043b\\u044b, \\u0447\\u0442\\u043e\\u0431\\u044b \\u0438\\u0445 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c. \\u041f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443, \\u043d\\u0430\\u0445\\u043e\\u0434\\u044f\\u0441\\u044c \\u0432 \\u043a\\u043e\\u043c\\u043f\\u0430\\u043d\\u0438\\u0438, \\u0447\\u0435\\u0440\\u0435\\u0437 \\u043a\\u0430\\u043a\\u043e\\u0435-\\u0442\\u043e \\u0432\\u0440\\u0435\\u043c\\u044f \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043f\\u043e\\u0447\\u0443\\u0432\\u