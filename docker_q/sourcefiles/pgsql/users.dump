0432\\u0430. \\u042d\\u0442\\u043e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043e\\u0447\\u0435\\u043d\\u044c \\u043f\\u043e\\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u044c\\u0441\\u044f \\u043d\\u0435\\u043f\\u043e\\u0441\\u0435\\u0434\\u0430\\u043c-\\u044d\\u043a\\u0441\\u0442\\u0440\\u0430\\u0432\\u0435\\u0440\\u0442\\u0430\\u043c, \\u043d\\u043e \\u0443\\u043b\\u0430\\u0436\\u0438\\u0432\\u0430\\u043d\\u0438\\u0435 \\u043a\\u043e\\u043d\\u0444\\u043b\\u0438\\u043a\\u0442\\u043e\\u0432, \\u0430\\u0434\\u043c\\u0438\\u043d\\u0438\\u0441\\u0442\\u0440\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0438 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u043d\\u0430\\u044f \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u043e\\u0442\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 \\u043d\\u0435\\u043c\\u0430\\u043b\\u043e \\u0441\\u0438\\u043b.&nbsp;<\\/p>\\n<p><strong>\\u0414\\u043e\\u043b\\u0433\\u0430\\u044f \\u0443\\u0447\\u0435\\u0431\\u0430.<\\/strong><\\/p>\\n<p>&nbsp;\\u0421\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440\\u044b \\u0443\\u0447\\u0430\\u0442\\u0441\\u044f \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0434\\u043e\\u043b\\u0433\\u043e, \\u043a\\u0430\\u043a \\u0432\\u0440\\u0430\\u0447\\u0438. \\u041f\\u0435\\u0440\\u0432\\u0430\\u044f \\u0441\\u0442\\u0443\\u043f\\u0435\\u043d\\u044c \\u0432\\u044b\\u0441\\u0448\\u0435\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f:<\\/p>\\n<p>- \\u0431\\u0430\\u043a\\u0430\\u043b\\u0430\\u0432\\u0440\\u0438\\u0430\\u0442 - \\u0434\\u043b\\u0438\\u0442\\u0441\\u044f 5 \\u043b\\u0435\\u0442. \\u0410 \\u0447\\u0442\\u043e\\u0431\\u044b \\u0437\\u0430\\u043a\\u043e\\u043d\\u0447\\u0438\\u0442\\u044c \\u0432\\u044b\\u0441\\u0448\\u0435\\u0435 \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435, \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442\\u0441\\