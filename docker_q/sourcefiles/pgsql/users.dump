32364	12	admin/users/report/edit/299/resume	POST	46.39.45.141	{"resume":"<p>\\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043d\\u0430 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0442\\u0438\\u043f\\u0430 \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043b\\u0438, \\u0447\\u0442\\u043e \\u0432 \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0438 \\u0441 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0430\\u044e\\u0449\\u0438\\u043c \\u043c\\u0438\\u0440\\u043e\\u043c \\u0442\\u0435\\u0431\\u0435 \\u0441\\u0432\\u043e\\u0439\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e \\u043f\\u0440\\u043e\\u044f\\u0432\\u043b\\u044f\\u0442\\u044c \\u044d\\u043a\\u0441\\u0442\\u0440\\u0430\\u0432\\u0435\\u0440\\u0442\\u0438\\u0432\\u043d\\u044b\\u0435 \\u0447\\u0435\\u0440\\u0442\\u044b. \\u042d\\u0442\\u043e \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442 \\u043e \\u0442\\u0435\\u0431\\u0435 \\u043a\\u0430\\u043a \\u043e \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0435 \\u043e\\u0431\\u0449\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u043c, \\u043e\\u0440\\u0438\\u0435\\u043d\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u043c \\u043d\\u0430 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441\\u044b \\u0432\\u0437\\u0430\\u0438\\u043c\\u043e\\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u044f \\u0441 \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c\\u0438 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438. \\u0427\\u0430\\u0449\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e \\u0442\\u044b \\u0440\\u0430\\u0437\\u0433\\u043e\\u0432\\u043e\\u0440\\u0447\\u0438\\u0432 \\u0438 \\u0430\\u043a\\u0442\\u0438\\u0432\\u0435\\u043d \\u0432 \\u043d\\u0430\\u043b\\u0430\\u0436\\u0438\\u0432\\u0430\\u043d\\u0438\\u0438 \\u0434\\u0440\\u0443\\u0436\\u0435\\u0441\\u043a\\u0438\\u0445 \\u0438 \\u0434\\u0435\\u043b\\u043e\\u0432\\u044b\\u0445 \\u043a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442\\u043e\\u0432, \\u043f\\u0440\\u0438 \\u044d\\u0442\\u043e\\u043c \\u0442\\u044b \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u0435\\u043d \\u043e\\u0442\\u0441\\u0442\\u0430\\u0438\\u0432\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u0438 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u044b, \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d \\u0432 \\u0441\\u0435\\u0431\\u0435. \\u041f\\u0440\\u0438 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0438 \\u043f\\u0440\\u043e\\u0431\\u043b\\u0435\\u043c \\u0441\\u0442\\u0440\\u0435\\u043c\\u0438\\u0448\\u044c\\u0441\\u044f \\u043a \\u0441\\u0430\\u043c\\u043e\\u0441\\u0442\\u043e\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438, \\u0443\\u043c\\u0435\\u0435\\u0448\\u044c \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u0442\\u044c &laquo;\\u043f\\u043e \\u0441\\u0438\\u0442\\u0443\\u0430\\u0446\\u0438\\u0438&raquo;, \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442 \\u043d\\u043e\\u0432\\u043e\\u043c\\u0443 \\u043e\\u043f\\u044b\\u0442\\u0443, \\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u0438\\u0438\\u043c\\u0447\\u0438\\u0432, \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u0435\\u0448\\u044c \\u0430\\u0434\\u0435\\u043a\\u0432\\u0430\\u0442\\u043d\\u043e\\u0439 \\u0441\\u0430\\u043c\\u043e\\u043e\\u0446\\u0435\\u043d\\u043a\\u043e\\u0439. \\u0422\\u0435\\u0431\\u0435 \\u043d\\u0435 \\u0447\\u0443\\u0436\\u0434\\u043e \\u0443\\u043f\\u043e\\u0440\\u0441\\u0442\\u0432\\u043e \\u0432 \\u0434\\u043e\\u0441\\u0442\\u0438\\u0436\\u0435\\u043d\\u0438\\u0438 \\u0446\\u0435\\u043b\\u0435\\u0439. \\u041e\\u0434\\u043d\\u0430\\u043a\\u043e \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c \\u0441\\u0435\\u043d\\u0437\\u0438\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442 \\u043e \\u0442\\u0435\\u0431\\u0435 \\u043a\\u0430\\u043a \\u043e \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0435 \\u0432\\u043f\\u0435\\u0447\\u0430\\u0442\\u043b\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u043c \\u0438 \\u0432\\u0435\\u0441\\u044c\\u043c\\u0430 \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u043c \\u043a \\u0434\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044e \\u043e\\u043a\\u0440\\u0443\\u0436\\u0430\\u044e\\u0449\\u0435\\u0439 \\u0441\\u0440\\u0435\\u0434\\u044b. \\u0413\\u0440\\u0443\\u0431\\u043e\\u0441\\u0442\\u044c, \\u043d\\u0435\\u0432\\u0435\\u0440\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043a\\u043e\\u043d\\u0444\\u043b\\u0438\\u043a\\u0442\\u044b, \\u0441\\u043a\\u043e\\u0440\\u0435\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e, \\u0442\\u044b \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u0435\\u0448\\u044c \\u0434\\u043e\\u043b\\u0433\\u043e \\u0438 \\u0433\\u043b\\u0443\\u0431\\u043e\\u043a\\u043e. \\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u044b \\u0432 \\u0443\\u0441\\u0442\\u043e\\u044f\\u0432\\u0448\\u0435\\u043c\\u0441\\u044f \\u0443\\u043a\\u043b\\u0430\\u0434\\u0435 \\u043f\\u043e\\u0440\\u043e\\u0439 \\u0432\\u0441\\u0442\\u0440\\u0435\\u0447\\u0430\\u0435\\u0448\\u044c \\u0441 \\u043e\\u043f\\u0430\\u0441\\u0435\\u043d\\u0438\\u044f\\u043c\\u0438. \\u0423\\u0447\\u0435\\u0431\\u0430, \\u0441\\u0438\\u0442\\u0443\\u0430\\u0446\\u0438\\u0438 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438, \\u043f\\u043e \\u0432\\u0441\\u0435\\u0439 \\u0432\\u0438\\u0434\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438, \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u044e\\u0442 \\u0442\\u0440\\u0435\\u0432\\u043e\\u0433\\u0443 \\u0438 \\u043d\\u0430\\u043f\\u0440\\u044f\\u0436\\u0435\\u043d\\u0438\\u0435. \\u041e\\u0434\\u043d\\u0430\\u043a\\u043e \\u0442\\u044b \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u0435\\u043d \\u043f\\u0435\\u0440\\u0435\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u043d\\u0438\\u044f \\u043f\\u043e \\u043f\\u043e\\u0432\\u043e\\u0434\\u0443 \\u0443\\u043f\\u0440\\u0435\\u043a\\u043e\\u0432 \\u0438 \\u0437\\u0430\\u043c\\u0435\\u0447\\u0430\\u043d\\u0438\\u0439 \\u0431\\u0435\\u0437 \\u0443\\u0440\\u043e\\u043d\\u0430 \\u0434\\u043b\\u044f \\u0441\\u0432\\u043e\\u0435\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0421\\u043a\\u043e\\u0440\\u0435\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e, \\u0442\\u0432\\u043e\\u0438 \\u044d\\u043c\\u043e\\u0446\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0440\\u0435\\u0430\\u043a\\u0446\\u0438\\u0438 \\u0430\\u0434\\u0435\\u043a\\u0432\\u0430\\u0442\\u043d\\u044b \\u0441\\u0438\\u0442\\u0443\\u0430\\u0446\\u0438\\u0438, \\u0442\\u044b \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u0435\\u043d \\u0447\\u0443\\u0442\\u043a\\u043e \\u044d\\u043c\\u043e\\u0446\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e \\u043e\\u0442\\u043a\\u043b\\u0438\\u043a\\u0430\\u0442\\u044c\\u0441\\u044f \\u043d\\u0430 \\u0441\\u043e\\u0431\\u044b\\u0442\\u0438\\u044f \\u0438 \\u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u044f. \\u041f\\u0440\\u0438 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u0442\\u044b \\u0433\\u043e\\u0442\\u043e\\u0432 \\u044d\\u043c\\u043e\\u0446\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e \\u0432\\u043e\\u0432\\u043b\\u0435\\u0447\\u044c\\u0441\\u044f \\u0432 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u044b, \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u044f \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c \\u043e\\u0442\\u0441\\u0442\\u0440\\u0430\\u043d\\u044f\\u0442\\u044c\\u0441\\u044f \\u0438 \\u043f\\u0435\\u0440\\u0435\\u043a\\u043b\\u044e\\u0447\\u0430\\u04