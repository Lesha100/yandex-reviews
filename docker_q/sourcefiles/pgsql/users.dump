30\\u044e\\u0449\\u0438\\u043c\\u0438.<\\/p>\\n<p>\\u041f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0431\\u043b\\u043e\\u043a\\u0430:<\\/p>\\n<ul>\\n<li>\\u0445\\u0443\\u0434\\u043e\\u0436\\u043d\\u0438\\u043a, \\u0440\\u0435\\u0441\\u0442\\u0430\\u0432\\u0440\\u0430\\u0442\\u043e\\u0440<\\/li>\\n<li>\\u0432\\u043e\\u043a\\u0430\\u043b\\u0438\\u0441\\u0442, \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430\\u043b\\u0438\\u0441\\u0442, \\u0445\\u043e\\u0440\\u0435\\u043e\\u0433\\u0440\\u0430\\u0444, \\u0442\\u0430\\u043d\\u0446\\u043e\\u0440<\\/li>\\n<li>\\u043f\\u0438\\u0441\\u0430\\u0442\\u0435\\u043b\\u044c, \\u043f\\u043e\\u044d\\u0442, \\u0430\\u0432\\u0442\\u043e\\u0440<\\/li>\\n<li>\\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444, \\u043a\\u0438\\u043d\\u043e\\u0440\\u0435\\u0436\\u0438\\u0441\\u0441\\u0435\\u0440<\\/li>\\n<li>\\u0430\\u043a\\u0442\\u0435\\u0440 \\u0442\\u0435\\u0430\\u0442\\u0440\\u0430 \\u0438 \\u043a\\u0438\\u043d\\u043e, \\u0442\\u0435\\u0430\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0440\\u0435\\u0436\\u0438\\u0441\\u0441\\u0435\\u0440.<\\/li>\\n<\\/ul>\\n<h3><strong>\\u0421\\u043e\\u0432\\u0435\\u0442 \\u043e\\u0442 \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442\\u0430.<\\/strong><strong>&nbsp;<\\/strong><\\/h3>\\n<p>\\u0418\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u044b \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430 \\u044f\\u0440\\u043a\\u043e \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u044b, \\u0435\\u0441\\u0442\\u044c \\u0438\\u0437 \\u0447\\u0435\\u0433\\u043e \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0442\\u044c. \\u0415\\u0441\\u0442\\u044c \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0437\\u0430\\u0434\\u0430\\u0442\\u043a\\u0438 \\u0438 \\u0435\\u0441\\u0442\\u044c \\u0437\\u0430\\u0434\\u0430\\u0442\\u043a\\u0438 \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0430, \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0430. \\u0414\\u043b\\u044f \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e\\u0431\\u044b \\u0447\\u0435\\u0442\\u0447\\u0435 \\u0432\\u044b\\u0431\\u0440\\u0430\\u0442\\u044c, \\u043c\\u043e\\u0436\\u043d\\u043e \\u043f\\u0440\\u043e\\u0430\\u043d\\u0430\\u043b\\u0438\\u0437\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u0433\\u0434\\u0435 \\u0435\\u0441\\u0442\\u044c \\u0438 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e, \\u0438 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0441 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0435\\u0439. \\u041d\\u0430\\u043f\\u0440\\u0438\\u043c\\u0435\\u0440, \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440, \\u0433\\u0434\\u0435 \\u043d\\u0443\\u0436\\u043d\\u043e \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u043f\\u0440\\u043e\\u0441\\u0442\\u0440\\u0430\\u043d\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0435 \\u0432\\u043e\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u043f\\u0440\\u043e\\u0432\\u043e\\u0434\\u0438\\u0442\\u044c \\u0442\\u043e\\u0447\\u043d\\u044b\\u0435 \\u0440\\u0430\\u0441\\u0447\\u0435\\u0442\\u044b. \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u0430\\u044f \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0430\\u0446\\u0438\\u044f - \\u043f\\u043e\\u0434\\u0440\\u043e\\u0431\\u043d\\u0435\\u0435 \\u043e\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u0438\\u0442\\u044c\\u0441\\u044f \\u0441 \\u043f\\u0440\\u0444\\u043e\\u0435\\u0441\\u0441\\u0438\\u044f\\u043c\\u0438 \\u0438\\u0437 \\u0441\\u043f\\u0438\\u0441\\u043a\\u0430 \\u0432\\u044b\\u0448\\u0435. \\u0427\\u0430\\u0441\\u0442\\u044c \\u0438\\u0437 \\u043d\\u0438\\u0445 \\u0440\\u0435