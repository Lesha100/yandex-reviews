043c. \\u042d\\u0442\\u043e \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442 \\u043e \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0432 \\u0442\\u043e\\u0439 \\u0441\\u0444\\u0435\\u0440\\u0435, \\u0433\\u0434\\u0435 \\u0442\\u044b \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0443\\u0435\\u0448\\u044c \\u0441\\u0432\\u043e\\u044e \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0438 \\u0441\\u0438\\u043b\\u0443, \\u0442\\u044b \\u0437\\u0430\\u0439\\u043c\\u0435\\u0448\\u044c \\u043b\\u0438\\u0434\\u0438\\u0440\\u0443\\u044e\\u0449\\u0443\\u044e \\u043f\\u043e\\u0437\\u0438\\u0446\\u0438\\u044e. \\u0410 \\u0432\\u043e\\u0442 \\u0435\\u0441\\u043b\\u0438 \\u0442\\u044b \\u043f\\u043e\\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0443\\u0435\\u0448\\u044c \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u043a \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438\\u043b\\u0438 \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u043a \\u0437\\u043d\\u0430\\u043d\\u0438\\u0439, \\u0442\\u043e \\u0437\\u0430\\u0440\\u0443\\u0447\\u0438\\u0448\\u044c\\u0441\\u044f \\u043f\\u043e\\u0434\\u0434\\u0435\\u0440\\u0436\\u043a\\u043e\\u0439 \\u0430\\u0432\\u0442\\u043e\\u0440\\u0438\\u0442\\u0435\\u0442\\u043d\\u044b\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439. \\u0422\\u044b \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u043d\\u0435 \\u0442\\u0435\\u0440\\u043f\\u0438\\u0442 \\u0440\\u0430\\u043c\\u043a\\u0438, \\u0432 \\u0442\\u0435\\u0431\\u0435 \\u043c\\u043d\\u043e\\u0433\\u043e \\u043f\\u0441\\u0438\\u0445\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0441\\u0438\\u043b\\u044b, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u043f\\u043e\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0432 \\u0434\\u043e\\u0441\\u0442\\u0438\\u0436\\u0435\\u043d\\u0438\\u0438 \\u0430\\u043c\\u0431\\u0438\\u0446\\u0438\\u043e\\u0437\\u0