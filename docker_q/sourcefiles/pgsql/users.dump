\u0443\\u0435\\u0448\\u044c \\u043f\\u0440\\u043e\\u0438\\u0441\\u0445\\u043e\\u0434\\u044f\\u0449\\u0435\\u0435 \\u0432\\u043e\\u043a\\u0440\\u0443\\u0433, \\u043f\\u043e\\u0433\\u0440\\u0443\\u0436\\u0435\\u043d \\u0432 \\u0441\\u0435\\u0431\\u044f \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u043c\\u043d\\u043e\\u0433\\u0438\\u0445 \\u0441\\u0432\\u0435\\u0440\\u0441\\u0442\\u043d\\u0438\\u043a\\u043e\\u0432, \\u0447\\u0442\\u043e \\u043e\\u043f\\u044f\\u0442\\u044c \\u0436\\u0435 \\u0434\\u0430\\u0435\\u0442 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438 \\u0438 \\u043c\\u0435\\u0441\\u0442\\u043e \\u043d\\u0430 \\u0442\\u043e, \\u0447\\u0442\\u043e\\u0431\\u044b \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u0442\\u044c \\u043e \\u0441\\u0435\\u0431\\u0435\\/\\u043c\\u0438\\u0440\\u0435\\/\\u0447\\u0442\\u043e\\u0442\\u0430\\u043c\\u0435\\u0449\\u0451 =)&nbsp;<\\/span><\\/span><\\/span><\\/span><\\/p>\\n<p><span style=\\"color: #7ba5d8;\\"><span style=\\"color: #000000;\\"><span style=\\"color: #fabd21;\\"><span style=\\"color: #000000;\\">\\u041e\\u0442\\u043c\\u0435\\u0442\\u0438\\u043c, \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0433\\u043b\\u0430\\u0432\\u043d\\u043e\\u0435 - \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043f\\u0440\\u043e\\u043a\\u0440\\u0430\\u0441\\u0442\\u0438\\u043d\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c \\u043e\\u0447\\u0435\\u043d\\u044c \\u0434\\u043e\\u043b\\u0433\\u043e. \\u0421\\u0430\\u043c\\u043e\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u0435\\u0439\\u0447\\u0430\\u0441 \\u043f\\u043e\\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u0441\\u043e \\u0432\\u0437\\u0440\\u043e\\u0441\\u043b\\u044b\\u043c\\u0438 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u043c \\u0442\\u044b \\u0434\\u043e\\u0432\\u0435\\u0440\\u0