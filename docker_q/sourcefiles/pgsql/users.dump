18075	9	admin/users/report/edit/196/resume	POST	77.238.236.109	{"resume":"<p><span style=\\"color: #2761a0;\\">\\u0421\\u0440\\u0430\\u0437\\u0443 \\u043e\\u0442\\u043c\\u0435\\u0442\\u0438\\u043c,<\\/span> \\u0447\\u0442\\u043e \\u043f\\u043e \\u043d\\u0430\\u0448\\u0435\\u043c\\u0443 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u044e, \\u0442\\u0435\\u0441\\u0442\\u044b \\u0432\\u044b\\u0437\\u0432\\u0430\\u043b\\u0438 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0437\\u0430\\u0442\\u0440\\u0443\\u0434\\u043d\\u0435\\u043d\\u0438\\u0435. \\u041f\\u043e\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u0443 \\u0442\\u0435\\u0441\\u0442\\u044b \\u043f\\u0440\\u0438\\u0437\\u0432\\u0430\\u043d\\u044b \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0438\\u0442\\u044c \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0447\\u0435\\u0440\\u0442 \\u0438 \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u0438\\u0441\\u0442\\u0438\\u043a \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0430 \\u0438, \\u043d\\u0430\\u043e\\u0431\\u043e\\u0440\\u043e\\u0442, &nbsp;\\u043d\\u0435\\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c &nbsp;\\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u0447\\u0435\\u0440\\u0442, \\u0447\\u0442\\u043e \\u043a\\u0430\\u043a \\u0440\\u0430\\u0437 \\u0438 \\u0434\\u0430\\u0435\\u0442 \\u0438\\u043d\\u0434\\u0438\\u0432\\u0438\\u0434\\u0443\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 &nbsp;\\u043f\\u043e\\u0440\\u0442\\u0440\\u0435\\u0442 , &nbsp;\\u0442\\u043e \\u043d\\u0430\\u043b\\u0438\\u0447\\u0438\\u0435 \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043e\\u0434\\u0438\\u043d\\u0430\\u043a\\u043e\\u0432\\u044b\\u0445 \\u0431\\u0430\\u043b\\u043b\\u043e\\u0432 \\u043f\\u043e \\u0432\\u0441\\u0435\\u043c \\u0448\\u043a\\u0430\\u043b\\u0430\\u043c \\u043d\\u0435 \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u0435\\u0442 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u044c&nbsp; \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0442\\u043e\\u0447\\u043d\\u0443\\u044e \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044e \\u043e \\u0442\\u0435\\u0431\\u0435. \\u041b\\u0438\\u0431\\u043e \\u0442\\u044b \\u043d\\u0435 \\u043e\\u0447\\u0435\\u043d\\u044c \\u0441\\u0435\\u0440\\u044c\\u0435\\u0437\\u043d\\u043e \\u043e\\u0442\\u043d\\u0435\\u0441\\u0441\\u044f \\u043a \\u0438\\u0445 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u044e, \\u043b\\u0438\\u0431\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0431\\u044b\\u043b\\u043e \\u0441\\u043b\\u043e\\u0436\\u043d\\u043e \\u0434\\u0430\\u0432\\u0430\\u0442\\u044c \\u0438\\u0441\\u043a\\u0440\\u0435\\u043d\\u043d\\u0438\\u0435 \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b, \\u043b\\u0438\\u0431\\u043e \\u0437\\u0430\\u0433\\u043b\\u044f\\u043d\\u0443\\u0442\\u044c \\u0432 \\u0441\\u0435\\u0431\\u044f&nbsp; \\u043f\\u043e\\u043a\\u0430 \\u043d\\u0435 \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u0434\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b\\u043c, \\u043d\\u0435 \\u0432\\u0438\\u0434\\u0438\\u0448\\u044c \\u0432 \\u044d\\u0442\\u043e\\u043c \\u043f\\u043e\\u043b\\u044c\\u0437\\u044b \\u0438 \\u0441\\u043c\\u044b\\u0441\\u043b\\u0430. \\u0425\\u043e\\u0442\\u0438\\u043c \\u0441\\u043a\\u0430\\u0437\\u0430\\u0442\\u044c, \\u0447\\u0442\\u043e \\u044d\\u0442\\u043e \\u043d\\u043e\\u0440\\u043c\\u0430\\u043b\\u044c\\u043d\\u043e. \\u042d\\u0442\\u043e \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e. \\u041d\\u043e \\u044d\\u0442\\u043e \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e, \\u0435\\u0441\\u043b\\u0438 \\u0445\\u043e\\u0447\\u0435\\u0448\\u044c, \\u0447\\u0442\\u043e\\u0431\\u044b \\u0442\\u0432\\u043e\\u044f \\u0436\\u0438\\u0437\\u043d\\u044c \\u0441\\u043e\\u0441\\u0442\\u043e\\u044f\\u043b\\u0430\\u0441\\u044c \\u0438 \\u0431\\u044b\\u043b\\u0430 \\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u043e\\u0439. \\u0412\\u0435\\u0440\\u0438\\u043c, \\u0447\\u0442\\u043e \\u0447\\u0435\\u0440\\u0435\\u0437 \\u043a\\u0430\\u043a\\u043e\\u0435-\\u0442\\u043e \\u0432\\u0440\\u0435\\u043c\\u044f \\u0442\\u044b \\u0431\\u0443\\u0434\\u0435\\u0448\\u044c \\u043a \\u044d\\u0442\\u043e\\u043c\\u0443 \\u0433\\u043e\\u0442\\u043e\\u0432.<\\/p>\\n<p><span style=\\"color: #2761a0;\\">\\u041e\\u0434\\u043d\\u0430\\u043a\\u043e \\u043c\\u043e\\u0436\\u0435\\u043c \\u0441\\u043a\\u0430\\u0437\\u0430\\u0442\\u044c,<\\/span> \\u0447\\u0442\\u043e \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u043e\\u0435 \\u0441\\u043e\\u0447\\u0435\\u0442\\u0430\\u043d\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439. \\u0421 \\u043e\\u0434\\u043d\\u043e\\u0439 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b, \\u0442\\u044b &ndash; \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u043d\\u044b\\u0439 \\u0445\\u0443\\u0434\\u043e\\u0436\\u043d\\u0438\\u043a&raquo;, \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e \\u0438 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432. \\u0422\\u044b \\u0446\\u0435\\u043d\\u0438\\u0448\\u044c \\u043e\\u0440\\u0438\\u0433\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u044c, \\u043b\\u044e\\u0434\\u0435\\u0439 \\u0441 \\u043d\\u0435\\u043e\\u0431\\u044b\\u0447\\u043d\\u044b\\u043c \\u0432\\u0437\\u0433\\u043b\\u044f\\u0434\\u043e\\u043c \\u043d\\u0430 \\u0436\\u0438\\u0437\\u043d\\u044c, \\u0433\\u0438\\u0431\\u043a\\u043e\\u0441\\u0442\\u044c\\u044e \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f, \\u044d\\u043c\\u043e\\u0446\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0432\\u043e\\u0441\\u043f\\u0440\\u0438\\u0438\\u043c\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u044c\\u044e. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0442\\u0435\\u0431\\u0435 \\u0431\\u044b \\u043f\\u043e\\u0434\\u043e\\u0448\\u043b\\u0430 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430, \\u0433\\u0434\\u0435 \\u043d\\u0435\\u0442 \\u0436\\u0435\\u0441\\u0442\\u043a\\u043e\\u0433\\u043e \\u0433\\u0440\\u0430\\u0444\\u0438\\u043a\\u0430, \\u0440\\u0435\\u0436\\u0438\\u043c\\u0430, \\u0444\\u043e\\u0440\\u043c\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439, \\u0436\\u0435\\u0441\\u0442\\u043a\\u0438\\u0445 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0439, \\u0433\\u0434\\u0435 \\u0446\\u0435\\u043d\\u0438\\u0442\\u0441\\u044f \\u043f\\u043e\\u043b\\u0435\\u0442 \\u0444\\u0430\\u043d\\u0442\\u0430\\u0437\\u0438\\u0438, \\u0432\\u043e\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u0438\\u0435, \\u0433\\u0434\\u0435 \\u0432\\u0430\\u0436\\u043d\\u043e \\u0438\\u043c\\u0435\\u0442\\u044c \\u0432\\u043a\\u0443\\u0441, \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u0442\\u0430\\u043b\\u0430\\u043d\\u0442 - \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0439, \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043d\\u044b\\u0439, \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439. \\u041a \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044f\\u043c, \\u043e\\u0442\\u043d\\u043e\\u0441\\u044f\\u0449\\u0438\\u043c\\u0441\\u044f \\u043a \\u0430\\u0440\\u0442\\u0438\\u0441\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u043c\\u0443 \\u0442\\u0438\\u043f\\u0443 \\u043e\\u0442\\u043d\\u043e\\u0441\\u044f\\u0442\\u0441\\u044f: &nbsp;\\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043d\\u0442\\u044b, \\u0445\\u0443\\u0434\\u043e\\u0436\\u043d\\u0438\\u043a\\u0438, \\u0432\\u0438\\u0437\\u0430\\u0436\\u0438\\u0441\\u0442\\u044b, \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\\u044b, \\u0430\\u043a\\u0442\\u0435\\u0440\\u044b, \\u0440\\u0435\\u0436\\u0438\\u0441\\u0441\\u0435\\u0440\\u044b, \\u0434\\u0438\\u0437\\u0430\\u0439\\u043d\\u0435\\u0440\\u044b. \\u043f\\u0438\\u0441\\u0430\\u0442\\u0435\\u043b\\u0438. \\u0422\\u0438\\u043f\\u0438\\u0447\\u043d\\u044b\\u0435 \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044f \\u044d\\u0442\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439: \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\\u0438\\u044f, \\u0440\\u0438\\u0441\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435, \\u043f\\u043e\\u0441\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u0442\\u0430\\u043d\\u0446\\u0435\\u0432\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0438 \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u043a\\u043e\\u043d\\u0446\\u0435\\u0440\\u0442\\u043e\\u0432, \\u0442\\u0435\\u0430\\u0442\\u0440\\u043e\\u0432, \\u043c\\u0443\\u0437\\u0435\\u0435\\u0432, \\u0441\\u043e\\u0447\\u0438\\u043d\\u0435\\u043d\\u0438\\u0435 \\u0441\\u0442\\u0438\\u0445\\u043e\\u0432, \\u043f\\u0440\\u043e\\u0437\\u044b, \\u0438\\u0433\\u0440\\u0430 \\u043d\\u0430 \\u043c\\u0443\\u0437\\u044b\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430\\u0445, \\u0437\\u0430\\u043d\\u044f\\u0442\\u0438\\u0435 \\u0442\\u0430\\u043d\\u0446\\u0430\\u043c\\u0438, \\u043f\\u0435\\u043d\\u0438\\u0435\\u043c.<\\/p>\\n<p><span style=\\"color: #2761a0;\\">\\u0421 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b,<\\/span> \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0435\\u0441\\u0442\\u044c \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a \\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u043c\\u0443 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u043c\\u0443 \\u0442\\u0438\\u043f\\u0443. \\u041b\\u044e\\u0434\\u044f\\u043c \\u044d\\u0442\\u043e\\u0433\\u043e \\u0442\\u0438\\u043f\\u0430 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0438\\u0437\\u0443\\u0447\\u0430\\u0442\\u044c, \\u043a\\u0430\\u043a \\u0443\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u0430 \\u0436\\u0438\\u0437\\u043d\\u044c \\u0437\\u043d\\u0430\\u0442\\u044c, \\u0430\\u043d\\u0430\\u043b\\u0438\\u0437\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c, \\u0440\\u0430\\u0437\\u043c\\u044b\\u0448\\u043b\\u044f\\u0442\\u044c, \\u0437\\u0430\\u0434\\u0430\\u0432\\u0430\\u0442\\u044c \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u0438 \\u043d\\u0430\\u0445\\u043e\\u0434\\u0438\\u0442\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b. \\u0418\\u043c \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0440\\u0435\\u0448\\u0430\\u0442\\u044c \\u043b\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u0437\\u0430\\u0434\\u0430\\u0447\\u0438, \\u043e\\u043d\\u0438 \\u0443\\u043c\\u0435\\u044e\\u0442 \\u0445\\u043e\\u0440\\u043e\\u0448\\u043e \\u0444\\u043e\\u0440\\u043c\\u0443\\u043b\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c \\u0438 \\u0438\\u0437\\u043b\\u0430\\u0433\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u0438 \\u043c\\u044b\\u0441\\u043b\\u0438. \\u0418\\u043c\\u0435\\u043d\\u043d\\u043e \\u0434\\u043b\\u044f \\u044d\\u0442\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439 \\u043e\\u0441\\u043e\\u0431\\u0435\\u043d\\u043d\\u043e \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u043d\\u043e, \\u0447\\u0442\\u043e \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441 \\u0438 \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0441\\u0432\\u043e\\u0435\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0435\\u0439&nbsp; \\u0434\\u0430\\u0435\\u0442 \\u0438\\u043c &nbsp;\\u0441\\u043c\\u044b\\u0441\\u043b \\u0438 \\u0440\\u0430\\u0434\\u043e\\u0441\\u0442\\u044c \\u043d\\u0430 \\u043f\\u0440\\u043e\\u0442\\u044f\\u0436\\u0435\\u043d\\u0438\\u0438 \\u0432\\u0441\\u0435\\u0439 \\u0436\\u0438\\u0437\\u043d\\u0438. \\u041a \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044f\\u043c \\u0434\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043a\\u0430\\u0442\\u0435\\u0433\\u043e\\u0440\\u0438\\u0438 \\u043e\\u0442\\u043d\\u043e\\u0441\\u044f\\u0442\\u0441\\u044f: \\u0443\\u0447\\u0435\\u043d\\u044b\\u0435, \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0438, \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0441\\u0442\\u044b, \\u044d\\u043a\\u043e\\u043d\\u043e\\u043c\\u0438\\u0441\\u0442\\u044b, \\u0430\\u0443\\u0434\\u0438\\u0442\\u043e\\u0440\\u044b, \\u0441\\u043e\\u0446\\u0438\\u043e\\u043b\\u043e\\u0433\\u0438, \\u0433\\u0435\\u043d\\u0435\\u0442\\u0438\\u043a\\u0438, \\u044d\\u043a\\u043e\\u043b\\u043e\\u0433\\u0438, \\u0444\\u0430\\u0440\\u043c\\u0430\\u0446\\u0435\\u0432\\u0442\\u044b, \\u0432\\u0440\\u0430\\u0447\\u0438, \\u043b\\u0438\\u043d\\u0433\\u0432\\u0438\\u0441\\u0442\\u044b, \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e\\u0432\\u0435\\u0434\\u044b. &nbsp;\\u0422\\u0438\\u043f\\u0438\\u0447\\u043d\\u044b\\u0435 \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044f \\u0434\\u043b\\u044f \\u044d\\u0442\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439 &ndash; \\u044d\\u0442\\u043e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 (\\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u0438\\u0439 \\u0442\\u0438\\u043f \\u0447\\u0430\\u0441\\u0442\\u043e \\u043f\\u043e\\u043b\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u043f\\u043e\\u0433\\u043b\\u043e\\u0449\\u0435\\u043d \\u0441\\u0432\\u043e\\u0435\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u043e\\u0439), \\u0441\\u043b\\u043e\\u0436\\u043d\\u044b\\u0435 \\u0432\\u0438\\u0434\\u044b \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 (\\u044f\\u0445\\u0442\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0441\\u043f\\u043e\\u0440\\u0442, \\u043f\\u043e\\u0434\\u0432\\u043e\\u0434\\u043d\\u043e\\u0435 \\u043f\\u043b\\u0430\\u0432\\u0430\\u043d\\u0438\\u0435, \\u0430\\u043b\\u044c\\u043f\\u0438\\u043d\\u0438\\u0437\\u043c), \\u043a\\u043e\\u043c\\u043f\\u044c\\u044e\\u0442\\u0435\\u0440\\u044b, \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435, \\u0447\\u0442\\u0435\\u043d\\u0438\\u0435 (\\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u0430\\u044f \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u0430, \\u043d\\u0430\\u0443\\u0447\\u043d\\u044b\\u0435 \\u0441\\u0442\\u0430\\u0442\\u044c\\u0438).<\\/p>\\n<p><span style=\\"color: #2761a0;\\">\\u041f\\u043e \\u0442\\u0435\\u0441\\u0442\\u0430\\u043c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f<\\/span> \\u0443 \\u043d\\u0430\\u0441 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u043b\\u043e\\u0441\\u044c, \\u0447\\u0442\\u043e \\u0442\\u044b &ndash; \\u0438\\u0441\\u0442\\u0438\\u043d\\u043d\\u044b\\u0439 \\u0432\\u0443\\u043d\\u0434\\u0435\\u0440\\u043a\\u0438\\u043d\\u0434! \\u041f\\u043e \\u0432\\u0441\\u0435\\u043c \\u0432\\u0438\\u0434\\u0430\\u043c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0441\\u0430\\u043c\\u044b\\u0435 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0435 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u0438. \\u0410 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e \\u043b\\u0438 \\u044d\\u0442\\u043e? \\u041c\\u043e\\u0436\\u0435\\u0442 \\u0431\\u044b\\u0442\\u044c, \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u0435\\u0448\\u044c, \\u043f\\u043e\\u0447\\u0435\\u043c\\u0443 \\u0442\\u044b \\u0445\\u043e\\u0442\\u0435\\u043b \\u0441\\u043e\\u0437\\u0434\\u0430\\u0442\\u044c \\u0443 \\u043d\\u0430\\u0441 \\u0442\\u0430\\u043a\\u043e\\u0435 \\u0432\\u043f\\u0435\\u0447\\u0430\\u0442\\u043b\\u0435\\u043d\\u0438\\u0435?<\\/p>\\n<p><span style=\\"color: #2761a0;\\">\\u0427\\u0442\\u043e \\u043a\\u0430\\u0441\\u0430\\u0435\\u0442\\u0441\\u044f \\u0442\\u0432\\u043e\\u0435\\u0433\\u043e \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u0430,<\\/span> \\u0442\\u043e \\u0443 \\u043d\\u0430\\u0441 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u043b\\u043e\\u0441\\u044c, \\u0447\\u0442\\u043e \\u0442\\u044b \\u043e\\u0434\\u043d\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e \\u0438 \\u043b\\u044e\\u0431\\u0438\\u0448\\u044c \\u0431\\u044b\\u0442\\u044c \\u0441 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438, \\u0438 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u0447\\u0438\\u0442\\u0430\\u0435\\u0448\\u044c \\u043e\\u0434\\u0438\\u043d\\u043e\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e. \\u0422\\u044b \\u043e\\u0434\\u043d\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e \\u043d\\u0430\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u044b\\u0439, \\u0443\\u043f\\u0440\\u044f\\u043c\\u044b\\u0439, \\u0438 \\u0432 \\u0442\\u043e \\u0436\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u0441\\u043a\\u043b\\u043e\\u043d\\u0435\\u043d \\u043c\\u0435\\u043d\\u044f\\u0442\\u044c \\u0441\\u0432\\u043e\\u0435 \\u0441\\u043e\\u0441\\u0442\\u043e\\u044f\\u043d\\u0438\\u0435 \\u0432 \\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u043e\\u0442 \\u0441\\u0438\\u0442\\u0443\\u0430\\u0446\\u0438\\u0438. \\u0422\\u044b \\u0432 \\u0440\\u0430\\u0432\\u043d\\u043e\\u0439 \\u0441\\u0442\\u0435\\u043f\\u0435\\u043d\\u0438 \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d \\u0432 \\u0441\\u0435\\u0431\\u0435, \\u043d\\u043e \\u0432 \\u0442\\u043e \\u0436\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0431\\u0435\\u0441\\u043f\\u043e\\u043a\\u043e\\u0438\\u0442\\u044c\\u0441\\u044f \\u043e \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u043f\\u043e\\u0434\\u0443\\u043c\\u0430\\u044e\\u0442 \\u0438\\u043b\\u0438 \\u0441\\u043a\\u0430\\u0436\\u0443\\u0442 \\u043e \\u0442\\u0435\\u0431\\u0435 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0435, \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u0431\\u043e\\u043b\\u0435\\u0437\\u043d\\u0435\\u043d\\u043d\\u043e \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u0442\\u044c \\u043f\\u043e \\u043f\\u043e\\u0432\\u043e\\u0434\\u0443 \\u0443\\u043f\\u0440\\u0435\\u043a\\u043e\\u0432 \\u0438 \\u0437\\u0430\\u043c\\u0435\\u0447\\u0430\\u043d\\u0438\\u0439. \\u0421\\u0430\\u043c \\u0432\\u0438\\u0434\\u0438\\u0448\\u044c, \\u0447\\u0442\\u043e \\u043d\\u0430\\u043b\\u0438\\u0446\\u043e \\u043f\\u0440\\u043e\\u0442\\u0438\\u0432\\u043e\\u0440\\u0435\\u0447\\u0438\\u044f. &nbsp;\\u041e\\u0434\\u043d\\u0430\\u043a\\u043e \\u0435\\u0441\\u043b\\u0438 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a \\u0445\\u043e\\u0440\\u043e\\u0448\\u043e \\u0437\\u043d\\u0430\\u0435\\u0442 \\u0441\\u0435\\u0431\\u044f, \\u0441\\u0432\\u043e\\u0438 \\u0441\\u0438\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0438 \\u0441\\u043b\\u0430\\u0431\\u044b\\u0435 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b, \\u0442\\u043e \\u0435\\u043c\\u0443 \\u0433\\u043e\\u0440\\u0430\\u0437\\u0434\\u043e \\u043f\\u0440\\u043e\\u0449\\u0435 \\u0441\\u0442\\u0430\\u0432\\u0438\\u0442\\u0