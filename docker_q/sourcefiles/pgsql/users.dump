0430\\u0440. \\u0415\\u0441\\u043b\\u0438 \\u0442\\u044b \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u0438\\u043b\\u0430 \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0434\\u043e\\u0431\\u0440\\u043e\\u0441\\u043e\\u0432\\u0435\\u0441\\u0442\\u043d\\u043e, \\u0442\\u043e \\u044f \\u043c\\u043e\\u0433\\u0443 \\u0432\\u044b\\u0434\\u0432\\u0438\\u043d\\u0443\\u0442\\u044c \\u0433\\u0438\\u043f\\u043e\\u0442\\u0435\\u0437\\u0443, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u043f\\u043e\\u0434\\u043e\\u0439\\u0434\\u0435\\u0442 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u0441 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438, \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430. \\u041d\\u043e \\u0435\\u0441\\u043b\\u0438, \\u0435\\u0441\\u0442\\u044c \\u043e\\u0433\\u0440\\u043e\\u043c\\u043d\\u0430\\u044f \\u0442\\u044f\\u0433\\u0443 \\u043a \\u0436\\u0438\\u0432\\u043e\\u0442\\u043d\\u044b\\u043c \\u0438 \\u0435\\u0441\\u0442\\u044c \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c \\u0441 \\u043d\\u0438\\u043c\\u0438, \\u0442\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0442\\u044c \\u0441\\u0444\\u0435\\u0440\\u0443 \\u043f\\u043e \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u0443.<\\/span><\\/span><\\/p>\\n<p><span style=\\"color: #f3705c;\\"><strong>\\u0422\\u0438\\u043f \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f. <\\/strong><span style=\\"color: #000000;\\">\\u0415\\u0449\\u0435 \\u043e\\u0434\\u043d\\u043e \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u043e\\u0435 \\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u0435. \\u0423 \\u0442\\u0435\\u0431\\u044f \\u0441\\u0440\\u0430\\u0437\\u0443 \\u0442\\u0440\\u0438 \\u044f\\u0440\\u043a\\u0438\\u0445 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u044f! <strong>\\u041f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e &ndash; \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435, \\u043d\\u0430\\u0433\\u043b\\u044f\\u0434\\u043d\\u043e &ndash; \\u043e\\u0431\\u0440\\u0430\\u0437\\u043d\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c.&nbsp;<\\/strong>\\u0412\\u043e-\\u043f\\u0435\\u0440\\u044b\\u0445, \\u044d\\u0442\\u043e \\u043e\\u0447\\u0435\\u043d\\u044c \\u0440\\u0435\\u0434\\u043a\\u043e. \\u0412\\u043e-\\u0432\\u0442\\u043e\\u0440\\u044b\\u0445, \\u044d\\u0442\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u0435\\u0442 \\u0440\\u0430\\u0441\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u0442\\u044c \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0431\\u043e\\u0433\\u0430\\u0442\\u0443\\u044e \\u043f\\u0430\\u043b\\u0438\\u0442\\u0440\\u0443 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439. \\u041f\\u0440\\u043e \\u043a\\u0440\\u0435\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c, \\u044f \\u043d\\u0435\\u043c\\u043d\\u043e\\u0433\\u043e \\u0432\\u044b\\u0448\\u0435 \\u043f\\u0438\\u0441\\u0430\\u043b\\u0430, \\u0447\\u0442\\u043e \\u044d\\u0442\\u043e \\u043e\\u0447\\u0435\\u043d\\u044c \\u043a\\u043e\\u043d\\u043a\\u0443\\u0440\\u0435\\u0442\\u043d\\u043e\\u0435 \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e. \\u042d\\u0442\\u043e \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0435 \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435, \\u0447\\u0442\\u043e \\u043e\\u043d\\u043e \\u0443 \\u0442\\u0435\\u0431\\u044f \\u043f\\u0440\\u0438\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442. \\u041f\\u0435\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e - \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u043c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435\\u043c \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u044e\\u0442 \\u043b\\u044e\\u0434\\u0438, \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u044b\\u0435 \\u0438\\u0437\\u0443\\u0447\\u0430\\u0442\\u044c \\u043c\\u0438\\u0440 \\u0447\\u0435\\u0440\\u0435\\u0437 \\u0434\\u0432\\u0438\\u0436\\u0435\\u043d\\u0438\\u0435. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0432\\u0441\\u0435 \\u0432 \\u043f\\u043e\\u0440\\u044f\\u0434\\u043a\\u0435 \\u0441 \\u0434\\u0432\\u0438\\u0433\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0439 \\u043a\\u043e\\u043e\\u0440\\u0434\\u0438\\u043d\\u0430\\u0446\\u0438\\u0435\\u0439. \\u0415\\u0449\\u0435 \\u0433\\u043e\\u0432\\u043e\\u0440\\u044f\\u0442, \\u0447\\u0442\\u043e \\u0443 \\u0442\\u043c\\u0430\\u043a\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439 \\"\\u0417\\u043e\\u043b\\u043e\\u0442\\u044b\\u0435 \\u0440\\u0443\\u043a\\u0438\\". <strong>\\u041d\\u0430\\u0433\\u043b\\u044f\\u0434\\u043d\\u043e-\\u043e\\u0431\\u0440\\u0430\\u0437\\u043d\\u044b\\u043c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435\\u043c&nbsp;<\\/strong>\\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u044e\\u0442 \\u043b\\u044e\\u0434\\u0438 \\u0441 \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u043c \\u0441\\u043a\\u043b\\u0430\\u0434\\u043e\\u043c \\u0443\\u043c\\u0430. \\u0422\\u044b \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043c\\u044b\\u0441\\u043b\\u0438\\u0442 \\u043e\\u0431\\u0440\\u0430\\u0437\\u0430\\u043c\\u0438, \\u043c\\u043e\\u0433\\u043e\\u0436\\u0435\\u0442 \\u0442\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u0438 \\u04