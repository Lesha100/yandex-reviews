3d\\u0438\\u044f \\u0432 \\u0443\\u0447\\u0435\\u0431\\u043d\\u043e\\u043c \\u0437\\u0430\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0438. \\u0415\\u0441\\u043b\\u0438 \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0435\\u0441\\u0442\\u044c \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441 \\u043d\\u0430 \\u043f\\u043e\\u043c\\u043e\\u0449\\u044c \\u0432 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0435 \\u043c\\u0435\\u0441\\u0442\\u0430 \\u043e\\u0431\\u0443\\u0447\\u0435\\u043d\\u0438\\u044f, \\u0442\\u043e \\u043d\\u0430\\u043c \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u043e\\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u0432 \\u043a\\u043e\\u043d\\u0441\\u0443\\u043b\\u044c\\u0442\\u0430\\u0446\\u0438\\u043e\\u043d\\u043d\\u043e\\u043c \\u0440\\u0435\\u0436\\u0438\\u043c\\u0435. \\u0421\\u043e\\u0442\\u043d\\u0438 \\u0443\\u0447\\u0435\\u0431\\u043d\\u044b\\u0445 \\u0437\\u0430\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0443\\u0447\\u0430\\u0442 \\u043f\\u0435\\u0434\\u0430\\u0433\\u043e\\u0433\\u0438\\u043a\\u0435 \\u0438 \\u043c\\u044b \\u0431\\u044b \\u0445\\u043e\\u0442\\u0435\\u043b\\u0438 \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c \\u0432\\u0432\\u043e\\u0434\\u043d\\u044b\\u0435 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0435: \\u0433\\u043e\\u0440\\u043e\\u0434 \\u0432 \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u043c \\u0442\\u044b \\u0445\\u043e\\u0447\\u0435\\u0448\\u044c \\u0443\\u0447\\u0438\\u0442\\u044c\\u0441\\u044f, \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0441\\u0442\\u0443\\u043f\\u0435\\u043d\\u044c \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f.&nbsp;<\\/p>\\n<p><strong>\\u041f\\u0435\\u0434\\u0430\\u0433\\u043e\\u0433 \\u0441 \\u0433\\u0440\\u0435\\u0447\\u0435\\u0441\\u043a\\u043e\\u0433\\u043e \\u044f\\u0437\\u044b\\u043a\\u0430<\\/strong> &ndash; &laquo;\\u0432\\u0435\\u0434\\u0443\\u0449\\u0438\\u0439 \\u0440\\u0435\\u0431\\u0451\\u043d\\u043a\\u0430&raquo;. \\u042d\\u0442\\u043e \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442 \\u0444\\u043e\\u0440\\u043c\\u0438\\u0440\\u0443\\u044e\\u0449\\u0438\\u0439 \\u0443\\u0447\\u0435\\u0431\\u043d\\u043e-\\u0432\\u043e\\u0441\\u043f\\u0438\\u0442\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441 \\u0438 \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0438\\u0432\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0435\\u0433\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0432\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440 \\u0434\\u043b\\u044f \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430.&nbsp;<\\/p>\\n<p><span style=\\"color: #f3705c;\\"><strong>\\u0427\\u0442\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e?<\\/strong><\\/span><\\/p>\\n<p>\\u0415\\u0441\\u0442\\u044c \\u0434\\u0432\\u0430 \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u0430 \\u043a \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u043c\\u0443 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0443. \\u041f\\u0435\\u0440\\u0432\\u044b\\u0439, \\u043a\\u043b\\u0430\\u0441\\u0441\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440 - \\u0443 \\u043c\\u0435\\u043d\\u044f \\u0445\\u043e\\u0440\\u043e\\u0448\\u0438\\u0435 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438 \\u043f\\u043e \\u043b\\u0438\\u0442\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u0435 \\u0438 \\u044f \\u043f\\u043e\\u0439\\u0434\\u0443 \\u0443\\u0447\\u0438\\u0442\\u044c\\u0441\\u044f \\u043d\\u0430 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b\\u0438\\u0441\\u0442\\u0430, \\u0438\\u043b\\u0438 \\u0443 \\u043c\\u0435\\u043d\\u044f \\u0445\\u043e\\u0440\\u043e\\u0448\\u0438\\u0435 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438 \\u043f\\u043e \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0435, \\u044f \\u0431\\u0443\\u0434\\u0443 \\u0443\\u0447\\u0438\\u0442\\u044c\\u0441\\u044f \\u043d\\u0430 \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0430. \\u0422\\u043e \\u0435\\u0441\\u0442\\u044c \\u0438\\u0434\\u0442\\u0438 \\u043e\\u0442 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u0438\\u0441\\u0442\\u043e\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u043b\\u0443\\u0447\\u0448\\u0435. \\u042d\\u0442\\u043e \\u0440\\u0430\\u0441\\u043f\\u0440\\u043e\\u0441\\u0442\\u0440\\u0430\\u043d\\u0435\\u043d\\u043d\\u044b\\u0439 \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440, \\u0431\\u043e\\u043b\\u044c\\u0448\\u0438\\u043d\\u0441\\u0442\\u0432\\u043e \\u043c\\u043e\\u043b\\u043e\\u0434\\u044b\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439 \\u0441\\u043e\\u0432\\u0435\\u0440\\u0448\\u0430\\u044e\\u0442 \\u0441\\u0432\\u043e\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 \\u0438\\u043c\\u0435\\u043d\\u043d\\u043e \\u043d\\u0430 \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0438 \\u0448\\u043a\\u043e\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0443\\u0441\\u043f\\u0435\\u0432\\u0430\\u0435\\u043c\\u043e\\u0441\\u0442\\u0438.&nbsp;<\\/p>\\n<p>\\u0412\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u043b\\u043e\\u0436\\u043d\\u044b\\u0439, \\u043d\\u043e \\u043f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b\\u0439 - \\u0438\\u0434\\u0438 \\u043e\\u0442 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0438 \\u043e\\u0442 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0445\\u043e\\u0447\\u0435\\u