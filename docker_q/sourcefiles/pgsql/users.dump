29884	12	admin/users/report/edit/287/resume	POST	217.21.222.36	{"resume":"<p><span style=\\"font-weight: 400;\\">\\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0414\\u0430\\u0440\\u044c\\u044f<\\/span><\\/p>\\n<p><span style=\\"font-weight: 400;\\">\\u0422\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0432\\u044b\\u044f\\u0432\\u0438\\u043b\\u043e \\u0443 \\u0414\\u0430\\u0440\\u044c\\u0438 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c \\u0441\\u043f\\u043e\\u043d\\u0442\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438.&nbsp; \\u0412\\u044b\\u0441\\u043e\\u043a\\u0438\\u0435 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u0438 \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u043d\\u044b \\u0434\\u043b\\u044f \\u043b\\u044e\\u0434\\u0435\\u0439, \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u044e\\u0449\\u0438\\u0445 \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u043e\\u0439 \\u0440\\u0430\\u0441\\u043a\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e, \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u043a \\u0441\\u0430\\u043c\\u043e\\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044e, \\u0441\\u0442\\u0440\\u0435\\u043c\\u044f\\u0449\\u0438\\u0445\\u0441\\u044f \\u043a \\u043b\\u0438\\u0434\\u0435\\u0440\\u0441\\u0442\\u0432\\u0443, \\u043e\\u0434\\u043d\\u0430\\u043a\\u043e \\u0432 \\u043a\\u0440\\u0430\\u0439\\u043d\\u0438\\u0445 \\u0441\\u043b\\u0443\\u0447\\u0430\\u044f\\u0445 \\u0442\\u0430\\u043a\\u0438\\u0435 \\u0441\\u0432\\u043e\\u0439\\u0441\\u0442\\u0432\\u0430 \\u043c\\u043e\\u0433\\u0443\\u0442 \\u043f\\u0440\\u043e\\u044f\\u0432\\u043b\\u044f\\u0442\\u044c\\u0441\\u044f \\u0432 \\u0438\\u043c\\u043f\\u0443\\u043b\\u044c\\u0441\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u0438 \\u043f\\u0440\\u0438 \\u0441\\u043e\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u0438\\u0438 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430, \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u0438\\u0438 \\u043d\\u0435\\u043e\\u0431\\u0434\\u0443\\u043c\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0439.<\\/span><\\/p>\\n<p><span style=\\"font-weight: 400;\\">\\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u043b\\u044e\\u0431\\u044b\\u0435 \\u0440\\u0435\\u0436\\u0438\\u043c\\u043d\\u044b\\u0435, \\u0441\\u0442\\u0435\\u0441\\u043d\\u044f\\u044e\\u0449\\u0438\\u0435 \\u0440\\u0430\\u043c\\u043a\\u0438 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u044e\\u0442 \\u0443 \\u043d\\u0435\\u0435 \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0442\\u0438\\u0432\\u043e\\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u0442\\u044c \\u0438 \\u0441\\u0442\\u0440\\u0435\\u043c\\u0438\\u0442\\u044c\\u0441\\u044f \\u043a \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u0435,&nbsp; \\u0430 \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0437\\u0430\\u043f\\u0440\\u0435\\u0449\\u0435\\u043d\\u043e \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043b\\u044e\\u0431\\u043e\\u043f\\u044b\\u0442\\u0441\\u0442\\u0432\\u043e.&nbsp;<\\/span><\\/p>\\n<p><span style=\\"font-weight: 400;\\">\\u0412 \\u0443\\u0447\\u0435\\u0431\\u0435 \\u043e\\u043d\\u0430 \\u0441\\u0442\\u0430\\u0440\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u0430, \\u043f\\u0440\\u0438 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u0438 \\u0437\\u0430\\u0434\\u0430\\u043d\\u0438\\u0439 \\u0441\\u043a\\u043e\\u0440\\u0435\\u0435 \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u0435\\u0442&nbsp; \\u043d\\u0435 \\u043f\\u043e \\u043f\\u043e\\u0432\\u043e\\u0434\\u0443 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438 \\u043f\\u043e \\u043f\\u043e\\u0432\\u043e\\u0434\\u0443 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u043d\\u0435 \\u043e\\u043f\\u0440\\u0430\\u0432\\u0434\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043e\\u0436\\u0438\\u0434\\u0430\\u043d\\u0438\\u0439 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439. \\u0421\\u043a\\u043e\\u0440\\u0435\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e, \\u043f\\u0440\\u043e\\u044f\\u0432\\u043b\\u044f\\u0435\\u0442 \\u0432\\u0435\\u0440\\u043d\\u043e\\u0441\\u0442\\u044c \\u0438 \\u043f\\u0440\\u0435\\u0434\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432 \\u0434\\u0440\\u0443\\u0436\\u0431\\u0435.<\\/span><\\/p>\\n<p><span style=\\"font-weight: 400;\\">\\u0423\\u043c\\u0435\\u0440\\u0435\\u043d\\u043d\\u044b\\u0435 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u0438 \\u044d\\u043a\\u0441\\u0442\\u0440\\u0430\\u0432\\u0435\\u0440\\u0441\\u0438\\u0438 \\u043c\\u043e\\u0433\\u0443\\u0442 \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u043e \\u0414\\u0430\\u0440\\u044c\\u0435 \\u043a\\u0430\\u043a \\u043e \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0435 \\u043e\\u0431\\u0449\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u043c, \\u043e\\u0440\\u0438\\u0435\\u043d\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u043c \\u0432\\u0437\\u0430\\u0438\\u043c\\u043e\\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u0435 \\u0441 \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c\\u0438 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u043e\\u043d\\u0430 \\u0440\\u0430\\u0437\\u0433\\u043e\\u0432\\u043e\\u0440\\u0447\\u0438\\u0432\\u0430 \\u0438 \\u0430\\u043a\\u0442\\u0438\\u0432\\u043d\\u0430 \\u0432 \\u043d\\u0430\\u043b\\u0430\\u0436\\u0438\\u0432\\u0430\\u043d\\u0438\\u0438 \\u0434\\u0440\\u0443\\u0436\\u0435\\u0441\\u043a\\u0438\\u0445 \\u0438 \\u0434\\u0435\\u043b\\u043e\\u0432\\u044b\\u0445 \\u043a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442\\u043e\\u0432. \\u041d\\u043e \\u0447\\u0435\\u043c \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438\\u0442\\u0441\\u044f \\u0434\\u0440\\u0443\\u0437\\u0435\\u0439, \\u0442\\u0435\\u043c \\u043c\\u0435\\u043d\\u0435\\u0435 \\u043a\\u0440\\u0435\\u043f\\u043a\\u043e\\u0439 \\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438\\u0442\\u0441\\u044f \\u0434\\u0440\\u0443\\u0436\\u0431\\u0430.<\\/span><\\/p>\\n<p><span style=\\"font-weight: 400;\\">\\u0422\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0437\\u0430\\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043b\\u043e \\u044f\\u0440\\u043a\\u0443\\u044e \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u043d\\u0430\\u0433\\u043b\\u044f\\u0434\\u043d\\u043e-\\u043e\\u0431\\u0440\\u0430\\u0437\\u043d\\u043e\\u0433\\u043e \\u0442\\u0438\\u043f\\u0430 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f. \\u042d\\u0442\\u043e \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442 \\u043e \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0443 \\u0414\\u0430\\u0440\\u044c\\u0438 \\u043f\\u043e\\u043b\\u043d\\u043e \\u0438\\u0434\\u0435\\u0439 \\u0438&nbsp; \\u043e\\u043d\\u0430 \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430&nbsp; \\u0433\\u043e\\u0442\\u043e\\u0432\\u0430 \\u043f\\u0440\\u0438\\u0434\\u0443\\u043c\\u0430\\u0442\\u044c \\u0447\\u0442\\u043e-\\u043d\\u0438\\u0431\\u0443\\u0434\\u044c \\u043d\\u043e\\u0432\\u0435\\u043d\\u044c\\u043a\\u043e\\u0435. \\u041e\\u043d\\u0430 \\u0440\\u0438\\u0441\\u0443\\u0435\\u0442, \\u043f\\u0440\\u0438\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0442\\u0430\\u043d\\u0446\\u044b \\u0438 \\u0434\\u0430\\u0436\\u0435 \\u0446\\u0435\\u043b\\u044b\\u0435 \\u043a\\u043e\\u043d\\u0446\\u0435\\u0440\\u0442\\u044b \\u0438\\u043b\\u0438 \\u0441\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 \\u0432\\u0438\\u0434\\u0435\\u043e\\u0440\\u043e\\u043b\\u0438\\u043a\\u0438. \\u041f\\u043e\\u043c\\u043d\\u0438\\u0442\\u0435, \\u0447\\u0442\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438\\u0434\\u0443\\u043c\\u0430\\u0442\\u044c, \\u043d\\u043e \\u0438 \\u043e\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c, \\u0432\\u044b\\u0440\\u0430\\u0437\\u0438\\u0442\\u044c, \\u043e\\u0431\\u044a\\u044f\\u0441\\u043d\\u0438\\u0442\\u044c, \\u0441\\u043e\\u0437\\u0434\\u0430\\u0442\\u044c. \\u0412 \\u0440\\u0430\\u0432\\u043d\\u043e\\u0439 \\u0441\\u0442\\u0435\\u043f\\u0435\\u043d\\u0438 \\u043e\\u0442\\u043c\\u0435\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u0438 \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a \\u0430\\u0431\\u0441\\u0442\\u0440\\u0430\\u043a\\u0442\\u043d\\u043e-\\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u043c\\u0443 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044e. \\u042d\\u0442\\u0430 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u043e\\u043b\\u0435\\u0437\\u043d\\u0430 \\u0432 \\u043b\\u044e\\u0431\\u043e\\u0439 \\u043d\\u0430\\u0443\\u043a\\u0435, \\u043f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0447\\u0442\\u043e \\u0438 \\u0433\\u0443\\u043c\\u0430\\u043d\\u0438\\u0442\\u0430\\u0440\\u043d\\u044b\\u0435 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f, \\u0438 \\u0442\\u0435\\u0445\\u043d\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438, \\u0438 \\u0435\\u0441\\u0442\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e-\\u043d\\u0430\\u0443\\u0447\\u043d\\u044b\\u0435 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u044b \\u0442\\u0440\\u0435\\u0431\\u0443\\u044e\\u0442 \\u0432\\u044b\\u0441\\u043e\\u043a\\u043e\\u0433\\u043e \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u044f \\u0441\\u0432\\u044f\\u0437\\u0435\\u0439 \\u0438 \\u043e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u0439 \\u043c\\u0435\\u0436\\u0434\\u0443 \\u0432\\u0435\\u0449\\u0430\\u043c\\u0438, \\u0443\\u043c\\u0435\\u043d\\u0438\\u044f \\u0430\\u0431\\u0441\\u0442\\u0440\\u0430\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f \\u0438 \\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u0432\\u044b\\u0432\\u043e\\u0434\\u044b.<\\/span> <span style=\\"font-weight: 400;\\">\\u0418\\u0437 \\u043f\\u0440\\u0438\\u043a\\u043b\\u0430\\u0434\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435, \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0430 \\u0438 \\u044d\\u043a\\u043e\\u043d\\u043e\\u043c\\u0438\\u043a\\u0430 \\u043e\\u0431\\u044b\\u0447\\u043d\\u043e \\u043b\\u0443\\u0447\\u0448\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u044f\\u0442 \\u043b\\u044e\\u0434\\u044f\\u043c \\u0441 \\u0434\\u043e\\u043c\\u0438\\u043d\\u0438\\u0440\\u0443\\u044e\\u0449\\u0438\\u043c \\u0430\\u0431\\u0441\\u0442\\u0440\\u0430\\u043a\\u0442\\u043d\\u043e-\\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u043c \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435\\u043c.<\\/span><\\/p>"}	2021-06-03 11:49:33	2021-06-03 11:49:33
