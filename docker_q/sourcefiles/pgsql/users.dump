20164	10	admin/users/report/edit/236/resume	POST	77.238.236.109	{"resume":"<p><span style=\\"color: #2761a0;\\">\\u0418\\u0441\\u0445\\u043e\\u0434\\u044f \\u0438\\u0437 \\u0430\\u043d\\u0430\\u043b\\u0438\\u0437\\u0430 \\u0430\\u043d\\u043a\\u0435\\u0442\\u044b<\\/span>, \\u0412\\u0430\\u0448 \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0435\\u0442 \\u0434\\u043b\\u044f \\u0441\\u0435\\u0431\\u044f \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0443\\u044e \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432 \\u0441\\u043e\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u043d\\u043e \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u044f\\u0445. \\u0411\\u043e\\u043b\\u044c\\u0448\\u043e\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 - \\u044d\\u0442\\u043e \\u043f\\u0440\\u0435\\u043a\\u0440\\u0430\\u0441\\u043d\\u043e, \\u043d\\u043e \\u0434\\u0430\\u0432\\u0430\\u0439\\u0442\\u0435 \\u043f\\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0438\\u043c, \\u0447\\u0442\\u043e \\u0436\\u0435 \\u0432\\u044b\\u0448\\u043b\\u043e \\u043f\\u043e \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f.<\\/p>\\n<p><span style=\\"color: #2761a0;\\">\\u0422\\u0432\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0438\\u043f<\\/span>, \\u043f\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442, \\u0447\\u0442\\u043e \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0443 \\u043d\\u0430\\u0438\\u0431\\u043e\\u043b\\u0435\\u0435 \\u0431\\u043b\\u0438\\u0437\\u043a\\u043e \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e. \\u041e\\u0431\\u044b\\u0447\\u043d\\u043e \\u043b\\u044e\\u0434\\u0438 \\u044d\\u0442\\u043e\\u0439 \\u0441\\u0444\\u0435\\u0440\\u044b \\u043e\\u0431\\u043b\\u0430\\u0434\\u0