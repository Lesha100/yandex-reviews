441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435."},{"educational_institution":"\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435."},{"difficult_choice":"\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435."},{"parenting_difficulties":"\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435."},{"uninter_educ_subj":"\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044e \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u00ab\\u041f\\u0435\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u00bb, \\u0430 \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0442\\u0435\\u043c\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0430\\u043c \\u043d\\u0435 \\u0431\\u0435\\u0437\\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430. \\u0412 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043a \\u0432\\u0430\\u043c \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043a\\u0440\\u0435\\u043f\\u043b\\u0435\\u043d \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442 \\u0432\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f. \\u0422\\u0430\\u043a\\u0436\\u0435, \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0432\\u0430\\u0448\\u0435\\u0433\\u043e \\u0430\\u0434\\u0440\\u0435\\u0441\\u0430 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u043e\\u0439 \\u043f\\u043e\\u0447\\u0442\\u044b, \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0440\\u0430\\u0437\\u043e\\u0432\\u043e \\u043f\\u0435\\u0440\\u0435\\u0439\\u0442\\u0438 \\u043f\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0435 \\u043d\\u0438\\u0436\\u0435.\\u0417\\u0434\\u0440\\u0430\\u0432\\u0441\\u0442\\u0432\\u0443\\u0439\\u0442\\u0435!\\n\\u0412\\u044b