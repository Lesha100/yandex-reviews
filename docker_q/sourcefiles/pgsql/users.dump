14114	8	admin/users/report/edit/184/comment	POST	77.238.236.109	{"recommendations":"<p><strong><span style=\\"color: #2761a0;\\">\\u041e\\u0433\\u0440\\u043e\\u043c\\u043d\\u044b\\u043c\\u0438 \\u0440\\u0435\\u0441\\u0443\\u0440\\u0441\\u0430\\u043c\\u0438<\\/span><\\/strong> \\u0434\\u043b\\u044f \\u0442\\u0435\\u0431\\u044f \\u044f\\u0432\\u043b\\u044f\\u044e\\u0442\\u0441\\u044f: \\u0442\\u0432\\u043e\\u044f \\u0446\\u0435\\u043b\\u0435\\u0443\\u0441\\u0442\\u0440\\u043c\\u043b\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043b\\u044e\\u0431\\u043e\\u0432\\u044c \\u043a \\u0441\\u043f\\u043e\\u0440\\u0442\\u0443, \\u0432\\u044b\\u043d\\u043e\\u0441\\u043b\\u0438\\u0432\\u043e\\u0441\\u0442\\u044c, \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0438\\u043d\\u0442\\u0435\\u043b\\u043b\\u0435\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438. \\u0417\\u0430 \\u0447\\u0442\\u043e\\u0431\\u044b \\u0442\\u044b \\u043d\\u0435 \\u0432\\u0437\\u044f\\u043b\\u0441\\u044f \\u0443 \\u0442\\u0435\\u0431\\u044f \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u0445\\u043e\\u0440\\u043e\\u0448\\u043e. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e \\u0432 \\u044d\\u0442\\u043e\\u043c \\u0435\\u0441\\u0442\\u044c \\u0442\\u0440\\u0443\\u0434\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430, \\u043d\\u043e \\u0443\\u0447\\u0438\\u0442\\u044b\\u0432\\u0430\\u044f \\u0442\\u0432\\u043e\\u0438 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u0447\\u0442\\u0435\\u043d\\u0438\\u044f \\u0432 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0443 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b \\u043d\\u0430 \\u0442\\u0440\\u0430\\u043d\\u0441\\u043f\\u043e\\u0440\\u0442\\u0435. \\u0414\\u0430\\u043d\\u043d\\u0430\\u044f \\u0441\\u0444\\u0435\\u0440\\u0430 \\u043f\\u0440\\u0438\\u043d\\u0435\\u0441\\u0435\\u0442 \\u0442\\u0435\\u0431\\u0435 \\u0443\\u0434\\u043e\\u0432\\u043b\\u0435\\u0442\\u0432\\u043e\\u0440\\u0435\\u043d\\u0438\\u0435. \\u0420\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u044e \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0430\\u0442\\u044c \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044f\\u043c\\u0438 \\u0432 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438 \\u0441\\u043f\\u043e\\u0440\\u0442\\u0430 \\u0438 \\u0441\\u043c\\u0435\\u0448\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0435\\u0434\\u0438\\u043d\\u043e\\u0431\\u043e\\u0440\\u0441\\u0442\\u0432, \\u044d\\u0442\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0438\\u0442 \\u043d\\u0435\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0434\\u0435\\u0440\\u0436\\u0430\\u0442\\u044c \\u0441\\u0435\\u0431\\u044f \\u0432 \\u0442\\u043e\\u043d\\u0443\\u0441\\u0435, \\u043d\\u043e \\u0438 \\u0434\\u043e\\u0431\\u0438\\u0442\\u044c\\u0441\\u044f \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0432\\u044b\\u0441\\u043a\\u043e\\u0438\\u0445 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u0432 \\u0432 \\u044d\\u0442\\u043e\\u0439 \\u0441\\u0444\\u0435\\u0440\\u0435. \\u0412 \\u0434\\u0430\\u043b\\u044c\\u043d\\u0435\\u0439\\u0448\\u0435\\u043c \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0432\\u044b\\u0437\\u043e\\u0432\\u0435\\u0442 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044f - \\u0442\\u0440\\u0435\\u043d\\u0435\\u0440. \\u0425\\u043e\\u0447\\u0443 \\u043e\\u0431\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u0441\\u0432\\u044f\\u0437\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0441 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e\\u043c, \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0435\\u0441\\u0442\\u044c, \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0432 \\u0432\\u0438\\u0434\\u0435 \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044f \\u0437\\u0430\\u043d\\u044f\\u0442\\u044c\\u0441\\u044f \\u0430\\u0440\\u0430\\u0442\\u043e\\u0440\\u0441\\u043a\\u0438\\u043c \\u043c\\u0430\\u0441\\u0442\\u0435\\u0440\\u0441\\u0442\\u0432\\u043e\\u043c, \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\\u0438\\u0435\\u0439, \\u043c\\u0443\\u0437\\u044b\\u043a\\u043e\\u0439 \\u0438 \\u0442.\\u043f. \\u0410\\u0440\\u0430\\u0442\\u043e\\u0440\\u0441\\u043a\\u043e\\u0435 \\u043c\\u0430\\u0441\\u0442\\u0435\\u0440\\u0441\\u0442\\u0432\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0438\\u0442 \\u043f\\u043e\\u0432\\u044b\\u0441\\u0438\\u0442 \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432 \\u0441\\u0435\\u0431\\u0435.&nbsp;<\\/p>\\n<p>\\u0422\\u0430\\u043a \\u043a\\u0430\\u043a \\u043d\\u0435\\u0442 \\u044f\\u0440\\u043a\\u043e \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u044b\\u0445 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0435\\u0439, \\u0433\\u0434\\u0435 \\u043c\\u044b \\u043c\\u043e\\u0433\\u043b\\u0438 100% \\u0441\\u043a\\u0430\\u0437\\u0430\\u0442\\u044c, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0443 \\u043d\\u0443\\u0436\\u043d\\u043e \\u0438\\u0434\\u0442\\u0438 \\u0432 \\u044d\\u0442\\u0443 \\u0441\\u0444\\u0435\\u0440\\u0443, \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u044e \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0442\\u044c \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0438\\u0437\\u043d\\u0430\\u0447\\u0430\\u043b\\u044c\\u043d\\u043e \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u043e. \\u0420\\u0430\\u0431\\u043e\\u0442\\u0430 \\u043d\\u0430 \\u0442\\u0440\\u0430\\u043d\\u0441\\u043f\\u043e\\u0440\\u0442\\u0435 \\u0438\\u043c\\u0435\\u0435\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0435 \\u043c\\u043e\\u0434\\u0438\\u0444\\u0438\\u043a\\u0430\\u0446\\u0438\\u0438 - \\u044d\\u0442\\u043e \\u0438 \\u043d\\u0430\\u0437\\u0435\\u043c\\u043d\\u044b\\u0439, \\u0432\\u043e\\u0437\\u0434\\u0443\\u0448\\u043d\\u044b\\u0439, \\u0432\\u043e\\u0434\\u043d\\u044b\\u0439 \\u0442\\u0440\\u0430\\u043d\\u0441\\u043f\\u043e\\u0440\\u0442\\u044b, \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0443\\u0433\\u043b\\u0443\\u0431\\u0438\\u0442\\u044c\\u0441\\u044f \\u0432 \\u0438\\u0445 \\u0438\\u0437\\u0443\\u0447\\u0435\\u043d\\u0438\\u0435.<\\/p>","name":"\\u0417\\u0438\\u043d\\u0435\\u0434\\u0438\\u043d \\u0417\\u0438\\u0434\\u0430\\u043d","post":"\\u0444\\u0443\\u0442\\u0431\\u043e\\u043b\\u0438\\u0441\\u0442","comment":"\\u042f \\u043f\\u043b\\u0430\\u043a\\u0430\\u043b, \\u043f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0447\\u0442\\u043e \\u0443 \\u043c\\u0435\\u043d\\u044f \\u043d\\u0435 \\u0431\\u044b\\u043b\\u043e \\u0444\\u0443\\u0442\\u0431\\u043e\\u043b\\u044c\\u043d\\u044b\\u0445 \\u043a\\u0435\\u0434, \\u043d\\u043e \\u043e\\u0434\\u043d\\u0430\\u0436\\u0434\\u044b \\u044f \\u0432\\u0441\\u0442\\u0440\\u0435\\u0442\\u0438\\u043b \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a\\u0430 \\u0443 \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0433\\u043e \\u043d\\u0435 \\u0431\\u044b\\u043b\\u043e \\u043d\\u043e\\u0433.."}	2021-01-25 12:05:12	2021-01-25 12:05:12
