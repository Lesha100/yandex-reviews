7	2	Данный тест является частью программы, разработанной "Научно-практическим центром детской неврологии им. Сухаревой" и используется в целях удаленной первичной диагностики	["\\u041f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0435 \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435, \\u0435\\u0441\\u043b\\u0438 \\u0412\\u044b \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043d\\u044b \\u0441 \\u043d\\u0438\\u043c \\u043d\\u0430\\u0436\\u043c\\u0438\\u0442\\u0435 \\"\\u0412\\u0435\\u0440\\u043d\\u043e\\", \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0435 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043d\\u044b \\"\\u041d\\u0435\\u0432\\u0435\\u0440\\u043d\\u043e\\"","\\u0411\\u0443\\u0434\\u044c\\u0442\\u0435 \\u0432\\u043d\\u0438\\u043c\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b: \\u0435\\u0441\\u043b\\u0438 \\u0437\\u0432\\u0443\\u0447\\u0438\\u0442 \\u043e\\u0442\\u0440\\u0438\\u0446\\u0430\\u043d\\u0438\\u0435, \\u043a \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440\\u0443 \\u00ab\\u042f \\u043d\\u0435 \\u043b\\u044e\\u0431\\u043b\\u044e \\u0445\\u043e\\u0434\\u0438\\u0442\\u044c \\u0432 \\u0433\\u043e\\u0441\\u0442\\u0438...\\u00bb, \\u0442\\u043e \\u0432\\u0430\\u0448\\u0435 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0438\\u0435 - \\u00ab\\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0435\\u043d, \\u043d\\u0435 \\u043b\\u044e\\u0431\\u043b\\u044e\\u00bb \\u043e\\u0431\\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u043a\\u0430\\u043a \\u00ab\\u0412\\u0435\\u0440\\u043d\\u043e\\u00bb.","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043d\\u0435 \\u0442\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u043c\\u043d\\u043e\\u0433\\u043e \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438 \\u043d\\u0430 \\u043e\\u0431\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u043d\\u0438\\u0435","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043e\\u0442\\u0432\\u0435\\u0447\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a \\u043c\\u043e\\u0436\\u043d\\u043e \\u0438\\u0441\\u043a\\u0440\\u0435\\u043d\\u043d\\u0435\\u0439","\\u041f\\u043e\\u043c\\u043d\\u0438\\u0442\\u0435, \\u0447\\u0442\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b \\u043d\\u0430 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441 \\u043d\\u0438\\u0433\\u0434\\u0435 \\u043d\\u0435 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f, \\u0438 \\u043d\\u0438\\u043a\\u0442\\u043e (\\u0434\\u0430\\u0436\\u0435 \\u0432\\u044b \\u0441\\u0430\\u043c\\u0438) \\u043d\\u0435 \\u0441\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0438\\u0445 \\u0443\\u0432\\u0438\\u0434\\u0435\\u0442\\u044c \\u043f\\u043e \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u043d\\u0438\\u0438 \\u0442\\u0435\\u0441\\u0442\\u0430","\\u041f\\u043e \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u043d\\u0438\\u0438 \\u0442\\u0435\\u0441\\u0442\\u0430 \\u0432\\u044b \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u0435 \\u043a\\u0440\\u0430\\u0442\\u043a\\u0438\\u0439 \\u043e\\u0442\\u0447\\u0435\\u0442 \\u0441 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u043c"]	2020-12-22 14:39:32	2021-03-01 17:25:30
5	5	Данный тест является частью программы, разработанной "Научно-практическим центром детской неврологии им. Сухаревой" и используется в целях первичной удаленной диагностики	["\\u041f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0435 \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435, \\u0435\\u0441\\u043b\\u0438 \\u0412\\u044b \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043d\\u044b \\u0441 \\u043d\\u0438\\u043c \\u043d\\u0430\\u0436\\u043c\\u0438\\u0442\\u0435 \\"\\u0414\\u0430\\", \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0435 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043d\\u044b \\"\\u041d\\u0435\\u0442\\"","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043d\\u0435 \\u0442\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u043c\\u043d\\u043e\\u0433\\u043e \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438 \\u043d\\u0430 \\u043e\\u0431\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u043d\\u0438\\u0435","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043e\\u0442\\u0432\\u0435\\u0447\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a \\u043c\\u043e\\u0436\\u043d\\u043e \\u0438\\u0441\\u043a\\u0440\\u0435\\u043d\\u043d\\u0435\\u0439","\\u041f\\u043e\\u043c\\u043d\\u0438\\u0442\\u0435, \\u0447\\u0442\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b \\u043d\\u0430 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441 \\u043d\\u0438\\u0433\\u0434\\u0435 \\u043d\\u0435 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f, \\u0438 \\u043d\\u0438\\u043a\\u0442\\u043e (\\u0434\\u0430\\u0436\\u0435 \\u0432\\u044b \\u0441\\u0430\\u043c\\u0438) \\u043d\\u0435 \\u0441\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0438\\u0445 \\u0443\\u0432\\u0438\\u0434\\u0435\\u0442\\u044c \\u043f\\u043e \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u043d\\u0438\\u0438 \\u0442\\u0435\\u0441\\u0442\\u0430","\\u041f\\u043e \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u043d\\u0438\\u0438 \\u0442\\u0435\\u0441\\u0442\\u0430 \\u0432\\u044b \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u0435 \\u043a\\u0440\\u0430\\u0442\\u043a\\u0438\\u0439 \\u043e\\u0442\\u0447\\u0435\\u0442 \\u0441 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u043c"]	2020-12-15 15:57:28	2021-03-01 17:26:10
10	15	Предлагаемый Вам опросник содержит утверждения о воспитании детей.	["\\u0415\\u0441\\u043b\\u0438 \\u0412\\u044b \\u0432 \\u0446\\u0435\\u043b\\u043e\\u043c \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043d\\u044b \\u0441 \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435\\u043c, \\u0432\\u044b\\u0431\\u0435\\u0440\\u0438\\u0442\\u0435 \\u043e\\u0442\\u0432\\u0435\\u0442 \\u00ab\\u0434\\u0430\\u00bb.","\\u0415\\u0441\\u043b\\u0438 \\u0432 \\u0446\\u0435\\u043b\\u043e\\u043c \\u043d\\u0435 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043d\\u044b \\u2013 \\u043e\\u0442\\u0432\\u0435\\u0442 \\u00ab\\u043d\\u0435\\u0442\\u00bb.","\\u0415\\u0441\\u043b\\u0438 \\u043e\\u0447\\u0435\\u043d\\u044c \\u0442\\u0440\\u0443\\u0434\\u043d\\u043e \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0438\\u0442\\u044c\\u0441\\u044f, \\u0432\\u044b\\u0431\\u0435\\u0440\\u0438\\u0442\\u0435 \\u043e\\u0442\\u0432\\u0435\\u0442 \\u00ab\\u043d\\u0435 \\u0437\\u043d\\u0430\\u044e\\u00bb.","\\u041f\\u043e\\u0441\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c, \\u0447\\u0442\\u043e\\u0431\\u044b \\u043e\\u0442\\u0432\\u0435\\u0442\\u043e\\u0432 \\u00ab\\u043d\\u0435 \\u0437\\u043d\\u0430\\u044e\\u00bb \\u0431\\u044b\\u043b\\u043e \\u043d\\u0435 \\u0431\\u043e\\u043b\\u0435\\u0435 5 (\\u0432 \\u0438\\u043d\\u043e\\u043c \\u0441\\u043b\\u0443\\u0447\\u0430\\u0435 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u043c\\u043e\\u0433\\u0443\\u0442 \\u0431\\u044b\\u0442\\u044c \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u043e\\u0432\\u0435\\u0440\\u043d\\u044b\\u043c\\u0438)"]	2021-04-13 12:48:02	2021-04-13 15:21:06
6	3	Данный тест является частью программы, разработанной "Научно-практическим центром детской неврологии им. Сухаревой" и используется для помощи в выборе профессии и помощи в определении типа мышления.	["\\u0412\\u044b\\u0431\\u0438\\u0440\\u0430\\u044f \\u0438\\u0437 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u043f\\u0430\\u0440\\u044b \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 - \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0439\\u0442\\u0435 \\u0442\\u0443 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u0432 \\u043d\\u0430\\u0438\\u0431\\u043e\\u043b\\u044c\\u0448\\u0435\\u0439 \\u0441\\u0442\\u0435\\u043f\\u0435\\u043d\\u0438 \\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442 \\u0432\\u0430\\u0448\\u0438\\u043c \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u044f\\u043c.","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043d\\u0435 \\u0442\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u043c\\u043d\\u043e\\u0433\\u043e \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438 \\u043d\\u0430 \\u043e\\u0431\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u043d\\u0438\\u0435","\\u0421\\u0442\\u0430\\u0440\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c \\u043e\\u0442\\u0432\\u0435\\u0447\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a \\u043c\\u043e\\u0436\\u043d\\u043e \\u0438\\u0441\\u043a\\u0440\\u0435\\u043d\\u043d\\u0435\\u0439","\\u041d\\u0435\\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u043f\\u0430\\u0440\\u044b \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u043c\\u043e\\u0433\\u0443\\u0442 \\u0431\\u044b\\u0442\\u044c \\u043e\\u0434\\u0438\\u043d\\u0430\\u043a\\u043e\\u0432\\u043e \\u043d\\u0435\\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b \\u0432\\u0430\\u043c. \\u0422\\u043e\\u0433\\u0434\\u0430 \\u0432\\u044b\\u0431\\u0435\\u0440\\u0435\\u0442\\u0435 \\u0442\\u0