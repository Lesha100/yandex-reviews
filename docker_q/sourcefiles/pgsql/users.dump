30237	8	admin/users/report/edit/289/resume	POST	217.21.222.36	{"resume":"<p><strong>\\u041d\\u0435 \\u043f\\u0443\\u0433\\u0430\\u0439\\u0442\\u0435\\u0441\\u044c,<\\/strong> \\u0435\\u0441\\u043b\\u0438 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u043f\\u043e\\u043a\\u0430\\u0436\\u0443\\u0442\\u0441\\u044f \\"\\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c\\u0438\\". \\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438 - \\u044d\\u0442\\u043e \\u0440\\u0430\\u0441\\u0441\\u043a\\u0430\\u0437 \\u043e \\u0441\\u0435\\u0431\\u0435, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043d \\u0432 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u043e\\u0439 \\u0444\\u043e\\u0440\\u043c\\u0435. \\u041a\\u0430\\u043a \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0441\\u0442, \\u043c\\u043e\\u0433\\u0443 \\u043e\\u0442\\u043c\\u0435\\u0442\\u0438\\u0442\\u044c, \\u0447\\u0442\\u043e \\u0441\\u0438\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b \\u043c\\u043e\\u0433\\u0443\\u0442 \\u0440\\u0430\\u0441\\u043a\\u0440\\u044b\\u0442\\u044c\\u0441\\u044f \\u0432 \\u0442\\u043e\\u0439 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438, \\u0433\\u0434\\u0435 \\u0432\\u043e\\u043c\\u043e\\u0436\\u043d\\u043e \\u0433\\u0440\\u0430\\u043c\\u043e\\u0442\\u043d\\u043e \\u0440\\u0430\\u0441\\u043f\\u043e\\u0440\\u044f\\u0434\\u0438\\u0442\\u044c\\u0441\\u044f \\u0441\\u0432\\u043e\\u0438\\u043c \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0435\\u043c \\u0438 \\u0432\\u044b\\u0441\\u0442\\u0440\\u043e\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441 \\u0441\\u0430\\u043c\\u043e\\u0441\\u0442\\u043e\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e. \\u0411\\u043b\\u0430\\u0433\