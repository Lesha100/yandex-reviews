31265	11	admin/users/answersSave/381	POST	217.21.222.36	{"anket":[{"id":8,"text":"\\u041c\\u0430\\u043c\\u0430 \\u0438 \\u0434\\u0432\\u043e\\u0435 \\u0434\\u0435\\u0442\\u0435\\u0439 (\\u043e\\u0442\\u0446\\u044b \\u0440\\u0430\\u0437\\u043d\\u044b\\u0435, \\u0432\\u043c\\u0435\\u0441\\u0442\\u0435 \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0436\\u0438\\u0432\\u0430\\u044e\\u0442)","questions":null},{"id":10,"text":"\\u041d\\u0435\\u0442","questions":null},{"id":12,"text":"\\u041f\\u0435\\u0440\\u0438\\u043e\\u0434\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043d\\u0435\\u0442 \\u0440\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u043e\\u0439 \\u0443\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u0438","questions":[]},{"id":13,"text":"\\u0412 \\u043e\\u0431\\u0449\\u0435\\u043c, \\u0443 \\u043d\\u0430\\u0441 \\u0432\\u0441\\u0435 \\u0443\\u0436\\u0435 \\u0432\\u044b\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u043e, \\u0432 \\u043a\\u043e\\u043c\\u043d\\u0430\\u0442\\u0435 \\u043d\\u0435 \\u0438\\u0434\\u0435\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a, \\u043d\\u043e \\u044d\\u0442\\u043e \\u0442\\u043e\\u0436\\u0435 \\u043d\\u0435 \\u0442\\u043e, \\u0447\\u0442\\u043e\\u0431\\u044b \\u0433\\u0438\\u0433\\u0430\\u043d\\u0442\\u0441\\u043a\\u0430\\u044f \\u043f\\u0440\\u043e\\u0431\\u043b\\u0435\\u043c\\u0430. \\u0412\\u043e\\u0442 \\u0441\\u043b\\u043e\\u0436\\u043d\\u043e \\u043f\\u0440\\u0438\\u0443\\u0447\\u0438\\u0442\\u044c \\u0447\\u0438\\u0442\\u0430\\u0442\\u044c, \\u043d\\u043e \\u043f\\u043e\\u0442\\u0438\\u0445\\u043e\\u043d\\u044c\\u043a\\u0443 \\u0440\\u0435\\u0448\\u0430\\u0435\\u043c \\u0438 \\u044d\\u0442\\u043e","questions":[25]},{"id":14,"text":"\\u041c\\u0435\\u0436\\u0434\\u0443\\u043d\\u0430\\u0440\\u043e\\u0434\\u043d\\u044b\\u0439 \\u043a\\u043b\\u0430\\u0441\\u0441, \\u0432 \\u043f\\u0440\\u0438\\u043e\\u0440\\u0438\\u0442\\u0435\\u0442\\u0435 \\u0430\\u043d\\u0433\\u043b\\u0438\\u0439\\u0441\\u043a\\u0438\\u0439+\\u0434\\u0440\\u0443\\u0433\\u0438\\u0435 \\u044f\\u0437\\u044b\\u043a\\u0438 \\u0438 \\u043c\\u0430\\u0442\\u0435\\u043c\\u0430\\u0442\\u0438\\u043a\\u0430. \\u0411\\u044b\\u043b \\u0434\\u043e\\u043b\\u0433\\u0438\\u0439 \\u043f\\u043e\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 \\u0448\\u043a\\u043e\\u043b\\u044b \\u043f\\u043e \\u043e\\u0433\\u0440\\u043e\\u043c\\u043d\\u043e\\u043c\\u0443 \\u043a\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u0442\\u0432\\u0443 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u043e\\u0432","questions":null},{"id":15,"text":"\\u041f\\u043e\\u043d\\u044f\\u0442\\u044c \\u043a\\u0430\\u043a\\u0438\\u0435 \\u0440\\u0430\\u0437\\u0443\\u043c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u044b \\u0443 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430 \\u043d\\u0430 \\u043d\\u0430\\u0441\\u0442\\u043e\\u044f\\u0449\\u0438\\u0439 \\u043c\\u043e\\u043c\\u0435\\u043d\\u0442","questions":null},{"id":16,"text":"\\u042d\\u0442\\u0438 \\u043c\\u044b\\u0441\\u043b\\u0438 \\u043f\\u043e\\u043a\\u0430 \\u0445\\u0430\\u043e\\u0442\\u0438\\u0447\\u043d\\u044b, \\u0440\\u0435\\u0431\\u0435\\u043d\\u043e\\u043a \\u043d\\u0430\\u0446\\u0435\\u043b\\u0435\\u043d \\u043d\\u0430 \\u0442\\u043e, \\u0447\\u0442\\u043e\\u0431\\u044b \\u0431\\u044b\\u0442\\u044c \\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u044b\\u043c \\u0438 \\u0444\\u0438\\u043d\\u0430\\u043d\\u0441\\u043e\\u0432\\u043e \\u0441\\u0442\\u0430\\u0431\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c, \\u0441\\u043f\\u043e\\u0440\\u0442\\u0441\\u043c\\u0435\\u043d\\u043e\\u043c, \\u043f\\u0440\\u0438\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a\\u0438\\u0435-\\u0442\\u043e \\u043f\\u043e\\u043b\\u0435\\u0437\\u043d\\u044b\\u0435 \\u0434\\u043b\\u044f \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u044b \\u0432 \\u0442\\u043e\\u043c \\u0447\\u0438\\u0441\\u043b\\u0435, \\u0438\\u0434\\u0435\\u0430\\u043b\\u044c\\u043d\\u043e \\u0447\\u0442\\u043e-\\u0442\\u043e \\u0438\\u0437 \\u044d\\u0442\\u043e\\u0433\\u043e \\u0441\\u043e\\u0432\\u043c\\u0435\\u0441\\u0442\\u0438\\u0442\\u044c","questions":null},{"id":17,"text":"C 0 \\u0434\\u043e 8 \\u043c\\u043d\\u043e\\u0433\\u043e \\u043a\\u0440\\u0443\\u0436\\u043a\\u043e\\u0432 (\\u0433\\u043e\\u0440\\u043d\\u044b\\u0435 \\u043b\\u044b\\u0436\\u0438, \\u0432\\u0435\\u0440\\u0445\\u043e\\u0432\\u0430\\u044f \\u0435\\u0437\\u0434\\u0430, \\u043f\\u043b\\u0430\\u0432\\u0430\\u043d\\u0438\\u0435, \\u0440\\u0438\\u0441\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435, \\u0444\\u0443\\u0442\\u0431\\u043e\\u043b, \\u043a\\u0430\\u0440\\u0430\\u0442\\u0435, \\u0434\\u0437\\u044e\\u0434\\u043e, \\u0434\\u0436\\u0438\\u0443-\\u0434\\u0436\\u0438\\u0442\\u0441\\u0443. \\u0421 8 \\u043b\\u0435\\u0442 \\u2014 \\u0430\\u043c\\u0435\\u0440\\u0438\\u043a\\u0430\\u043d\\u0441\\u043a\\u0438\\u0439 \\u0444\\u0443\\u0442\\u0431\\u043e\\u043b (2,5 \\u0433\\u043e\\u0434\\u0430), \\u0441\\u043a\\u0435\\u0439\\u0442\\u0431\\u043e\\u0440\\u0434\\u0438\\u043d\\u0433 \\u2014 \\u0438 \\u043d\\u0430 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043c\\u043e\\u043c\\u0435\\u043d\\u0442.","questions":null},{"id":18,"text":"\\u041b\\u044e\\u0431\\u0438\\u0442 \\u0438\\u0433\\u0440\\u0430\\u0442\\u044c \\u0432 \\u043f\\u043b\\u0435\\u0439\\u0441\\u0442\\u0435\\u0439\\u0448\\u0435\\u043d, \\u0443\\u0432\\u043b\\u0435\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f \\u0433\\u043e\\u0442\\u043e\\u0432\\u043a\\u043e\\u0439, \\u043f\\u0440\\u0438\\u0434\\u0443\\u043c\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u0435 \\u0431\\u0438\\u0437\\u043d\\u0435\\u0441 \\u0438\\u0434\\u0435\\u0438, \\u043b\\u044e\\u0431\\u0438\\u0442 \\u0436\\u0438\\u0432\\u043e\\u0442\\u043d\\u044b\\u0445.","questions":null},{"id":19,"text":"\\u0421\\u0430\\u043c \\u2014 \\u0446\\u0435\\u043b\\u0435\\u0443\\u0441\\u0442\\u0440\\u0435\\u043c\\u043b\\u0451\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e, \\u0432 \\u0441\\u043f\\u043e\\u0440\\u0442\\u0435 \\u0432\\u0441\\u0451 \\u0445\\u043e\\u0440\\u043e\\u0448\\u043e \\u0441\\u043a\\u043b\\u0430\\u0434\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f, \\u0438\\u043c\\u0435\\u044e\\u0442\\u0441\\u044f \\u0430\\u0440\\u0442\\u0438\\u0441\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u0437\\u0430\\u0434\\u0430\\u0442\\u043a\\u0438. \\u041c\\u0430\\u043b\\u044c\\u0447\\u0438\\u043a\\u0443 \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0433\\u043e\\u0442\\u043e\\u0432\\u0438\\u0442\\u044c, \\u0441\\u0447\\u0438\\u0442\\u0430\\u0435\\u0442, \\u0447\\u0442\\u043e \\u044d\\u0442\\u043e \\u0437\\u0434\\u043e\\u0440\\u043e\\u0432\\u043e \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f.","questions":null},{"id":20,"text":"\\u0412\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0432 \\u0420\\u043e\\u0441\\u0441\\u0438\\u0438 (\\u0444\\u0443\\u0442\\u0431\\u043e\\u043b), \\u043a\\u043b\\u0430\\u0441\\u0441\\u043d\\u043e \\u0433\\u043e\\u0442\\u043e\\u0432\\u0438\\u0442, \\u0433\\u043e\\u0440\\u0434\\u0438\\u0442\\u0441\\u044f \\u0446\\u0435\\u043b\\u0435\\u0443\\u0441\\u0442\\u0440\\u0435\\u043c\\u043b\\u0451\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e (\\u0438 \\u043c\\u0430\\u043c\\u0430).","questions":null}]}	2021-06-30 19:31:57	2021-06-30 19:31:57
