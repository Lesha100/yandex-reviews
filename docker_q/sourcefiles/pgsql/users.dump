13768	8	admin/users/report/edit/184/resume	POST	94.45.197.3	{"resume":"<p><span style=\\"color: #2761a0;\\"><strong>\\u0418\\u0441\\u0445\\u043e\\u0434\\u044f \\u0438\\u0437 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u0432 \\u0442\\u0435\\u0441\\u0442\\u043e\\u0432 \\u0438 \\u043e\\u0442\\u0432\\u0435\\u0442\\u043e\\u0432 \\u043d\\u0430 \\u0430\\u043d\\u043a\\u0435\\u0442\\u0443<\\/strong><\\/span>, \\u043c\\u043e\\u0436\\u043d\\u043e \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0430\\u0442\\u044c, \\u0447\\u0442\\u043e \\u0442\\u044b \\u043f\\u043e\\u043a\\u0430 \\u043d\\u0435 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0438\\u043b\\u0441\\u044f \\u0441 \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0435\\u0439. \\u0412 \\u043f\\u0435\\u0440\\u0432\\u0443\\u044e \\u043e\\u0447\\u0435\\u0440\\u0435\\u0434\\u044c, \\u044d\\u0442\\u043e \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442, \\u0447\\u0442\\u043e\\u0442\\u0435\\u0431\\u0435 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e \\u043e\\u0442\\u0442\\u0430\\u043b\\u043a\\u0438\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f \\u043e\\u0442 \\u0441\\u0432\\u043e\\u0438\\u0445 \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u0439.<\\/p>"}	2021-01-24 23:11:21	2021-01-24 23:11:21
