0\\u0433\\u043d\\u043e\\u0441\\u0442\\u0438\\u043a\\u0430 \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u043c\\u043e\\u043d\\u0438\\u0442\\u043e\\u0440\\u0438\\u043d\\u0433 \\u043f\\u043e\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u0438 \\u043d\\u0430\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0438 \\u0432\\u043b\\u0430\\u0441\\u0442\\u043d\\u044b\\u043c\\u0438 \\u043f\\u043e\\u043b\\u043d\\u043e\\u043c\\u043e\\u0447\\u0438\\u044f\\u043c\\u0438. \\u0412 \\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u043e\\u0442 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u0438\\u0434\\u0451\\u0442\\u0441\\u044f \\u0441\\u0434\\u0430\\u0442\\u044c \\u044d\\u043a\\u0437\\u0430\\u043c\\u0435\\u043d\\u044b \\u043f\\u043e \\u043e\\u0431\\u0449\\u0435\\u0441\\u0442\\u0432\\u043e\\u0437\\u043d\\u0430\\u043d\\u0438\\u044e, \\u0438\\u0441\\u0442\\u043e\\u0440\\u0438\\u0438 \\u0420\\u043e\\u0441\\u0441\\u0438\\u0438 \\u0438\\u043b\\u0438 \\u0444\\u0438\\u0437\\u0438\\u043a\\u0435.<\\/span><\\/p>\\n<p><span style=\\"color: #707070;\\">\\u0420\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0443\\u044e \\u043f\\u043e\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u0438\\u0442\\u044c\\u0441\\u044f \\u0441\\u043e \\u0441\\u0442\\u0430\\u0442\\u044c\\u0435\\u0439 \\u043f\\u0440\\u043e \\u0442\\u0432\\u043e\\u044e \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u044e, \\u043f\\u0440\\u043e \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f, \\u043f\\u0440\\u043e \\u043f\\u043b\\u044e\\u0441\\u044b \\u0438 \\u043c\\u0438\\u043d\\u0443\\u0441\\u044b <a href=\\"https:\\/\\/tass.ru\\/obschestvo\\/5412056\\">https:\\/\\/narobraz.ru\\/professii\\/sluzhba-v-ufsin-plyusy-minusy-i-osobennosti.html<\\/a><\\/span><\\/p>","name":null,"post":null,"comment":"\\u041f\\u0440\\u0430\\u0432\\