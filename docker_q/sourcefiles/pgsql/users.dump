33551	16	admin/users/answersSave/417	POST	217.21.222.36	{"anket":[{"id":8,"text":"\\u0442\\u0440\\u043e\\u0435 \\u0434\\u0435\\u0442\\u0435\\u0439, \\u043f\\u043e\\u043b\\u043d\\u0430\\u044f","questions":null},{"id":10,"text":"1. \\u041a\\u0430\\u043a\\u0438\\u0435 \\u0435\\u0441\\u0442\\u044c \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u044b \\u0441\\u0435\\u0440\\u044c\\u0435\\u0437\\u043d\\u044b\\u0435, \\u0441 \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u043c\\u0438 \\u0434\\u0430\\u043b\\u044c\\u0448\\u0435 \\u043c\\u043e\\u0436\\u043d\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f. 2. \\u041a\\u0430\\u043a\\u043e\\u0439 \\u0441\\u043f\\u043e\\u0440\\u0442 \\u0431\\u044b\\u043b \\u0431\\u044b \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u0435\\u043d? 3. \\u041d\\u0430 \\u0447\\u0442\\u043e \\u043e\\u0440\\u0438\\u0435\\u043d\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f \\u043f\\u0440\\u0438 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0435 \\u0448\\u043a\\u043e\\u043b\\u044b?  \\u041e\\u0442\\u043d\\u043e\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043a\\u043b\\u0430\\u0441\\u0441\\u043d\\u043e\\u0433\\u043e \\u0440\\u0443\\u043a\\u043e\\u0432\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044f \\u043a \\u0441\\u044b\\u043d\\u0443 (\\u043f\\u043e\\u0432\\u044b\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0433\\u043e\\u043b\\u043e\\u0441\\u0430, \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u0430\\u044f \\u0438\\u043d\\u0434\\u0438\\u0432\\u0438\\u0434\\u0443\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u044f).","questions":null},{"id":12,"text":"\\u0411\\u043e\\u0438\\u0442\\u0441\\u044f \\u043f\\u0440\\u043e\\u0431\\u043e\\u0432\\u0430\\u0442\\u044c \\u043d\\u043e\\u0432\\u043e\\u0435","questions":[20,19,18]},{"id":13,"text":"\\u0418\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u0443\\u0435\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0442\\u043e, \\u0447\\u0442\\u043e \\u043b\\u0435\\u0433\\u043a\\u043e \\u0434\\u0430\\u0435\\u0442\\u0441\\u044f","questions":[14,11]},{"id":14,"text":"\\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0430 \\"\\u041f\\u0435\\u0440\\u0441\\u043f\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u0430\\u044f \\u043d\\u0430\\u0447\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0448\\u043a\\u043e\\u043b\\u0430\\"","questions":null},{"id":15,"text":"\\u043d\\u0430\\u0439\\u0442\\u0438 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u044b \\u0438 \\u043f\\u043e\\u043d\\u044f\\u0442\\u044c \\u0447\\u0442\\u043e \\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u0443\\u0435\\u0442 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u044b, \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u0435 \\u0432 \\u043d\\u0438\\u0445","questions":null},{"id":16,"text":"\\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u0430 (\\u0440\\u0435\\u043c\\u043e\\u043d\\u0442, \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0442\\u044c \\u0440\\u0443\\u043a\\u0430\\u043c\\u0438)","questions":null},{"id":17,"text":"\\u043d\\u0430 \\u0441\\u0435\\u0433\\u043e\\u0434\\u043d\\u044f\\u0448\\u043d\\u0438\\u0439 \\u043c\\u043e\\u043c\\u0435\\u043d\\u0442 \\u043d\\u0435\\u0442","questions":null},{"id":18,"text":"\\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u0430","questions":null},{"id":19,"text":"\\u0441\\u0430\\u043c\\u043e\\u0441\\u0442\\u043e\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439","questions":null},{"id":20,"text":"\\u043a\\u043e\\u043c\\u043f\\u044c\\u044e\\u0442\\u0435\\u0440 \\u0441\\u043e\\u0431\\u0440\\u0430\\u043b, \\u0442\\u0435\\u0445\\u043d\\u0438\\u043a\\u0443 \\u043e\\u0442\\u0440\\u0435\\u043c\\u043e\\u043d\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043b","questions":null}]}	2021-09-09 17:19:21	2021-09-09 17:19:21
