21088	1	admin/users/report/edit/239/resume	POST	77.238.236.109	{"resume":"<p style=\\"text-align: left;\\"><strong><span style=\\"color: #2761a0;\\">\\u041d\\u0435\\u0431\\u043e\\u043b\\u044c\\u0448\\u043e\\u0435 \\u043b\\u0438\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u0438\\u043d\\u0442\\u0440\\u043e.&nbsp;<\\/span><\\/strong><span style=\\"color: #000000;\\">\\u041d\\u0435 \\u043f\\u0435\\u0440\\u0435\\u0436\\u0438\\u0432\\u0430\\u0439, \\u0435\\u0441\\u043b\\u0438 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043f\\u043e\\u043a\\u0430\\u0436\\u0443\\u0442\\u0441\\u044f \\u0442\\u0435\\u0431\\u0435 \\"\\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c\\u0438\\" \\u0438\\u043b\\u0438 \\u0441\\u0442\\u0440\\u0430\\u043d\\u043d\\u044b\\u043c\\u0438. \\u041c\\u044b \\u0440\\u0430\\u0441\\u043a\\u0440\\u043e\\u0435\\u043c \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0435\\u0431\\u043e\\u043b\\u044c\\u0448\\u043e\\u0439 \\u0441\\u0435\\u043a\\u0440\\u0435\\u0442. \\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f - \\u044d\\u0442\\u043e \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0440\\u0430\\u0441\\u0441\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0448\\u044c \\u043e \\u0441\\u0435\\u0431\\u0435.&nbsp;<\\/span><\\/p>\\n<p style=\\"text-align: left;\\"><span style=\\"color: #000000;\\"><strong><span style=\\"color: #2761a0;\\">\\u0418\\u0441\\u0445\\u043e\\u0434\\u044f \\u0438\\u0437 \\u0430\\u043d\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432 \\u0430\\u043d\\u043a\\u0435\\u0442\\u044b<\\/span><\\/strong>, \\u0435\\u0441\\u0442\\u044c \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435, \\u0447\\u0442\\u043e \\u0442\\u044b \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u0440\\u0430\\u0437\\u043d\\u043e\\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u043d\\u044f\\u044f \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c. \\u0415\\u0441\\u0442\\u044c \\u0442\\u043e\\u0447\\u043d\\u043e\\u0435 \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u0442\\u044b \\u043d\\u0435\\u043f\\u043e\\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e \\u0432\\u0438\\u0434\\u0438\\u0448\\u044c \\u0441\\u0435\\u0431\\u044f \\u0432 \\u043c\\u0438\\u0440\\u0435 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430 \\u0438 \\u0432\\u0437\\u0430\\u0438\\u043c\\u043e\\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u044f \\u0441 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438. \\u0414\\u0430\\u0432\\u0430\\u0439 \\u043f\\u0435\\u0440\\u0435\\u0439\\u0434\\u0451\\u043c \\u043a \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0430\\u043c \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0438 \\u043f\\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0438\\u043c, \\u043a\\u0430\\u043a\\u0430\\u044f \\u0441\\u0444\\u0435\\u0440\\u0430 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0442\\u0435\\u0431\\u0435 \\u0431\\u043b\\u0438\\u0436\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e.<\\/span><\\/p>\\n<p style=\\"text-align: left;\\"><span style=\\"color: #000000;\\"><span style=\\"color: #2761a0;\\"><strong>\\u041f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0438\\u043f \\u043b\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u0438<\\/strong><\\/span>. \\u0417\\u0434\\u0435\\u0441\\u044c \\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0430\\u044e\\u0442\\u0441\\u044f \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b\\u0435 \\u0441\\u0432\\u044f\\u0437\\u043a\\u0438. \\u0422\\u044b \\u0441\\u043e\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a, \\u0443 \\u0442\\u0435\\u0431\\u044f \\u043d\\u0435 \\u0432\\u043e\\u0437\\u043d\\u0438\\u043a\\u0430\\u0435\\u0442 \\u0442\\u0440\\u0443\\u0434\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439 \\u043d\\u0430\\u0439\\u0442\\u0438 \\u0441 \\u043a\\u0435\\u043c-\\u0442\\u043e \\u043e\\u0431\\u0449\\u0438\\u0439 \\u044f\\u0437\\u044b\\u043a, \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440\\u044f\\u0442\\u044c \\u043d\\u0430 \\u0441\\u0435\\u0431\\u044f \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u0435 \\u0440\\u043e\\u043b\\u0438 \\u0438 \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u0442\\u044c \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432 \\u043a\\u043e\\u043c\\u043c\\u0443\\u043d\\u0438\\u043a\\u0430\\u0446\\u0438\\u0438 \\u0441 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438. \\u041f\\u043e \\u043f\\u0440\\u0438\\u0440\\u043e\\u0434\\u0435 \\u0442\\u0435\\u0431\\u0435 \\u0431\\u043b\\u0438\\u0437\\u043a\\u043e \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e, \\u0442\\u044b \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u0435\\u0448\\u044c \\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u043c \\u0442\\u0430\\u043b\\u0430\\u043d\\u0442\\u043e\\u043c, \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u043e\\u043c \\u0432\\u043a\\u0443\\u0441\\u0430 \\u0438 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u043d\\u044b\\u043c \\u043f\\u043e\\u043b\\u0451\\u0442\\u043e\\u043c \\u0432\\u043e\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u0438 \\u0437\\u0430\\u043d\\u044f\\u0442\\u0438\\u0438 \\u043b\\u044e\\u0431\\u0438\\u043c\\u044b\\u043c \\u0434\\u0435\\u043b\\u043e\\u043c. \\u041d\\u0430\\u043c \\u043a\\u0430\\u0436\\u0435\\u0442\\u0441\\u044f, \\u0447\\u0442\\u043e \\u043f\\u0435\\u0434\\u0430\\u0433\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u0438 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0442\\u0435\\u0431\\u0435 \\u043e\\u0447\\u0435\\u043d\\u044c \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u044f\\u0442. \\u0422\\u044b \\u043e\\u0431\\u0449\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a, \\u043d\\u0435 \\u0431\\u0443\\u0434\\u0435\\u0448\\u044c \\u0443\\u0441\\u0442\\u0430\\u0432\\u0430\\u0442\\u044c \\u043e\\u0442 \\u0432\\u0437\\u0430\\u0438\\u043c\\u043e\\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u044f \\u0441 \\u043b\\u044e\\u0434\\u044c\\u043c\\u0438. \\u0422\\u044b \\u043b\\u0435\\u0433\\u043a\\u043e \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043d\\u0430\\u0439\\u0442\\u0438 \\u0441\\u0435\\u0431\\u0435 \\u043d\\u043e\\u0432\\u043e\\u0435 \\u0443\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u0435. \\u0422\\u0435\\u0431\\u0435 \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u044f\\u0442 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u0441\\u0432\\u044f\\u0437\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0441 \\u043f\\u0435\\u0434\\u0430\\u0433\\u043e\\u0433\\u0438\\u043a\\u043e\\u0439, \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438\\u0435\\u0439 \\u0438 \\u0438\\u0437\\u043e\\u0431\\u0440\\u0430\\u0437\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u043c \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e\\u043c. \\u0415\\u0441\\u043b\\u0438 \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0442\\u043e \\u0433\\u0443\\u043c\\u0430\\u043d\\u0438\\u0442\\u0430\\u0440\\u043d\\u044b\\u0435 \\u043d\\u0430\\u0443\\u043a\\u0438 \\u0440\\u0435\\u043c\\u0435\\u0441\\u043b\\u0435\\u043d\\u043d\\u043e\\u0435 \\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e - \\u044d\\u0442\\u043e \\u0442\\u043e, \\u043d\\u0430 \\u0447\\u0442\\u043e \\u0441\\u0442\\u043e\\u0438\\u0442 \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u0430\\u043a\\u0446\\u0435\\u043d\\u0442. \\u0422\\u0430\\u043a\\u0436\\u0435 \\u043d\\u0435\\u043b\\u044c\\u0437\\u044f \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0430\\u0442\\u044c \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442 \\u043f\\u0435\\u0434\\u0430\\u0433\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0432 \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u0438 \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f (\\u043d\\u0430\\u043f\\u0440\\u0438\\u043c\\u0435\\u0440, \\u0430\\u043a\\u0442\\u0451\\u0440\\u0441\\u043a\\u043e\\u0435 \\u043c\\u0430\\u0441\\u0442\\u0435\\u0440\\u0441\\u0442\\u0432\\u043e \\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438\\u0442\\u0441\\u044f \\u043f\\u043e\\u043f\\u0443\\u043b\\u044f\\u0440\\u043d\\u0435\\u0435. \\u0422\\u0430\\u043a \\u043a\\u0430\\u043a \\u0438\\u0433\\u0440\\u0430\\u0435\\u043c \\u0440\\u043e\\u043b\\u0438 \\u043c\\u044b \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043d\\u0430 \\u0441\\u0446\\u0435\\u043d\\u0435, \\u043d\\u043e \\u0438 \\u0432 \\u043f\\u043e\\u0432\\u0441\\u0435\\u0434\\u043d\\u0435\\u0432\\u043d\\u043e\\u0439 \\u0436\\u0438\\u0437\\u043d\\u0438), \\u043f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0447\\u0442\\u043e, \\u043d\\u0430\\u043c \\u043a\\u0430\\u0436\\u0435\\u0442\\u0441\\u044f, \\u0447\\u0442\\u043e \\u044d\\u0442\\u043e \\u0431\\u0443\\u0434\\u0435\\u0442 \\u043f\\u0440\\u0438\\u043d\\u043e\\u0441\\u0438\\u0442\\u044c \\u0442\\u0435\\u0431\\u0435 \\u0443\\u0434\\u043e\\u0432\\u043e\\u043b\\u044c\\u0441\\u0442\\u0432\\u0438\\u0435.&nbsp;<\\/span><\\/p>\\n<p style=\\"text-align: left;\\"><span style=\\"color: #000000;\\"><strong><span style=\\"color: #2761a0;\\">\\u041e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438<\\/span><\\/strong>. \\u0422\\u044b \\u0447\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a-\\u0438\\u0441\\u043a\\u0443\\u0441\\u0441\\u0442\\u0432\\u043e. \\u0422\\u044b \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u0435\\u0448\\u044c \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u043a\\u0438\\u043c \\u0442\\u0430\\u043b\\u0430\\u043d\\u0442\\u043e\\u043c, \\u0442\\u0435\\u0431\\u0435 \\u043d\\u0435 \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u0438\\u0442 \\u0436\\u0451\\u0441\\u0442\\u043a\\u0438\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c \\u043f\\u043e \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u043d\\u044b\\u043c \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u044f\\u043c \\u0438 \\u0431\\u043b\\u0438\\u0436\\u0435 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u0430 \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0438\\u0439. \\u0412\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e, \\u0442\\u044b \\u0435\\u0449\\u0451 \\u043d\\u0435 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0438\\u043b\\u0430\\u0441\\u044c \\u0441 \\u0432\\u044b\\u0431\\u043e\\u0440\\u043e\\u043c \\u0441\\u0432\\u043e\\u0435\\u0439 \\u0431\\u0443\\u0434\\u0443\\u0449\\u0435\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438, \\u043d\\u043e \\u0443 \\u0442\\u0435\\u0431\\u044f \\u0435\\u0441\\u0442\\u044c \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u043e\\u0435 \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0440\\u043e\\u0434\\u0430 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438. \\u041d\\u0430 \\u0434\\u0430\\u043d\\u043d\\u043e\\u043c \\u044d\\u0442\\u0430\\u043f\\u0435, \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043f\\u043e\\u043f\\u0440\\u043e\\u0431\\u043e\\u0432\\u0430\\u0442\\u044c \\u0441\\u0435\\u0431\\u044f \\u0432 \\u0447\\u0451\\u043c \\u0443\\u0433\\u043e\\u0434\\u043d\\u043e, \\u043d\\u0435 \\u043d\\u0435\\u0441\\u044f \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u0438 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u0432\\u0430\\u043b\\u0430, \\u0432\\u0435\\u0434\\u044c \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e-\\u0443\\u043d\\u0438\\u043a\\u0430\\u043b\\u044c\\u043d\\u043e \\u0438 \\u0438\\u043c\\u0435\\u0435\\u0442 \\u043c\\u043d\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u043e \\u0432\\u0430\\u0440\\u0438\\u0430\\u0446\\u0438\\u0439, \\u0438 \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0435 \\u0432 \\u043e\\u0434\\u043d\\u043e\\u043c, \\u0442\\u043e \\u0432 \\u0434\\u0440\\u0443\\u0433\\u043e\\u043c \\u0443 \\u0442\\u0435\\u0431\\u044f \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u0441\\u044f. \\u0421\\u0435\\u0439\\u0447\\u0430\\u0441 \\u0435\\u0441\\u0442\\u044c \\u043c\\u043d\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u043e \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439 \\u043d\\u0430\\u0447\\u0430\\u0442\\u044c \\u0440\\u0430\\u0437\\u0432\\u0438\\u0432\\u0430\\u0442\\u044c\\u0441\\u044f \\u0432 \\u043c\\u0435\\u0434\\u0438\\u0430-\\u043f\\u0440\\u043e\\u0441\\u0442\\u0440\\u0430\\u043d\\u0441\\u0442\\u0432\\u0435, \\u0434\\u0435\\u043c\\u043e\\u043d\\u0441\\u0442\\u0440\\u0438\\u0440\\u0443\\u044f \\u0441\\u0432\\u043e\\u0438 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u044b \\u0448\\u0438\\u0440\\u043e\\u043a\\u043e\\u0439 \\u0430\\u0443\\u0434\\u0438\\u0442\\u043e\\u0440\\u0438\\u0438, \\u0432\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u0435\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e, \\u0437\\u0430 \\u0441\\u0447\\u0451\\u0442 \\u0441\\u0432\\u043e\\u0435\\u0439 \\u0433\\u0438\\u0431\\u043a\\u043e\\u0441\\u0442\\u0438 \\u043a \\u0438\\u0437\\u0443\\u0447\\u0435\\u043d\\u0438\\u044f\\u043c \\u043d\\u043e\\u0432\\u044b\\u0445 \\u0442\\u0435\\u0447\\u0435\\u043d\\u0438\\u0439 \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430, \\u044d\\u0442\\u043e \\u043f\\u043e\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0442\\u0435\\u0431\\u0435 \\u0441 \\u0434\\u0430\\u043b\\u044c\\u043d\\u0435\\u0439\\u0448\\u0438\\u043c \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0435\\u043d\\u0438\\u0435\\u043c \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u043e\\u0439 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u0442\\u0435\\u0431\\u0435 \\u0431\\u043b\\u0438\\u0436\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e. \\u041f\\u043e \\u043d\\u0430\\u0448\\u0435\\u043c\\u0443 \\u043c\\u043d\\u0435\\u043d\\u0438\\u044e, \\u0432\\u0438\\u0434\\u0435\\u043e\\u0431\\u043b\\u043e\\u0433\\u0433\\u0438\\u043d\\u0433 \\u043f\\u043e\\u043c\\u043e\\u0436\\u0435\\u0442 \\u0442\\u0435\\u0431\\u0435 \\u0440\\u0430\\u0441\\u043a\\u0440\\u044b\\u0442\\u044c \\u0441\\u0432\\u043e\\u0438 \\u0441\\u0438\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430. \\u041d\\u0435\\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0431\\u0440\\u0430\\u0442\\u044c \\u0432 \\u0440\\u0430\\u0441\\u0447\\u0451\\u0442 \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0442\\u0430\\u043d\\u0446\\u044b, \\u043f\\u0440\\u0430\\u043d\\u043a\\u0438 \\u0438 \\u043f\\u0440\\u043e\\u0447\\u0435\\u0435, \\u043c\\u043e\\u0436\\u043d\\u043e \\u0431\\u0440\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u0435\\u0439 \\u0438\\u043d\\u0434\\u0438\\u0432\\u0438\\u0434\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0438 \\"\\u043d\\u0435\\u043e\\u0431\\u044b\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e\\", \\u043a\\u0430\\u043a \\u043f\\u0440\\u0438\\u043c\\u0435\\u0440: \\u0410\\u043d\\u0434\\u0440\\u0435\\u0439 \\u041d\\u0435\\u043c\\u043e\\u0434\\u0440\\u0443\\u043a, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u0438\\u0437 \\u043a\\u0443\\u0431\\u0438\\u043a\\u043e\\u0432 \\u0420\\u0443\\u0431\\u0438\\u043a\\u0430 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u0446\\u0435\\u043b\\u044b\\u0439 \\u043f\\u043e\\u0440\\u0442\\u0440\\u0435\\u0442.<\\/span><\\/p>"}	2021-03-18 17:21:02	2021-03-18 17:21:02
