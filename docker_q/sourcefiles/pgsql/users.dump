0441\\u0442\\u0432\\u0443\\u0435\\u0442 \\u0442\\u0435\\u043d\\u0434\\u0435\\u043d\\u0446\\u0438\\u044f \\u043a \\u0438\\u043d\\u0434\\u0438\\u0432\\u0438\\u0434\\u0443\\u0430\\u043b\\u0438\\u0437\\u043c\\u0443 - \\u043a \\u0443\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u0438 \\u0438 \\u043f\\u0440\\u0435\\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u043d\\u0438\\u044e \\u0441\\u043e\\u0431\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e, \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0430\\u043c\\u0438 \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e \\u0441\\u0430\\u043c\\u043e\\u0431\\u044b\\u0442\\u043d\\u043e\\u0433\\u043e \\u0438 \\u0441\\u0443\\u0431\\u044a\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u0433\\u043e \\u043c\\u043d\\u0435\\u043d\\u0438\\u044f. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0442\\u044b \\u043f\\u0440\\u043e\\u0431\\u0443\\u0435\\u0448\\u044c \\u043e\\u0442\\u0441\\u0442\\u0430\\u0438\\u0432\\u0430\\u0442\\u044c \\u0441\\u0432\\u043e\\u044e \\u0442\\u043e\\u0447\\u043a\\u0443 \\u0437\\u0440\\u0435\\u043d\\u0438\\u044f, \\u0438 \\u044d\\u0442\\u043e \\u043d\\u0435 \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f. \\u0413\\u043b\\u0430\\u0432\\u043d\\u044b\\u0439 \\u0441\\u043e\\u0432\\u0435\\u0442 \\u0432 \\u044d\\u0442\\u043e\\u0439 \\u0441\\u0432\\u044f\\u0437\\u0438 - \\u043f\\u0440\\u043e\\u0431\\u0443\\u0439 \\u0437\\u0430\\u0449\\u0438\\u0449\\u0430\\u0442\\u044c \\u043f\\u043e\\u0437\\u0438\\u0446\\u0438\\u044e \\u0432 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0441\\u0438\\u0442\\u0443\\u0430\\u0446\\u0438\\u044f\\u0445 (\\u043d\\u0430 \\u0443\\u0440\\u043e\\u043a\\u0430\\u0445, \\u0432 \\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0438 \\u0441 \\u0434\\u0440\\u0443\\u0437\\u044c\\u044f\\u043c\\u0438) 