\u043e\\u0440\\u0438\\u0435\\u043d\\u0442\\u0430\\u0446\\u0438\\u0438. \\u041a \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u0430\\u0432\\u0438\\u0442\\u0435\\u043b\\u044f\\u043c \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0439 \\u043e\\u0442\\u043d\\u043e\\u0441\\u044f\\u0442\\u0441\\u044f \\u0432\\u0440\\u0430\\u0447\\u0438, \\u043f\\u0435\\u0434\\u0430\\u0433\\u043e\\u0433\\u0438, \\u043f\\u0441\\u0438\\u0445\\u043e\\u043b\\u043e\\u0433\\u0438, \\u044d\\u043a\\u0441\\u043a\\u0443\\u0440\\u0441\\u043e\\u0432\\u043e\\u0434\\u044b, \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b\\u0438\\u0441\\u0442\\u044b, \\u0442\\u0435\\u043b\\u0435- \\u0438 \\u0440\\u0430\\u0434\\u0438\\u043e\\u0432\\u0435\\u0434\\u0443\\u0449\\u0438\\u0435, \\u043f\\u0438\\u0430\\u0440-\\u043c\\u0435\\u043d\\u0435\\u0434\\u0436\\u0435\\u0440\\u044b, \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0442\\u043e\\u0440\\u044b \\u0438\\u0432\\u0435\\u043d\\u0442-\\u043c\\u0435\\u0440\\u043e\\u043f\\u0440\\u0438\\u044f\\u0442\\u0438\\u0439.. &nbsp;<\\/p>\\n<p><span style=\\"color: #2761a0;\\">\\u0410 \\u0432\\u043e\\u0442 \\u0441\\u043c\\u043e\\u0442\\u0440\\u0438, \\u0447\\u0442\\u043e \\u043c\\u044b \\u043e\\u0431\\u043d\\u0430\\u0440\\u0443\\u0436\\u0438\\u043b\\u0438!<\\/span> \\u0423 \\u0442\\u0435\\u0431\\u044f \\u043e\\u0442\\u043b\\u0438\\u0447\\u043d\\u043e \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u043e \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043d\\u043e-\\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435. \\u0422\\u044b \\u043b\\u0443\\u0447\\u0448\\u0435 \\u0443\\u0441\\u0432\\u0430\\u0438\\u0432\\u0430\\u0435\\u0448\\u044c \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044e \\u0447\\u0435\\u0440\\u0435\\u0437 \\u0434\\u0435\\u044f\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c. \\u0421\\u043a\\u0