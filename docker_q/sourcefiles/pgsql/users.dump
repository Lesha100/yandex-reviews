3e\\u0432<\\/strong>: \\u0446\\u0438\\u0444\\u0440, \\u0444\\u043e\\u0440\\u043c\\u0443\\u043b, \\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u0432. \\u0422\\u0430\\u043a\\u043e\\u0439 \\u0442\\u0438\\u043f \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0441\\u0432\\u044f\\u0437\\u0430\\u043d \\u0441 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435\\u043c \\u0447\\u0435\\u0440\\u0442\\u0435\\u0436\\u0435\\u0439, \\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u0432, \\u0441\\u0438\\u0433\\u043d\\u0430\\u043b\\u043e\\u0432 \\u0438 \\u0447\\u0438\\u0441\\u0435\\u043b. \\u041d\\u0430\\u043f\\u0440\\u0438\\u043c\\u0435\\u0440, \\u0440\\u0435\\u0447\\u0435\\u0432\\u044b\\u0435 \\u044f\\u0437\\u044b\\u043a\\u0438, \\u0446\\u0438\\u0444\\u0440\\u044b, \\u043d\\u043e\\u0442\\u044b, \\u044f\\u0437\\u044b\\u043a\\u0438 \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f, \\u044f\\u0437\\u044b\\u043a\\u0438 \\u0436\\u0435\\u0441\\u0442\\u043e\\u0432 \\u0438 \\u0434\\u0440. \\u0427\\u0435\\u043b\\u043e\\u0432\\u0435\\u043a \\u044d\\u0442\\u043e\\u0433\\u043e \\u0442\\u0438\\u043f\\u0430 \\u043e\\u043f\\u0438\\u0440\\u0430\\u0435\\u0442\\u0441\\u044f \\u043d\\u0430 \\u0441\\u0432\\u043e\\u0435 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u043d\\u043e\\u0435 \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 \\u0441 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u043c\\u0438 \\u0432\\u0438\\u0434\\u0430\\u043c\\u0438 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438. \\u0411\\u0435\\u0437 \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u044f \\u0443\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u0433\\u043e \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u0430 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u0430, \\u043c\\u043e\\u0436\\u043d\\