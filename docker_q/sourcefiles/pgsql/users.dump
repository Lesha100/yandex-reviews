5, \\u0433\\u0434\\u0435 \\u043d\\u0443\\u0436\\u043d\\u043e \\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0437\\u0430 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043b\\u044e\\u0434\\u0435\\u0439, \\u0442\\u044b \\u043c\\u043e\\u0436\\u0435\\u0448\\u044c \\u043f\\u043e\\u0434\\u0432\\u0435\\u0440\\u0433\\u0430\\u0442\\u044c\\u0441\\u044f \\u0441\\u0442\\u0440\\u0435\\u0441\\u0441\\u0443 \\u0438 \\u0441\\u0438\\u043b\\u044c\\u043d\\u043e\\u043c\\u0443 \\u0432\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u044e. \\u0412\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e, \\u0441\\u0435\\u0440\\u044c\\u0435\\u0437\\u043d\\u043e \\u043e\\u0442\\u043d\\u043e\\u0441\\u0438\\u0448\\u044c\\u0441\\u044f \\u043a \\u043e\\u0446\\u0435\\u043d\\u043a\\u0435 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0430\\u044e\\u0449\\u0438\\u0445.&nbsp;<\\/p>\\n<p><strong><span style=\\"color: #2761a0;\\">\\u0422\\u0438\\u043f \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043c\\u044b\\u0448\\u043b\\u0435\\u043d\\u0438\\u044f.<\\/span>&nbsp;<\\/strong>\\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u0442\\u0435\\u0441\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043f\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u044e\\u0442, \\u0447\\u0442\\u043e \\u0442\\u044b \\u044f\\u0440\\u043a\\u043e \\u0432\\u044b\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u044b\\u0439 \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u043a, \\u0441\\u043a\\u043b\\u043e\\u043d\\u043d\\u044b\\u0439 \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u043c\\u0438 \\u0434\\u0435\\u043b\\u0430\\u043c\\u0438 \\u0438 \\u0438\\u043c\\u0435\\u0442\\u044c \\u0434\\u0435\\u043b\\u043e \\u0441 \\u0432\\u0435\\u04