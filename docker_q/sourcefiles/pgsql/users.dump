441\\u0442\\u0443\\u043f\\u0438\\u0442\\u044c \\u0432 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043d\\u044b\\u0439, \\u043a\\u0430\\u043a \\u0432 \\u0441\\u0430\\u043c\\u044b\\u0435 \\u043f\\u043e\\u043f\\u0443\\u043b\\u044f\\u0440\\u043d\\u044b\\u0435 \\u0442\\u0435\\u0430\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0432\\u0443\\u0437\\u044b.<\\/ul>\\n<h4>\\u041f\\u043e\\u043f\\u0443\\u043b\\u044f\\u0440\\u043d\\u044b\\u0435 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0438 \\u0441\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u0438<\\/h4>\\n<p class=\\"Section\\">&bull;&nbsp;<strong>\\u0410\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440<\\/strong>&nbsp;(\\u0432 \\u0443\\u0437\\u043a\\u043e\\u043c \\u0441\\u043c\\u044b\\u0441\\u043b\\u0435) \\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u0430\\u0442\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043d\\u044b\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f (\\u044d\\u0441\\u043a\\u0438\\u0437\\u043d\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442, \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u043d\\u0443\\u044e \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430\\u0446\\u0438\\u044e \\u0438 \\u0440\\u0430\\u0431\\u043e\\u0447\\u0438\\u0435 \\u0447\\u0435\\u0440\\u0442\\u0435\\u0436\\u0438), \\u043f\\u0440\\u043e\\u0432\\u043e\\u0434\\u0438\\u0442 \\u0430\\u0432\\u0442\\u043e\\u0440\\u0441\\u043a\\u0438\\u0439 \\u043d\\u0430\\u0434\\u0437\\u043e\\u0440.<br \\/>&bull;&nbsp;<strong>\\u0413\\u043b\\u0430\\u0432\\u043d\\u044b\\u0439 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u043e\\u0440<\\/strong>&nbsp;\\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0430 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441\\u043e\\u043c \\u0440\\u0430\\