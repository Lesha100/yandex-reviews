3a\\u043e\\u043b\\u044b \\u0437\\u0430\\u0434\\u0430\\u0435\\u0442 \\u0441\\u0432\\u043e\\u044e \\u0440\\u0430\\u043c\\u043a\\u0443. \\u0427\\u0442\\u043e \\u0441 \\u044d\\u0442\\u0438\\u043c \\u0434\\u0435\\u043b\\u0430\\u0442\\u044c? \\u0412\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u043e\\u0432 \\u043c\\u0430\\u0441\\u0441\\u0430. \\u041f\\u0435\\u0440\\u0432\\u043e\\u0435 \\u0438 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u043e\\u0435 &ndash; \\u043e\\u0431\\u0441\\u0443\\u0434\\u0438\\u0442\\u044c \\u0441 \\u0440\\u0435\\u0431\\u0435\\u043d\\u043a\\u043e\\u043c \\u0435\\u0433\\u043e \\u043f\\u0440\\u043e\\u0431\\u0443 (\\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u044b, \\u0443\\u0441\\u043f\\u0435\\u0445\\u0438, \\u0443\\u0447\\u0430\\u0441\\u0442\\u0438\\u0435 \\u0432 \\u043a\\u043e\\u043d\\u043a\\u0443\\u0440\\u0441\\u0430\\u0445, \\u0434\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435). \\u041e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0438\\u0442\\u044c \\u043d\\u0430\\u0438\\u0431\\u043e\\u043b\\u0435\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043d\\u044b\\u0439 \\u0435\\u043c\\u0443 \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442, \\u0432\\u0435\\u0434\\u044c \\u0447\\u0442\\u043e-\\u0442\\u043e \\u0435\\u043c\\u0443 \\u0442\\u043e\\u0447\\u043d\\u043e \\u043d\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0432\\u0441\\u0435\\u0433\\u043e. \\u0410 \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0435\\u0442, \\u0442\\u043e \\u0441\\u0430\\u043c\\u043e\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c \\u0435\\u043c\\u0443 \\u043f\\u043e\\u043f\\u0440\\u043e\\u0431\\u043e\\u0432\\u0430\\u0442\\u044c \\u0441\\u0435\\u0431\\u044f \\u0432 \\u0434\\u0435\\u043b\\u0435. \\u0412 \\u043b\\u044e\\u0431\\u043e\\u043c \\u0441