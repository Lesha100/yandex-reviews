430\\u043d\\u0434\\u0448\\u0430\\u0444\\u0442\\u044b. \\u041c\\u043e\\u0433\\u0443\\u0442 \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u0440\\u0443\\u043a\\u043e\\u0434\\u0435\\u043b\\u0438\\u0435\\u043c \\u0438 \\u0443\\u0432\\u043b\\u0435\\u043a\\u0430\\u0442\\u044c\\u0441\\u044f hand-made \\u0442\\u0432\\u043e\\u0440\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e\\u043c. \\u0411\\u0435\\u0437 \\u043d\\u0438\\u0445 \\u043d\\u0435\\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u043d\\u0438 \\u043e\\u0434\\u043d\\u0443 \\u0431\\u043b\\u0435\\u0441\\u0442\\u044f\\u0449\\u0443\\u044e \\u0438\\u0434\\u0435\\u044e. &nbsp;\\u041e\\u0434\\u043d\\u0430\\u043a\\u043e \\u0441\\u0443\\u0434\\u044f \\u043f\\u043e \\u0442\\u0435\\u0441\\u0442\\u0430\\u043c, \\u0442\\u044b \\u0441\\u043e\\u0432\\u0441\\u0435\\u043c \\u043d\\u0435 \\u0432\\u0438\\u0434\\u0438\\u0448\\u044c \\u0441\\u0435\\u0431\\u044f \\u0432 \\u0434\\u0430\\u043d\\u043d\\u043e\\u043c \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u043c \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0438. \\u0427\\u0442\\u043e \\u0436, \\u0431\\u0435\\u0437\\u0443\\u0441\\u043b\\u043e\\u0432\\u043d\\u043e, \\u044d\\u0442\\u043e \\u0442\\u0432\\u043e\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440. \\u041d\\u043e \\u0413\\u0435\\u043d\\u0440\\u0438 \\u0424\\u043e\\u0440\\u0434 \\u0441\\u0432\\u043e\\u0438\\u043c\\u0438 \\u0440\\u0443\\u043a\\u0430\\u043c\\u0438 \\u0441\\u043e\\u0431\\u0440\\u0430\\u043b \\u043f\\u0435\\u0440\\u0432\\u044b\\u0439 \\u0432 \\u043c\\u0438\\u0440\\u0435 \\u0434\\u0432\\u0438\\u0433\\u0430\\u0442\\u0435\\u043b\\u044c \\u0432\\u043d\\u0443\\u0442\\u0440\\u0435\\u043d\\u043d\\u0435\\u0433\\u043e \\u0441\\u0433\\u043e\\u0440\\u0430\\u043d\\u0438\\u044f, \\u0447\\u0442\\u043e\\u0431\\u044b \\u043f\\u043e\\u0442\\u043e